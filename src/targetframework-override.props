<Project>
	<PropertyGroup>
		<!-- The suffix tests below are a proxy for "platform-agnostic project". A project whose file name
		     carries no such suffix must set UnoShouldUseNoPlatformOverride itself, before importing this
		     file, or it will pull platform TFMs and fail to satisfy no-platform consumers.
		     Note this selects which override applies, it does not suppress overriding: the no-platform
		     props below still maps UnoTargetFrameworkOverride onto the matching platform-less TFM. -->
		<_ShouldUseNoPlatformOverride>false</_ShouldUseNoPlatformOverride>
		<_ShouldUseNoPlatformOverride Condition="
			$(MSBuildProjectFile.EndsWith('.Skia.csproj')) 
			OR $(MSBuildProjectFile.EndsWith('.Wasm.csproj')) 
			OR $(MSBuildProjectFile.EndsWith('.Reference.csproj'))
			OR '$(UnoShouldUseNoPlatformOverride)' == 'true'
		">true</_ShouldUseNoPlatformOverride>
	</PropertyGroup>

	<PropertyGroup>
		<!-- 'desktop' and 'browserwasm' are Uno.Sdk *head* monikers: no library here has such a TFM,
		     both being plainly Skia, so a head-shaped override (net10.0-desktop) has to select the
		     platform-less TFM rather than be taken verbatim. Only SamplesApp.csproj, whose every TFM
		     carries a platform, re-applies the moniker after importing this file. -->
		<_UnoOverridePlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(UnoTargetFrameworkOverride)'))</_UnoOverridePlatform>
		<_UnoEffectiveTargetFrameworkOverride>$(UnoTargetFrameworkOverride)</_UnoEffectiveTargetFrameworkOverride>
		<_UnoEffectiveTargetFrameworkOverride Condition="'$(_UnoOverridePlatform)' == 'desktop' OR '$(_UnoOverridePlatform)' == 'browserwasm'">net$([MSBuild]::GetTargetFrameworkVersion('$(UnoTargetFrameworkOverride)'))</_UnoEffectiveTargetFrameworkOverride>
	</PropertyGroup>

	<Import Condition="'$(_ShouldUseNoPlatformOverride)'=='true'" Project="targetframework-override-noplatform.props" />
	<PropertyGroup Condition="'$(UnoTargetFrameworkOverride)'!='' AND '$(_ShouldUseNoPlatformOverride)' == 'false'">
		<TargetFrameworks>$(_UnoEffectiveTargetFrameworkOverride)</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFrameworks)'=='$(NetPrevious)-ios' and '$(OutputType)'!='Exe'">$(NetPrevious)-ios$(NetPreviousAppleOSVersion)</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFrameworks)'=='$(NetCurrent)-ios' and '$(OutputType)'!='Exe'">$(NetCurrent)-ios$(NetCurrentAppleOSVersion)</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFrameworks)'=='$(NetPrevious)-tvos' and '$(OutputType)'!='Exe'">$(NetPrevious)-tvos$(NetPreviousAppleOSVersion)</TargetFrameworks>
		<TargetFrameworks Condition="'$(TargetFrameworks)'=='$(NetCurrent)-tvos' and '$(OutputType)'!='Exe'">$(NetCurrent)-tvos$(NetCurrentAppleOSVersion)</TargetFrameworks>
	</PropertyGroup>

</Project>
