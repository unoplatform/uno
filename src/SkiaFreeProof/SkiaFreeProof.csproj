<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  Minimal desktop app head that proves the framework has NO real SkiaSharp dependency: it references only the
	  neutral framework + hosts + the WebGPU/managed backends. It deliberately does NOT reference the Skia backend,
	  any SkiaSharp package, the Skia-only add-ins, or the (Skia-coupled) runtime-test harness. Build it and confirm
	  no SkiaSharp*.dll / libSkiaSharp is emitted to the output directory.
	-->
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<IsUnoHead>true</IsUnoHead>
		<IsPackable>false</IsPackable>
		<PreBuildUnoUITasks>true</PreBuildUnoUITasks>
		<RollForward>Major</RollForward>
	</PropertyGroup>

	<Import Project="..\targetframework-override-noplatform.props" />

	<!-- Provision the wgpu-native lib next to the app so the WebGPU backend's DllImportResolver finds it. -->
	<Import Project="..\Uno.UI.Composition.WebGpu\wgpu-native.targets" />

	<ItemGroup>
		<!-- Neutral framework -->
		<ProjectReference Include="..\SourceGenerators\System.Xaml\Uno.Xaml.csproj" />
		<ProjectReference Include="..\Uno.Foundation\Uno.Foundation.Skia.csproj" />
		<ProjectReference Include="..\Uno.UI.Composition\Uno.UI.Composition.Skia.csproj" />
		<ProjectReference Include="..\Uno.UI.Composition.Managed\Uno.UI.Composition.Managed.csproj" />
		<ProjectReference Include="..\Uno.UI.Dispatching\Uno.UI.Dispatching.Skia.csproj" />
		<ProjectReference Include="..\Uno.UWP\Uno.Skia.csproj" />
		<ProjectReference Include="..\Uno.UI\Uno.UI.Skia.csproj" />
		<!-- Hosts -->
		<ProjectReference Include="..\Uno.UI.Runtime.Skia\Uno.UI.Runtime.Skia.csproj" />
		<ProjectReference Include="..\Uno.UI.Runtime.Skia.X11\Uno.UI.Runtime.Skia.X11.csproj" />
		<ProjectReference Include="..\Uno.UI.Runtime.Skia.Win32\Uno.UI.Runtime.Skia.Win32.csproj" />
		<ProjectReference Include="..\Uno.UI.Runtime.Skia.Win32.Support\Uno.UI.Runtime.Skia.Win32.Support.csproj" />
		<!-- WebGPU backend (GPU path; NOT SkiaSharp) -->
		<ProjectReference Include="..\Uno.UI.Composition.WebGpu\Uno.UI.Composition.WebGpu.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<UnoUIMSBuildTasksPath>$(MSBuildThisFileDirectory)..\SourceGenerators\Uno.UI.Tasks\bin\$(Configuration)_Shadow</UnoUIMSBuildTasksPath>
	</PropertyGroup>

	<Import Project="..\SourceGenerators\Uno.UI.Tasks\Content\Uno.UI.Tasks.targets" Condition="'$(SkipUnoResourceGeneration)' == '' " />
</Project>
