<Page x:Class="Uno.UI.Tests.Windows_UI_Xaml_Data.xBindTests.Controls.Binding_Event_NamedElement"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:local="using:Uno.UI.Tests.Windows_UI_Xaml_Data.xBindTests.Controls"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<StackPanel x:Name="panel">
		<local:Binding_Event_NamedElement_Target x:Name="namedTarget"
												 x:FieldModifier="public" />
		<CheckBox x:Name="myCheckBox"
				  x:FieldModifier="public"
				  Checked="{x:Bind namedTarget.OnCheckedRaised}"
				  Unchecked="{x:Bind namedTarget.OnUncheckedRaised}" />
		<Button Click="{x:Bind panel.InvalidateMeasure}" />
	</StackPanel>
</Page>
