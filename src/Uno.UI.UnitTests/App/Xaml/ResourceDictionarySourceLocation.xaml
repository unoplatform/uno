<Page x:Class="Uno.UI.Tests.App.Xaml.ResourceDictionarySourceLocation"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Uno.UI.Tests.App.Xaml">
	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<local:SourceLocation_CodeDictionary />
				<local:Subclassed_Dictionary />
				<ResourceDictionary Source="Test_Dictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<x:String x:Key="SourceLocation_PageResource">page</x:String>
		</ResourceDictionary>
	</Page.Resources>
	<Grid x:Name="Element"
		  x:FieldModifier="public">
		<Grid.Resources>
			<ResourceDictionary>
				<x:String x:Key="SourceLocation_ElementResource">element</x:String>
			</ResourceDictionary>
		</Grid.Resources>
	</Grid>
</Page>
