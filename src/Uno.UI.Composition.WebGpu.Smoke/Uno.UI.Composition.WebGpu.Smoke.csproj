<Project Sdk="Microsoft.NET.Sdk">
  <!--
    EXPERIMENTAL headless render-seam verifier for the non-Skia WebGPU backend.
    Not in any solution filter / CI: it requires a Vulkan ICD (lavapipe) at runtime.
    Run (Linux, software Vulkan):
      dotnet build src/Uno.UI.Composition.WebGpu.Smoke -p:UnoTargetFrameworkOverride=net10.0
      VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json WGPU_BACKEND=vulkan \
      LD_LIBRARY_PATH=<out>/runtimes/linux-x64/native:<nuget>/skiasharp.nativeassets.linux/*/runtimes/linux-x64/native \
      dotnet <out>/Uno.UI.Composition.WebGpu.Smoke.dll
    (libSkiaSharp is needed too, for the Skia-vs-WebGPU cross-backend comparison check.)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Uno.UI.Composition.WebGpu\Uno.UI.Composition.WebGpu.csproj" />
    <!-- The Skia backend, so the harness can render the SAME neutral scene through both and pixel-compare. -->
    <ProjectReference Include="..\Uno.UI.Composition.Skia\Uno.UI.Composition.SkiaBackend.csproj" />
  </ItemGroup>
</Project>
