<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
		<!-- This is a generic (SkiaSharp) backend used on ALL Skia platforms incl. Skia-on-Android, so it must stay
		     net10.0 and NOT platform-cross-target under a mobile override — otherwise net10.0 consumers (RemoteControl,
		     FluentTheme, SamplesApp.Skia, …) hit NU1201. The file ends ".SkiaBackend.csproj", so it misses the
		     ".Skia.csproj" auto-noplatform rule in targetframework-override.props; set the flag it reads explicitly
		     (mirrors Uno.UI.Composition.Drawing). Must precede the import below, which reads it. -->
		<UnoShouldUseNoPlatformOverride>true</UnoShouldUseNoPlatformOverride>
	</PropertyGroup>

	<Import Project="../targetframework-override.props" />

	<PropertyGroup>
		<AssemblyName>Uno.UI.Composition.Skia</AssemblyName>
		<RootNamespace>Uno.UI.Composition</RootNamespace>
		<DefineConstants>$(DefineConstants);XAMARIN;IS_UNO;IS_UNO_COMPOSITION</DefineConstants>

		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Deterministic>true</Deterministic>

		<UnoRuntimeIdentifier>Skia</UnoRuntimeIdentifier>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
		<CommonOverridePackageId>Uno.UI</CommonOverridePackageId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="HarfBuzzSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.Composition\Uno.UI.Composition.csproj" />
		<ProjectReference Include="..\Uno.UWP\Uno.Reference.csproj" Condition="'$(SyncGeneratorRunning)'!='true'" />
		<ProjectReference Include="..\Uno.UWP\Uno.Skia.csproj" Condition="'$(SyncGeneratorRunning)'=='true'" />
		<ProjectReference Include="..\Uno.Foundation\Uno.Foundation.Reference.csproj" Condition="'$(SyncGeneratorRunning)'!='true'" />
		<ProjectReference Include="..\Uno.Foundation\Uno.Foundation.Skia.csproj" Condition="'$(SyncGeneratorRunning)'=='true'" />
	</ItemGroup>
</Project>
