<Page x:Class="Test02.MainPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Test02">

	<Page.Resources>
		<SolidColorBrush x:Key="MyResource" Color="{x:Bind MyColor}" />
	</Page.Resources>
	<Grid>
		<ContentControl Width="180" CornerRadius="12">
			<StackPanel Padding="16">
				<TextBlock Text="{Binding user.name}" Foreground="{ThemeResource DefaultTextForegroundThemeBrush}" />
			</StackPanel>
		</ContentControl>
	</Grid>
</Page>
