<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
		<UnoShouldUseNoPlatformOverride>true</UnoShouldUseNoPlatformOverride>
	</PropertyGroup>

	<Import Project="../targetframework-override.props" />

	<PropertyGroup>
		<AssemblyName>Uno.UI.XamlHost</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<RootNamespace>Uno.UI.XamlHost</RootNamespace>
		<DefineConstants>$(DefineConstants);IS_UNO</DefineConstants>

		<NoWarn>$(NoWarn);NU1701</NoWarn>

		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Deterministic>true</Deterministic>

		<UnoRuntimeFlavor>Generic</UnoRuntimeFlavor>
		<PlatformItemsBasePath>.\</PlatformItemsBasePath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.Foundation\Uno.Foundation.Skia.csproj" />
		<ProjectReference Include="..\Uno.Foundation.Logging\Uno.Foundation.Logging.csproj" />
		<ProjectReference Include="..\Uno.UI\Uno.UI.csproj" />
	</ItemGroup>

	<!--
		Skia sets UnoRuntimeFlavor, so _UnoOverrideNuget skips this project; the Reference head
		that used to do the copy is gone. Uno.WinUI.XamlHost ships lib/ only.
	-->
	<Target Name="_UnoUIXamlHostOverrideNuget" AfterTargets="AfterBuild" DependsOnTargets="BuiltProjectOutputGroup" Condition="'$(UnoNugetOverrideVersion)'!=''">

		<PropertyGroup>
			<_overridePackageId>uno.winui.xamlhost</_overridePackageId>
			<_TargetNugetFolder>$(NuGetPackageRoot)\$(_overridePackageId)\$(UnoNugetOverrideVersion)\lib\$(TargetFramework)</_TargetNugetFolder>
		</PropertyGroup>
		<ItemGroup>
			<_OutputFiles Include="$(TargetDir)**" />
		</ItemGroup>
		<MakeDir Directories="$(_TargetNugetFolder)" />

		<Message Importance="high" Text="OVERRIDING NUGET PACKAGE CACHE: $(_TargetNugetFolder)" />

		<Copy SourceFiles="@(_OutputFiles)" DestinationFiles="@(_OutputFiles->'$(_TargetNugetFolder)\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Copy SourceFiles="@(_OutputFilesPDB)" DestinationFiles="@(_OutputFilesPDB->'$(_TargetNugetFolder)\%(RecursiveDir)%(Filename).pdb')" />
	</Target>

</Project>
