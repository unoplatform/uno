<ResourceDictionary x:Class="Uno.UI.FluentTheme.v2.Perf2026Resources"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Optimized (perf2026) variants of the Fluent v2 control styles, ported from WinUI.

		This dictionary is only overlaid on XamlControlsResources when
		FeatureConfiguration.Style.UseDefaultStyleOptimizations is enabled, so the default
		visual tree and behavior are unchanged unless an app opts in.

		Each merged dictionary only carries the styles it actually optimizes; the keys it does
		not define keep resolving to the default theme resources.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="AppBarButton_themeresources_perf2026.xaml" />
		<ResourceDictionary Source="AppBarToggleButton_themeresources_perf2026.xaml" />
		<ResourceDictionary Source="Button_themeresources_perf2026.xaml" />
		<ResourceDictionary Source="CheckBox_themeresources_perf2026.xaml" />
		<ResourceDictionary Source="ComboBox_themeresources_perf2026.xaml" />
		<ResourceDictionary Source="CommandBar_themeresources_perf2026.xaml" />
		<ResourceDictionary Source="NavigationBackButton_perf2026.xaml" />
		<ResourceDictionary Source="ScrollBar_themeresources_perf2026.xaml" />
		<ResourceDictionary Source="Slider_themeresources_perf2026.xaml" />
		<ResourceDictionary Source="TabView_perf2026.xaml" />
		<ResourceDictionary Source="ToggleSwitch_themeresources_perf2026.xaml" />
	</ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
