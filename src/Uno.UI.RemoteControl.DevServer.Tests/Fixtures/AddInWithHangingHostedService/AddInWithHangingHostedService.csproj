<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Test fixture for Uno.UI.RemoteControl.DevServer.Tests.

		Registers an IHostedService whose StopAsync never completes, so the host's
		graceful shutdown hangs. Used to prove that the ParentProcessObserver's
		forced exit still ends the process (and reports it) when the parent dies.
	-->

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<EnableDynamicLoading>true</EnableDynamicLoading>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="9.0.0" />
	</ItemGroup>

</Project>
