<Project Sdk="MSTest.Sdk/4.0.2">

	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DisablePrivateProjectReference>true</DisablePrivateProjectReference>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.Runtime.Wayland\Uno.UI.Runtime.Wayland.csproj" />
		<ProjectReference Include="..\Uno.UI.Runtime.Wayland.Scanner\Uno.UI.Runtime.Wayland.Scanner.csproj" />
		<ProjectReference Include="..\Uno.UI.Composition.Skia\Uno.UI.Composition.SkiaBackend.csproj" />
		<!-- The runtime references these privately; tests run them directly, so they need the real implementations rather than the reference stubs. -->
		<ProjectReference Include="..\Uno.WinRT\Uno.WinRT.Generic.csproj" />
		<ProjectReference Include="..\Uno.Foundation\Uno.Foundation.Generic.csproj" />
		<ProjectReference Include="..\Uno.UI.Dispatching\Uno.UI.Dispatching.Generic.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Uno.UI.Runtime.Wayland\Protocols\*.xml" Link="protocols\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
