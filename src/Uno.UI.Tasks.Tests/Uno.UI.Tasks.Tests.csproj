<Project Sdk="MSTest.Sdk/4.0.2">

	<PropertyGroup>
		<TargetFramework>$(NetUnitTests)</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" />
		<PackageReference Include="Mono.Cecil" Version="0.11.6" />

		<!-- The test host drives the tasks in-process, so it needs the MSBuild runtime assets a task project excludes. -->
		<PackageReference Include="Microsoft.Build.Framework" />
		<PackageReference Include="Microsoft.Build.Utilities.Core" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SourceGenerators\Uno.UI.Tasks\Uno.UI.Tasks.csproj" />
	</ItemGroup>

</Project>
