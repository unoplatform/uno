<UserControl
	x:Class="Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml.Controls.TemplatePool_Leak_Templates"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>

		<!--
			The "NeverEntered" state is never activated, so its Setters stay behind
			VisualState.LazyBuilder for the whole lifetime of the materialized template.
		-->
		<DataTemplate x:Key="LazyVisualStateTemplate">
			<Grid>
				<VisualStateManager.VisualStateGroups>
					<VisualStateGroup>
						<VisualState x:Name="Normal" />
						<VisualState x:Name="NeverEntered">
							<VisualState.Setters>
								<Setter Target="Inner.Opacity" Value="0.5" />
							</VisualState.Setters>
						</VisualState>
					</VisualStateGroup>
				</VisualStateManager.VisualStateGroups>

				<Border x:Name="Inner" />
			</Grid>
		</DataTemplate>

		<!--
			The deferred border is never loaded, so its content stays behind
			ElementStub.ContentBuilder for the whole lifetime of the materialized template.
		-->
		<DataTemplate x:Key="DeferredElementTemplate">
			<Grid>
				<Border x:Name="Deferred" x:Load="False">
					<TextBlock Text="deferred" />
				</Border>
			</Grid>
		</DataTemplate>

	</UserControl.Resources>

</UserControl>
