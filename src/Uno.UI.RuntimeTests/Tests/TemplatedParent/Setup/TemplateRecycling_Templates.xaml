<UserControl x:Class="Uno.UI.RuntimeTests.Tests.TemplatedParent.Setup.TemplateRecycling_Templates"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>

		<!--
			Hosted on a ContentPresenter by the test: a DataTemplate is the only template kind that
			reaches the pool, as Control.Template is materialized uncached.
		-->
		<DataTemplate x:Key="RecyclingTemplate">
			<Grid x:Name="TemplateRoot">

				<Border x:Name="EagerBorder" />

				<!--  Materialized by the test through its ElementStub, before or after the recycling.  -->
				<Border x:Name="LazyBorder" x:Load="False">
					<ContentPresenter x:Name="LazyDescendant" Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" />
				</Border>

				<VisualStateManager.VisualStateGroups>
					<VisualStateGroup x:Name="TestStates">
						<VisualState x:Name="Initial" />

						<!--  Reading VisualState.Storyboard runs the lazy builder that creates the key-frame.  -->
						<VisualState x:Name="LazyState">
							<Storyboard>
								<ObjectAnimationUsingKeyFrames Storyboard.TargetName="EagerBorder"
															   Storyboard.TargetProperty="Background">
									<DiscreteObjectKeyFrame KeyTime="0" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
								</ObjectAnimationUsingKeyFrames>
							</Storyboard>
						</VisualState>
					</VisualStateGroup>
				</VisualStateManager.VisualStateGroups>

			</Grid>
		</DataTemplate>

	</UserControl.Resources>

</UserControl>
