<Page x:Class="Uno.UI.RuntimeTests.Tests.TemplatedParent.Setup.LazyVisualState"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ContentControl x:Name="SUT"
					x:FieldModifier="Public"
					Width="100"
					Height="50"
					Content="AsdAsd">
		<ContentControl.Template>
			<ControlTemplate TargetType="ContentControl">
				<Grid x:Name="TemplateRoot">

					<Border x:Name="ContentElement" />
					<Border x:Name="LazyBorder" x:Load="False">
						<ContentPresenter x:Name="LazyDescendant" Content="{TemplateBinding Content}" />
					</Border>

					<VisualStateManager.VisualStateGroups>
						<VisualStateGroup x:Name="TestStates">
							<VisualState x:Name="Initial" />

							<!--  The key-frame value is what proves the lazily built storyboard received the templated parent.  -->
							<VisualState x:Name="TemplatedParentBound">
								<Storyboard>
									<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentElement"
																   Storyboard.TargetProperty="Background">
										<DiscreteObjectKeyFrame KeyTime="0" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
									</ObjectAnimationUsingKeyFrames>
								</Storyboard>
							</VisualState>

							<!--  Resolving this setter's target materializes the deferred element.  -->
							<VisualState x:Name="DeferredTarget">
								<VisualState.Setters>
									<Setter Target="LazyBorder.Opacity" Value="0.5" />
								</VisualState.Setters>
							</VisualState>
						</VisualStateGroup>
					</VisualStateManager.VisualStateGroups>

				</Grid>
			</ControlTemplate>
		</ContentControl.Template>
	</ContentControl>
</Page>
