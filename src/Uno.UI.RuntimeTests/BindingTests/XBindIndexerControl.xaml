<UserControl x:Class="Uno.UI.RuntimeTests.Tests.XBindIndexerControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock x:Name="ItemText"
				   x:FieldModifier="public"
				   Text="{x:Bind VM.Items[0], Mode=OneWay}" />
		<TextBlock x:Name="LengthText"
				   x:FieldModifier="public"
				   Text="{x:Bind VM.Items[0].Length, Mode=OneWay}" />
	</StackPanel>
</UserControl>
