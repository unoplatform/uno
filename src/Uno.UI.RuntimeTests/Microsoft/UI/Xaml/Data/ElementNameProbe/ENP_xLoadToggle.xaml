<UserControl x:Class="Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml_Data.ElementNameProbe.ENP_xLoadToggle"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<StackPanel>
		<TextBlock x:Name="Toggled" x:FieldModifier="public" x:Load="{x:Bind Model.IsToggledLoaded, Mode=OneWay}" Text="t1" />
		<TextBlock x:Name="BoundToggled" x:FieldModifier="public" Text="{Binding ElementName=Toggled, Path=Text}" />
	</StackPanel>
</UserControl>
