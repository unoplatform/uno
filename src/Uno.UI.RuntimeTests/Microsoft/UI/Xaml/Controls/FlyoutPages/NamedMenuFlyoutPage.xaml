<Page
	x:Class="Uno.UI.RuntimeTests.FlyoutPages.NamedMenuFlyoutPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<Button
			x:Name="targetButton"
			Content="Open flyout">
			<Button.Flyout>
				<MenuFlyout x:Name="namedMenuFlyout">
					<MenuFlyoutItem Text="Item" />
				</MenuFlyout>
			</Button.Flyout>
		</Button>
		<Button
			x:Name="secondTargetButton"
			Content="Open shared flyout" />
	</StackPanel>
</Page>
