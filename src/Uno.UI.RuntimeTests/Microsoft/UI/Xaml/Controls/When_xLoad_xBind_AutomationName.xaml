<UserControl
	x:Class="Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml.Controls.When_xLoad_xBind_AutomationName"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<StackPanel>
		<Grid x:Name="DeferredPanel" x:FieldModifier="public" x:Load="{x:Bind IsShown, Mode=OneWay}">
			<TextBox x:Name="NotesBox" x:FieldModifier="public" AutomationProperties.Name="Notes" />
		</Grid>
		<Border>
			<Button AutomationProperties.Name="Save" x:Name="SaveButton" x:FieldModifier="public" x:Load="{x:Bind IsShown, Mode=OneWay}" />
		</Border>
	</StackPanel>
</UserControl>
