<Page
    x:Class="Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml.Controls.When_xBind_InterfaceProperty"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml.Controls">

	<StackPanel>
		<!-- Count is declared by IReadOnlyList, and the instance behind it is an array, which only exposes Length -->
		<TextBlock x:Name="arrayCountText" x:FieldModifier="public" Text="{x:Bind Model.Items.Count, Mode=OneWay}" />

		<!-- Same declared type, but the instance is a List, which declares Count publicly -->
		<TextBlock x:Name="listCountText" x:FieldModifier="public" Text="{x:Bind Model.ListItems.Count, Mode=OneWay}" />
	</StackPanel>
</Page>
