<UserControl
	x:Class="Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml_Markup.InlineCollection_NullDefault"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml_Markup">
	<UserControl.Transitions>
		<EntranceThemeTransition />
	</UserControl.Transitions>

	<StackPanel x:Name="RootPanel">
		<StackPanel.ChildrenTransitions>
			<RepositionThemeTransition />
			<EntranceThemeTransition />
		</StackPanel.ChildrenTransitions>

		<ContentControl x:Name="ContentHost">
			<ContentControl.ContentTransitions>
				<ContentThemeTransition />
			</ContentControl.ContentTransitions>
		</ContentControl>

		<Border x:Name="TransformedBorder">
			<Border.RenderTransform>
				<TransformGroup>
					<TransformGroup.Children>
						<RotateTransform Angle="10" />
						<ScaleTransform ScaleX="2" />
					</TransformGroup.Children>
				</TransformGroup>
			</Border.RenderTransform>
		</Border>

		<local:InlineCollectionHost x:Name="Host">
			<local:InlineCollectionHost.NullDefaultItems>
				<Border />
				<Border />
			</local:InlineCollectionHost.NullDefaultItems>
			<local:InlineCollectionHost.DefaultItems>
				<Border />
			</local:InlineCollectionHost.DefaultItems>
		</local:InlineCollectionHost>
	</StackPanel>
</UserControl>
