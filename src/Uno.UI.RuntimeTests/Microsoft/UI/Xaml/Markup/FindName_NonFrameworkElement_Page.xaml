<Page
	x:Class="Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml_Markup.FindName_NonFrameworkElement_Page"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock>
			<Run x:Name="CompiledRun" Text="a" />
			<Hyperlink x:Name="CompiledLink">b</Hyperlink>
		</TextBlock>
		<Button Content="Menu">
			<Button.Flyout>
				<MenuFlyout x:Name="CompiledMenu">
					<MenuFlyoutItem Text="Item" />
				</MenuFlyout>
			</Button.Flyout>
		</Button>
		<Button x:Name="FlyoutButton" Content="Flyout">
			<Button.Flyout>
				<Flyout x:Name="CompiledFlyout">
					<TextBlock Text="Content" />
				</Flyout>
			</Button.Flyout>
		</Button>
		<Border Width="10" Height="10">
			<Border.RenderTransform>
				<ScaleTransform x:Name="CompiledTransform" />
			</Border.RenderTransform>
		</Border>
		<Border Name="PlainNamedBorder" />
	</StackPanel>
</Page>
