<UserControl x:Class="Uno.UI.RuntimeTests.When_GoToState_Current_State"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ContentControl x:Name="StatesHost"
					Width="300"
					Height="20">
		<ContentControl.Template>
			<ControlTemplate TargetType="ContentControl">
				<Grid>
					<VisualStateManager.VisualStateGroups>
						<VisualStateGroup x:Name="States">
							<VisualStateGroup.Transitions>
								<VisualTransition To="AfterTransition">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bar" Storyboard.TargetProperty="Fill">
											<DiscreteObjectKeyFrame KeyTime="0:0:10" Value="Blue" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualTransition>
							</VisualStateGroup.Transitions>
							<VisualState x:Name="Idle" />
							<VisualState x:Name="BoundSetter">
								<VisualState.Setters>
									<Setter Target="Bar.Width" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
								</VisualState.Setters>
							</VisualState>
							<VisualState x:Name="BoundAnimation">
								<Storyboard>
									<DoubleAnimation EnableDependentAnimation="True"
													 Storyboard.TargetName="Bar"
													 Storyboard.TargetProperty="Width"
													 To="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
													 Duration="0" />
								</Storyboard>
							</VisualState>
							<VisualState x:Name="Forever">
								<Storyboard RepeatBehavior="Forever">
									<DoubleAnimation EnableDependentAnimation="True"
													 Storyboard.TargetName="Bar"
													 Storyboard.TargetProperty="Width"
													 From="10"
													 To="200"
													 Duration="0:0:1" />
								</Storyboard>
							</VisualState>
							<VisualState x:Name="AfterTransition">
								<VisualState.Setters>
									<Setter Target="Bar.Height" Value="12" />
								</VisualState.Setters>
								<Storyboard>
									<DoubleAnimation EnableDependentAnimation="True"
													 Storyboard.TargetName="Bar"
													 Storyboard.TargetProperty="Width"
													 To="40"
													 Duration="0" />
								</Storyboard>
							</VisualState>
							<VisualState x:Name="SetterAndAnimation">
								<VisualState.Setters>
									<Setter Target="Bar.Width" Value="10" />
								</VisualState.Setters>
								<Storyboard>
									<DoubleAnimation EnableDependentAnimation="True"
													 Storyboard.TargetName="Bar"
													 Storyboard.TargetProperty="Width"
													 To="40"
													 Duration="0" />
								</Storyboard>
							</VisualState>
						</VisualStateGroup>
					</VisualStateManager.VisualStateGroups>
					<Rectangle x:Name="Bar"
							   Width="5"
							   HorizontalAlignment="Left"
							   Fill="Orange" />
				</Grid>
			</ControlTemplate>
		</ContentControl.Template>
	</ContentControl>
</UserControl>
