<Page
    x:Class="UITests.Shared.Uno_UI_Xaml_Controls.Validation.InputValidation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UITests.Shared.Uno_UI_Xaml_Controls.Validation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:uno="using:Uno.UI.Xaml.Controls"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d not_win">

    <Page.Resources>
        <local:ErrorsToStringConverter x:Key="ErrorsToString" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <win:TextBlock Text="This sample demos an Uno Platform only feature and is not available on Windows." />

    <not_win:ScrollViewer>
        <StackPanel
            MaxWidth="480"
            Margin="16"
            HorizontalAlignment="Left"
            Spacing="16">

            <TextBlock
                Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                Text="Errors travel from a view model implementing INotifyDataErrorInfo to the bound control. Nothing renders them by itself: the TextBlocks below bind to the read model through the converters of this sample."
                TextWrapping="Wrap" />

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="UserNameBox"
                    uno:Validation.IsEnabled="True"
                    Header="User name (5 characters minimum)"
                    Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    x:Name="UserNameErrors"
                    Foreground="Red"
                    Text="{Binding (uno:Validation.Errors), ElementName=UserNameBox, Converter={StaticResource ErrorsToString}}"
                    TextWrapping="Wrap"
                    Visibility="{Binding (uno:Validation.HasErrors), ElementName=UserNameBox, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Age (18 to 120)" />
                <Slider
                    x:Name="AgeSlider"
                    uno:Validation.IsEnabled="True"
                    Maximum="150"
                    Minimum="0"
                    Value="{Binding Age, Mode=TwoWay}" />
                <TextBlock
                    x:Name="AgeErrors"
                    Foreground="Red"
                    Text="{Binding (uno:Validation.Errors), ElementName=AgeSlider, Converter={StaticResource ErrorsToString}}"
                    TextWrapping="Wrap"
                    Visibility="{Binding (uno:Validation.HasErrors), ElementName=AgeSlider, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

        </StackPanel>
    </not_win:ScrollViewer>
</Page>
