<Page
    x:Class="UITests.Shared.Windows_UI_Composition.ScrollableShapes.ScrollableShapes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Black"
    mc:Ignorable="d">

    <Grid x:Name="host">
        <!--
            The canvas is inserted behind this in code-behind. The FlipView carries the gesture,
            the keyboard and the next/previous buttons; its pages are empty on purpose.
        -->
        <FlipView
            x:Name="flip"
            Background="Transparent"
            BorderThickness="0">
            <FlipView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" />
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>
    </Grid>
</Page>
