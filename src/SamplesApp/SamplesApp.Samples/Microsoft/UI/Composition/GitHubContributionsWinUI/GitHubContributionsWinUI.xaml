<Page
    x:Class="UITests.Shared.Windows_UI_Composition.GitHubContributionsWinUI.GitHubContributionsWinUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#F7F7F7"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Grid>
        <Border
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="16">
            <Canvas x:Name="grid" />
        </Border>

        <!--  Bottom-right, clear of the diagnostics overlay that sits in the top-left corner.  -->
        <StackPanel
            Margin="0,0,24,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                x:Name="statsText"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                Text="—" />
            <Button x:Name="runButton" Content="Run" />
        </StackPanel>
    </Grid>
</Page>
