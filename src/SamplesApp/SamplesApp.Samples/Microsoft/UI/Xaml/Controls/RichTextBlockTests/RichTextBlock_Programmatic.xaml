<UserControl
    x:Class="Uno.UI.Samples.Content.UITests.RichTextBlockControl.RichTextBlock_Programmatic"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="Programmatic Content" />

            <TextBlock FontWeight="SemiBold" Text="Dynamically built content:" />
            <RichTextBlock x:Name="DynamicBlock" />

            <TextBlock FontWeight="SemiBold" Text="Add/remove paragraphs:" />
            <RichTextBlock x:Name="MutableBlock">
                <Paragraph>
                    <Run Text="Initial paragraph." />
                </Paragraph>
            </RichTextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnAddParagraph" Content="Add Paragraph" />
                <Button Click="OnClearAll" Content="Clear All" />
            </StackPanel>
            <TextBlock x:Name="ParagraphCount" Text="Paragraphs: 1" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
