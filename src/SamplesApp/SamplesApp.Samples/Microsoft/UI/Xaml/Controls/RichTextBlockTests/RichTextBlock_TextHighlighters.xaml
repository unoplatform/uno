<UserControl
    x:Class="Uno.UI.Samples.Content.UITests.RichTextBlockControl.RichTextBlock_TextHighlighters"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="TextHighlighter Scenarios" />

            <!--  Single highlight range (set in code-behind because TextRange fields can't be set in XAML)  -->
            <TextBlock FontWeight="SemiBold" Text="Single highlight range:" />
            <RichTextBlock x:Name="SingleHighlight">
                <Paragraph>
                    <Run Text="Some text with highlighted portion in the middle of this sentence." />
                </Paragraph>
            </RichTextBlock>

            <!--  Multiple highlight ranges  -->
            <TextBlock FontWeight="SemiBold" Text="Multiple highlight ranges:" />
            <RichTextBlock x:Name="MultipleHighlights">
                <Paragraph>
                    <Run Text="First part second part third part fourth part end." />
                </Paragraph>
            </RichTextBlock>

            <!--  Highlight across paragraphs  -->
            <TextBlock FontWeight="SemiBold" Text="Highlight spanning paragraphs:" />
            <RichTextBlock x:Name="CrossParagraphHighlight">
                <Paragraph>
                    <Run Text="First paragraph text here." />
                </Paragraph>
                <Paragraph>
                    <Run Text="Second paragraph text here." />
                </Paragraph>
            </RichTextBlock>

            <!--  Programmatic highlight  -->
            <TextBlock FontWeight="SemiBold" Text="Programmatic highlight:" />
            <RichTextBlock x:Name="ProgrammaticHighlight">
                <Paragraph>
                    <Run Text="Click the button below to add a highlight to this text dynamically." />
                </Paragraph>
            </RichTextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnAddHighlight" Content="Add Highlight" />
                <Button Click="OnClearHighlights" Content="Clear Highlights" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
