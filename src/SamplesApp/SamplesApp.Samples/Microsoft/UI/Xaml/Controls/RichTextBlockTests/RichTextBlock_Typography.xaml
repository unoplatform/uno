<UserControl
    x:Class="Uno.UI.Samples.Content.UITests.RichTextBlockControl.RichTextBlock_Typography"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="Typography Properties" />

            <!--  FontFamily  -->
            <TextBlock FontWeight="SemiBold" Text="FontFamily:" />
            <RichTextBlock x:Name="FontFamilySample" FontFamily="Consolas">
                <Paragraph>
                    <Run Text="This text uses Consolas font family." />
                </Paragraph>
            </RichTextBlock>

            <!--  FontSize  -->
            <TextBlock FontWeight="SemiBold" Text="FontSize (24):" />
            <RichTextBlock x:Name="FontSizeSample" FontSize="24">
                <Paragraph>
                    <Run Text="This text has FontSize=24." />
                </Paragraph>
            </RichTextBlock>

            <!--  FontWeight  -->
            <TextBlock FontWeight="SemiBold" Text="FontWeight variations:" />
            <RichTextBlock x:Name="FontWeightLight" FontWeight="Light">
                <Paragraph><Run Text="Light weight text" /></Paragraph>
            </RichTextBlock>
            <RichTextBlock x:Name="FontWeightBold" FontWeight="Bold">
                <Paragraph><Run Text="Bold weight text" /></Paragraph>
            </RichTextBlock>
            <RichTextBlock x:Name="FontWeightBlack" FontWeight="Black">
                <Paragraph><Run Text="Black weight text" /></Paragraph>
            </RichTextBlock>

            <!--  FontStyle  -->
            <TextBlock FontWeight="SemiBold" Text="FontStyle:" />
            <RichTextBlock x:Name="FontStyleItalic" FontStyle="Italic">
                <Paragraph><Run Text="This entire block is italic." /></Paragraph>
            </RichTextBlock>

            <!--  CharacterSpacing  -->
            <TextBlock FontWeight="SemiBold" Text="CharacterSpacing:" />
            <RichTextBlock x:Name="CharSpacing0">
                <Paragraph><Run Text="CharacterSpacing = 0 (default)" /></Paragraph>
            </RichTextBlock>
            <RichTextBlock x:Name="CharSpacing200" CharacterSpacing="200">
                <Paragraph><Run Text="CharacterSpacing = 200" /></Paragraph>
            </RichTextBlock>

            <!--  TextDecorations  -->
            <TextBlock FontWeight="SemiBold" Text="TextDecorations:" />
            <RichTextBlock x:Name="Underline" TextDecorations="Underline">
                <Paragraph><Run Text="Underline decoration on entire block" /></Paragraph>
            </RichTextBlock>
            <RichTextBlock x:Name="Strikethrough" TextDecorations="Strikethrough">
                <Paragraph><Run Text="Strikethrough decoration on entire block" /></Paragraph>
            </RichTextBlock>

            <!--  Foreground  -->
            <TextBlock FontWeight="SemiBold" Text="Foreground color:" />
            <RichTextBlock x:Name="ForegroundSample" Foreground="DarkBlue">
                <Paragraph>
                    <Run Text="Block-level DarkBlue foreground, with " />
                    <Run Foreground="Red" Text="red override" />
                    <Run Text=" on a single run." />
                </Paragraph>
            </RichTextBlock>

            <!--  LineHeight  -->
            <TextBlock FontWeight="SemiBold" Text="LineHeight:" />
            <RichTextBlock x:Name="LineHeightSample" LineHeight="40">
                <Paragraph>
                    <Run Text="This block has LineHeight=40. The text should have extra vertical spacing between lines when it wraps. Try resizing the window to see wrapping behavior." />
                </Paragraph>
            </RichTextBlock>

            <!--  LineStackingStrategy  -->
            <TextBlock FontWeight="SemiBold" Text="LineStackingStrategy:" />
            <RichTextBlock
                x:Name="LSS_MaxHeight"
                LineHeight="40"
                LineStackingStrategy="MaxHeight">
                <Paragraph>
                    <Run FontSize="14" Text="MaxHeight strategy (default). " />
                    <Run FontSize="28" Text="Mixed sizes " />
                    <Run FontSize="14" Text="in one line." />
                </Paragraph>
            </RichTextBlock>
            <RichTextBlock
                x:Name="LSS_BlockLineHeight"
                LineHeight="40"
                LineStackingStrategy="BlockLineHeight">
                <Paragraph>
                    <Run FontSize="14" Text="BlockLineHeight strategy. " />
                    <Run FontSize="28" Text="Mixed sizes " />
                    <Run FontSize="14" Text="in one line." />
                </Paragraph>
            </RichTextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
