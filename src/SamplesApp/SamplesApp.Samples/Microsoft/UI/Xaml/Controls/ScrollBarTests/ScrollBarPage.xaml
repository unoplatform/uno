<!--  MUX Reference controls/dev/CommonStyles/TestUI/ScrollBarPage.xaml  -->
<Page
    x:Class="UITests.Microsoft_UI_Xaml_Controls.ScrollBarTests.ScrollBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UITests.Microsoft_UI_Xaml_Controls.ScrollBarTests"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ScrollBarTestPage"
    mc:Ignorable="d">

    <Grid Margin="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollBar
            VerticalAlignment="Bottom"
            IndicatorMode="MouseIndicator"
            Orientation="Horizontal"
            Visibility="Visible" />
        <ScrollBar
            Grid.Column="1"
            IndicatorMode="MouseIndicator"
            Orientation="Vertical"
            Visibility="Visible" />
    </Grid>
</Page>
