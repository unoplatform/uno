<Page
    x:Class="UITests.Windows_UI_Xaml_Controls.PasswordBoxTests.PasswordBox_AutoFill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UITests.Windows_UI_Xaml_Controls.PasswordBoxTests"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <StackPanel x:Name="FormHost" Spacing="8">
        <StackPanel x:Name="LoginForm" Spacing="8">
            <TextBox
                x:Name="EmailBox"
                Header="E-mail"
                InputScope="EmailSmtpAddress"
                TextChanged="OnEmailChanged" />
            <PasswordBox
                x:Name="PasswordInput"
                Header="Password"
                PasswordChanged="OnPasswordChanged" />
            <Button Click="OnConfirm">Confirm</Button>
        </StackPanel>
        <Button
            x:Name="ShowFormButton"
            Click="OnShowForm"
            Visibility="Collapsed">
            Show the form again
        </Button>
        <TextBlock x:Name="EmailReadout" Text="E-mail: (empty)" />
        <TextBlock x:Name="PasswordReadout" Text="Password: (empty)" />
    </StackPanel>
</Page>
