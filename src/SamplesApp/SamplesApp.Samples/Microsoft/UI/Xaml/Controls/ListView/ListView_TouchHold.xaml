<Page
    x:Class="SamplesApp.Windows_UI_Xaml_Controls.ListView.ListView_TouchHold"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <MenuFlyout x:Key="ItemMenu">
            <MenuFlyoutItem Click="OnMenuItemClick" Text="Edit" />
            <MenuFlyoutItem Click="OnMenuItemClick" Text="Delete" />
        </MenuFlyout>
    </Page.Resources>

    <Grid
        Padding="16"
        ColumnSpacing="16"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="6">
            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Touch long-press" />
            <TextBlock Text="Long-press a record (hold 1.5 s): its menu opens, and releasing must not raise ItemClick nor select it. A quick tap must raise ItemClick and select. Long-pressing blank space must not select or highlight the page." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnClearClick" Content="Clear log" />
                <Button Click="OnButtonClick" Content="Button (no menu)" />
                <Button
                    Click="OnButtonClick"
                    Content="Button with menu"
                    ContextFlyout="{StaticResource ItemMenu}" />
            </StackPanel>
            <TextBlock x:Name="Counters" TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            x:Name="Records"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        Padding="12,10"
                        Background="Transparent"
                        ContextFlyout="{StaticResource ItemMenu}">
                        <TextBlock Text="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                DoubleTapped="OnAreaDoubleTapped"
                Tapped="OnAreaTapped">
                <TextBlock
                    Margin="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Tapped-only area: a long-press must not raise Tapped"
                    TextWrapping="Wrap" />
            </Border>

            <TextBox
                Grid.Row="1"
                Header="TextBox (editing and selection must still work)"
                Text="Long-press a word here" />

            <ScrollViewer Grid.Row="2">
                <TextBlock
                    x:Name="Log"
                    FontSize="12"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
