<Page
    x:Class="Uno.UI.Samples.Content.UITests.TextBoxControl.TextBox_DesktopIme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel Padding="16" Spacing="8">
            <TextBlock Text="Use an IME to compose in each editor. Change focus during preedit, commit or cancel, select café or 😀, and delete around the selection. Repeat after scrolling and resizing." TextWrapping="Wrap" />
            <TextBox
                x:Name="First"
                AcceptsReturn="True"
                Header="First editor"
                Text="Latin café 😀 日本語 العربية"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="Second"
                Header="Second editor"
                Text="Focus transfer during composition" />
            <TextBox Header="Number editor" InputScope="Number" />
            <TextBox Header="Email editor" InputScope="EmailSmtpAddress" />
            <RichEditBox
                x:Name="RichEditor"
                Height="140"
                Header="Rich text editor" />
            <TextBlock x:Name="Events" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
