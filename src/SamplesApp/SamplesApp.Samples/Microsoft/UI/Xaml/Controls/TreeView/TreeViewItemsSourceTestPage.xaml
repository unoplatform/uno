<!--  MUX Reference TreeViewItemsSourceTestPage.xaml  -->
<utilities:MUXTestPage
    x:Class="UITests.Shared.Microsoft_UI_Xaml_Controls.TreeViewTests.TreeViewItemsSourceTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UITests.Shared.Microsoft_UI_Xaml_Controls.TreeViewTests"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxcontrols="using:Microsoft.UI.Xaml.Controls"
    xmlns:utilities="using:MUXControlsTestApp.Utilities"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <StackPanel
        Height="160"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <StackPanel Orientation="Vertical">
            <Button
                x:Name="SetUpContainerReuseTest1"
                Margin="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="SetUpContainerReuseTest1"
                Click="SetUpContainerReuseTest_Click"
                Content="SetUpContainerReuseTest1" />
            <Button
                x:Name="ExpandSecondItem"
                Margin="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="ExpandSecondItem"
                Click="ExpandSecondItem_Click"
                Content="ExpandSecondItem" />
            <Button
                x:Name="ScrollToEndOfContentTreeView"
                Margin="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="ScrollToEndOfContentTreeView"
                Click="ScrollToEndOfContentTreeView_Click"
                Content="ScrollToEndOfContentTreeView" />
            <Button
                x:Name="ScrollToTopOfContentTreeView"
                Margin="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="ScrollToTopOfContentTreeView"
                Click="ScrollToTopOfContentTreeView_Click"
                Content="ScrollToTopOfContentTreeView" />
        </StackPanel>
        <muxcontrols:TreeView
            x:Name="TestTreeView"
            Margin="41,0,41,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            ItemsSource="{x:Bind viewModel.Items}"
            SelectionMode="Multiple">
            <muxcontrols:TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:TreeViewViewModelItem">
                    <TreeViewItem Content="{x:Bind Name}" ItemsSource="{x:Bind Items}" />
                </DataTemplate>
            </muxcontrols:TreeView.ItemTemplate>
        </muxcontrols:TreeView>
    </StackPanel>
</utilities:MUXTestPage>
