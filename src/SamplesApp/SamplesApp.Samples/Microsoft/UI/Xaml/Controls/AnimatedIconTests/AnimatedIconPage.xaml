                                <local:AnimatedIconHost.IconSource>
                                    <controls:AnimatedIconSource>
                                        <controls:AnimatedIconSource.Source>
                                            <animatedvisuals:AnimatedFindVisualSource />
                                        </controls:AnimatedIconSource.Source>
                                        <controls:AnimatedIconSource.FallbackIconSource>
                                            <controls:SymbolIconSource Symbol="Find" />
                                        </controls:AnimatedIconSource.FallbackIconSource>
                                    </controls:AnimatedIconSource>
                                </local:AnimatedIconHost.IconSource>
                            </local:AnimatedIconHost>
                            <TextBlock HorizontalAlignment="Center" Text="Cut Behavior" />
                        </StackPanel>
                        <StackPanel>
                            <local:AnimatedIconHost
                                x:Name="SearchIcon_Queue"
                                Title="AnimatedFindVisualSource"
                                Background="DarkSlateGray"
                                Foreground="{Binding ElementName=ForegoundColorPicker, Path=Color, Converter={StaticResource ColorToSolidColorBrushConverter}}">
                                <local:AnimatedIconHost.IconSource>
                                    <controls:AnimatedIconSource>
                                        <controls:AnimatedIconSource.Source>
                                            <animatedvisuals:AnimatedFindVisualSource />
                                        </controls:AnimatedIconSource.Source>
                                        <controls:AnimatedIconSource.FallbackIconSource>
                                            <controls:SymbolIconSource Symbol="Find" />
                                        </controls:AnimatedIconSource.FallbackIconSource>
                                    </controls:AnimatedIconSource>
                                </local:AnimatedIconHost.IconSource>
                            </local:AnimatedIconHost>
                            <TextBlock HorizontalAlignment="Center" Text="Queue Behavior" />
                        </StackPanel>
                        <StackPanel>
                            <local:AnimatedIconHost
                                x:Name="SearchIcon_SpeedUpQueue"
                                Title="AnimatedFindVisualSource"
                                Background="DarkSlateGray"
                                Foreground="{Binding ElementName=ForegoundColorPicker, Path=Color, Converter={StaticResource ColorToSolidColorBrushConverter}}">
                                <local:AnimatedIconHost.IconSource>
                                    <controls:AnimatedIconSource>
                                        <controls:AnimatedIconSource.Source>
                                            <animatedvisuals:AnimatedFindVisualSource />
                                        </controls:AnimatedIconSource.Source>
                                        <controls:AnimatedIconSource.FallbackIconSource>
                                            <controls:SymbolIconSource Symbol="Find" />
                                        </controls:AnimatedIconSource.FallbackIconSource>
                                    </controls:AnimatedIconSource>
                                </local:AnimatedIconHost.IconSource>
                            </local:AnimatedIconHost>
                            <TextBlock HorizontalAlignment="Center" Text="Speed Up Queue Behavior" />
                        </StackPanel>
                    </StackPanel>

                    <!--  TODO Uno specific: BrightnessSun needs Win2D, which the WinAppSDK head does not reference. Upstream binds the Slider with a TwoWay x:Bind to the attached property, which the Uno XAML generator rejects.  -->
                    <not_win:StackPanel
                        Width="250"
                        Height="250"
                        Background="Gray"
                        Orientation="Horizontal">
                        <Slider
                            x:Name="Slider"
                            Width="100"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ElementName=SliderIcon, Path=(controls:AnimatedIcon.State), Mode=TwoWay, Converter={StaticResource DoubleToStringConverter}}">
                            <Slider.Header>
                                <controls:AnimatedIcon
                                    x:Name="SliderIcon"
                                    Width="100"
                                    Height="100"
                                    Foreground="Red">
                                    <myAnimatedvisuals:BrightnessSun />
                                </controls:AnimatedIcon>
                            </Slider.Header>
                        </Slider>
                    </not_win:StackPanel>
                    <StackPanel Background="Gray">
                        <TextBlock Text="Checkbox with AnimatedIcon check." />
                        <CheckBox x:Name="AnimatedCheckbox" HorizontalAlignment="Center" />
                        <Viewbox Width="800" Height="200">
                            <CheckBox x:Name="LargeAnimatedCheckbox" HorizontalAlignment="Center" />
                        </Viewbox>
                        <TextBlock x:Name="LastTransitionTextBlock" />
                    </StackPanel>
                    <StackPanel Background="Gray">
                        <TextBlock Text="Button with animated icon child" />
                        <Button Width="100" Height="100">
                            <controls:AnimatedIcon>
                                <animatedvisuals:AnimatedFindVisualSource />
                            </controls:AnimatedIcon>
                        </Button>
                        <TextBlock Text="Button with animated icon grandchild" />
                        <Button Width="100" Height="100">
                            <Border>
                                <controls:AnimatedIcon>
                                    <animatedvisuals:AnimatedFindVisualSource />
                                </controls:AnimatedIcon>
                            </Border>
                        </Button>
                        <StackPanel>
                            <StackPanel.Resources>
                                <controls:FontIconSource x:Name="MyFontIconSource" Glyph="{Binding ElementName=boundFallback, Path=FallbackGlyph}" />
                            </StackPanel.Resources>
                            <local:AnimatedIconHost
                                x:Name="boundFallback"
                                Title="AnimatedFindVisualSource"
                                Background="DarkSlateGray"
                                FallbackGlyph="&#xE73E;"
                                Foreground="{StaticResource TestIconForeground}">
                                <local:AnimatedIconHost.IconSource>
                                    <controls:AnimatedIconSource FallbackIconSource="{StaticResource MyFontIconSource}" />
                                </local:AnimatedIconHost.IconSource>
                            </local:AnimatedIconHost>
                            <controls:AnimatedIcon FallbackIconSource="{StaticResource MyFontIconSource}" />
                            <Button Click="ChangeFallbackGlyphButton_Click" Content="Change FallbackGlyph" />
                        </StackPanel>
                        <StackPanel Background="Maroon">
                            <controls:AnimatedIcon
                                Width="100"
                                Height="100"
                                Foreground="Pink">
                                <controls:AnimatedIcon.FallbackIconSource>
                                    <controls:SymbolIconSource Foreground="Purple" Symbol="AddFriend" />
                                </controls:AnimatedIcon.FallbackIconSource>
                            </controls:AnimatedIcon>
                        </StackPanel>
                        <StackPanel Background="DarkGreen">
                            <controls:AnimatedIcon
                                Width="100"
                                Height="100"
                                Foreground="Pink"
                                MirroredWhenRightToLeft="True">
                                <controls:AnimatedIcon.Source>
                                    <animatedvisuals:AnimatedBackVisualSource />
                                </controls:AnimatedIcon.Source>
                            </controls:AnimatedIcon>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
