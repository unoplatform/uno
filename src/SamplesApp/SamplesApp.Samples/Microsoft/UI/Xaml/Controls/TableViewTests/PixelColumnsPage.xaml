<!--  MUX Reference Samples\TableViewSampleApp\PixelColumnsPage.xaml, tag winui3/release/2.5.4-experimental, commit 7b127093475  -->
<Page
    x:Class="MUXControlsTestApp.PixelColumnsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="All Pixel columns" />
            <TextBlock
                FontSize="12"
                Opacity="0.7"
                Text="Every column has a fixed GridUnitType.Pixel width, independent of content. Their combined width exceeds a narrow window, so the body scrolls horizontally and the sticky header stays in sync."
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <tv:TableView x:Name="Table" />
        </Border>
    </Grid>
</Page>
