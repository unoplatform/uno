<!--  MUX Reference Samples\TableViewSampleApp\ShapingPage.xaml, tag winui3/release/2.5.4-experimental, commit 7b127093475  -->
<Page
    x:Class="MUXControlsTestApp.ShapingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="C"
            Invoked="CollapseAccel_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator
            Key="E"
            Invoked="ExpandAccel_Invoked"
            Modifiers="Control,Shift" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!--
            GroupHeaderTemplate binds the TableViewGroupInfo projection the control hands the
            header: Key / ItemCount for raw values, KeyText / ItemCountText for the
            culture-formatted strings the built-in template uses. The expander glyph is owned by
            the control's TableViewGroupHeader template, not by this content template.
        -->
        <DataTemplate x:Key="GroupHeader">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding KeyText}" />
                <Border
                    Padding="8,1"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                    CornerRadius="10">
                    <TextBlock
                        FontSize="12"
                        Opacity="0.8"
                        Text="{Binding ItemCountText}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="Filtering, sorting and grouping" />
            <TextBlock
                FontSize="12"
                Opacity="0.7"
                Text="Filter and GroupBy are stages declared on ONE TableViewSource, so they compose — filter narrows the rows, group buckets what survives. Sort has two front-ends and they converge rather than stack: 'via TableView' calls SortByColumn, which owns the header chevron; 'via TableViewSource' calls the fluent Sort verb, which has no column to light up. Whichever runs last wins and clears the other, so exactly one sort is ever in force — switch the dropdown after sorting, or click a header while sorted via the source, to watch the chevron follow. Selection re-anchors to the same item across a reshape, so select a row and then filter or sort to watch it follow."
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Filter  -->
        <StackPanel
            Grid.Row="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                Width="52"
                VerticalAlignment="Center"
                Text="Filter:" />
            <TextBox
                x:Name="FilterBox"
                Width="220"
                PlaceholderText="name, role or city"
                TextChanged="Filter_Changed" />
            <CheckBox
                x:Name="HighScoresOnly"
                Checked="Filter_Toggled"
                Content="Score &#8805; 50"
                Unchecked="Filter_Toggled" />
            <Button Click="ClearFilter_Click" Content="Clear filter" />
        </StackPanel>

        <!--  Group  -->
        <StackPanel
            Grid.Row="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                Width="52"
                VerticalAlignment="Center"
                Text="Group:" />
            <ComboBox
                x:Name="GroupCombo"
                Width="160"
                SelectionChanged="Group_Changed">
                <ComboBoxItem Content="None" IsSelected="True" />
                <ComboBoxItem Content="Role" />
                <ComboBoxItem Content="City" />
                <ComboBoxItem Content="Score band" />
            </ComboBox>
            <Button Click="ExpandAll_Click" Content="Expand all" />
            <Button Click="CollapseAll_Click" Content="Collapse all" />
            <CheckBox
                x:Name="CustomHeaderToggle"
                Checked="GroupHeaderTemplate_Toggled"
                Content="Custom GroupHeaderTemplate"
                IsChecked="True"
                Unchecked="GroupHeaderTemplate_Toggled" />
        </StackPanel>

        <!--  Sort  -->
        <StackPanel
            Grid.Row="3"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                Width="52"
                VerticalAlignment="Center"
                Text="Sort:" />
            <ComboBox
                x:Name="SortCombo"
                Width="160"
                SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="None" IsSelected="True" />
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Role" />
                <ComboBoxItem Content="City" />
                <ComboBoxItem Content="Score" />
                <ComboBoxItem Content="Joined" />
            </ComboBox>
            <ComboBox
                x:Name="DirectionCombo"
                Width="140"
                SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="Ascending" IsSelected="True" />
                <ComboBoxItem Content="Descending" />
            </ComboBox>
            <ComboBox
                x:Name="ViaCombo"
                Width="230"
                SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="via TableView" IsSelected="True" />
                <ComboBoxItem Content="via source (path)" />
                <ComboBoxItem Content="via source (key)" />
            </ComboBox>
            <CheckBox
                x:Name="HeaderSortToggle"
                Checked="HeaderSort_Toggled"
                Content="Click-to-sort headers"
                IsChecked="True"
                Unchecked="HeaderSort_Toggled" />
            <Button Click="ClearSort_Click" Content="Clear sort" />
        </StackPanel>

        <!--
            Sort cycle: what a header click walks through, per column. Only reachable when
            click-to-sort is on.
        -->
        <StackPanel
            Grid.Row="4"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                Width="52"
                VerticalAlignment="Center"
                Text="Cycle:" />
            <ComboBox
                x:Name="CycleCombo"
                Width="260"
                SelectionChanged="SortCycle_Changed">
                <ComboBoxItem Content="As authored" IsSelected="True" />
                <ComboBoxItem Content="AscendingDescending" />
                <ComboBoxItem Content="AscendingDescendingNone" />
                <ComboBoxItem Content="DescendingAscending" />
                <ComboBoxItem Content="DescendingAscendingNone" />
            </ComboBox>
            <TextBlock
                x:Name="CycleHint"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--
            Diagnostic: detaches and re-attaches the TableView so it goes Unloaded -> Loaded with
            the same ItemsSource. That is the "repump" path - the rows pipeline re-runs against an
            unchanged ItemsSourceView, which is when subscription order is at risk of inverting.
        -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="RepumpButton"
                Click="Repump_Click"
                Content="Repump (unload/reload)" />
            <Button
                x:Name="AddItemButton"
                Click="AddItem_Click"
                Content="Add item" />
            <Button
                x:Name="ClearSelLogButton"
                Click="ClearSelLog_Click"
                Content="Clear sel log" />
            <CheckBox
                x:Name="BandingToggle"
                Checked="Banding_Changed"
                Content="Banding"
                Unchecked="Banding_Changed" />
            <Button
                x:Name="DumpBandingButton"
                Click="DumpBanding_Click"
                Content="Dump banding" />
        </StackPanel>

        <Border
            x:Name="TableHost"
            Grid.Row="5"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <tv:TableView x:Name="Table" SelectionMode="Single" />
        </Border>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="6"
            FontFamily="Consolas"
            FontSize="12"
            TextWrapping="Wrap" />
    </Grid>
</Page>
