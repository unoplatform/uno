<!--  MUX Reference Samples\TableViewSampleApp\MixedColumnsPage.xaml, tag winui3/release/2.5.4-experimental, commit 7b127093475  -->
<Page
    x:Class="MUXControlsTestApp.MixedColumnsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="Mixed columns (Auto + Pixel + Star)" />
            <TextBlock
                FontSize="12"
                Opacity="0.7"
                Text="A mix of width kinds: Name (Auto), Role (120px), Score (Template, 120px), City (*1), Bio (*2). Fixed and Auto columns are sized first, then the Star columns split the remaining viewport width."
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <tv:TableView x:Name="Table" />
        </Border>
    </Grid>
</Page>
