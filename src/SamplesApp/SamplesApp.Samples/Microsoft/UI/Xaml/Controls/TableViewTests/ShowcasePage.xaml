<Page
    x:Class="MUXControlsTestApp.ShowcasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:Microsoft.UI.Xaml.Controls.Tabular"
    RequestedTheme="Dark">

    <Page.Resources>
        <Style x:Key="ShowcaseChip" TargetType="Border">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <DataTemplate x:Key="FeatureCell">
            <StackPanel
                Padding="12,8"
                Orientation="Horizontal"
                Spacing="12">
                <Border
                    Width="34"
                    Height="34"
                    Background="{Binding TileBrush}"
                    CornerRadius="8">
                    <FontIcon
                        FontSize="16"
                        Foreground="White"
                        Glyph="{Binding Glyph}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Feature}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Area}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OwnerCell">
            <StackPanel
                Padding="12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Width="28"
                    Height="28"
                    Background="{Binding AvatarBrush}"
                    CornerRadius="14">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding Initials}" />
                </Border>
                <TextBlock VerticalAlignment="Center" Text="{Binding Owner}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StatusCell">
            <Grid Padding="12,0" VerticalAlignment="Center">
                <Border
                    Padding="10,3"
                    HorizontalAlignment="Left"
                    Background="{Binding StatusBackground}"
                    BorderBrush="{Binding StatusForeground}"
                    BorderThickness="1"
                    CornerRadius="11">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{Binding StatusForeground}" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{Binding StatusForeground}"
                            Text="{Binding Status}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProgressCell">
            <Grid
                Padding="12,0"
                VerticalAlignment="Center"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    MinHeight="6"
                    VerticalAlignment="Center"
                    CornerRadius="3"
                    Foreground="{Binding StatusForeground}"
                    Maximum="100"
                    Value="{Binding Progress}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding ProgressText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TestsCell">
            <StackPanel
                Padding="12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;" />
                <TextBlock FontFamily="Consolas" Text="{Binding TestsText}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UpdatedCell">
            <TextBlock
                Padding="12,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding Updated}" />
        </DataTemplate>

        <DataTemplate x:Key="MilestoneHeader">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{Binding KeyText}" />
                <Border
                    Padding="8,1"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding ItemCountText}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="40,32" RowSpacing="24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF14102A" />
                <GradientStop Offset="0.55" Color="#FF0F1A2E" />
                <GradientStop Offset="1" Color="#FF0B2530" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock
                    CharacterSpacing="120"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#FF8FB8FF"
                    Text="WINUI TABLEVIEW · NOW ON UNO PLATFORM" />
                <TextBlock
                    FontSize="34"
                    FontWeight="SemiBold"
                    Text="Contoso Notes · Release Tracker" />
                <TextBlock
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="One C# codebase, one TableView: Windows, macOS, Linux, iOS, Android and the Web." />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Border Style="{StaticResource ShowcaseChip}">
                    <TextBlock Text="Sorting" />
                </Border>
                <Border Style="{StaticResource ShowcaseChip}">
                    <TextBlock Text="Grouping" />
                </Border>
                <Border Style="{StaticResource ShowcaseChip}">
                    <TextBlock Text="Frozen columns" />
                </Border>
                <Border Style="{StaticResource ShowcaseChip}">
                    <TextBlock Text="Resizing" />
                </Border>
                <Border Style="{StaticResource ShowcaseChip}">
                    <TextBlock Text="Accessible" />
                </Border>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <tv:TableView
                x:Name="Table"
                Margin="1"
                Density="Comfortable"
                GridLinesVisibility="Horizontal" />
        </Border>
    </Grid>
</Page>
