<Page
    x:Class="UITests.Shared.Windows_UI_Xaml_Controls.Popup.Popup_Windowed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Popups that leave the window. Make the window smaller than the content below, then:" TextWrapping="Wrap" />
        <TextBlock Text="1. Open the popup: its right half is out of the window, on a transparent surface with a shadow." TextWrapping="Wrap" />
        <TextBlock Text="2. Click the button and drag the slider where they're out of the window: both have to respond." TextWrapping="Wrap" />
        <TextBlock Text="3. Move the window: the popup follows. Click in the window or in another app: the popup closes." TextWrapping="Wrap" />

        <ToggleButton
            x:Name="OpenPopup"
            x:FieldModifier="public"
            Checked="OnOpenPopupChecked"
            Content="Open the out of window popup"
            Unchecked="OnOpenPopupUnchecked" />

        <Button Content="Open a MenuFlyout">
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="First item with a long enough text to leave a small window" />
                    <MenuFlyoutItem Text="Second item" />
                    <MenuFlyoutSubItem Text="A sub menu">
                        <MenuFlyoutItem Text="Sub item one" />
                        <MenuFlyoutItem Text="Sub item two" />
                    </MenuFlyoutSubItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>

        <ComboBox PlaceholderText="A ComboBox">
            <x:String>One</x:String>
            <x:String>Two</x:String>
            <x:String>Three</x:String>
        </ComboBox>

        <Button Content="Hover for a ToolTip" ToolTipService.ToolTip="A ToolTip has a window of its own too" />

        <TextBlock
            x:Name="ClickCount"
            x:FieldModifier="public"
            Text="Clicks: 0" />
        <TextBlock
            x:Name="SliderValue"
            x:FieldModifier="public"
            Text="Slider: 0" />
    </StackPanel>
</Page>
