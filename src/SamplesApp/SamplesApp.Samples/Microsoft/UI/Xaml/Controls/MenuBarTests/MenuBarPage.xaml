<Page
    x:Class="UITests.Microsoft_UI_Xaml_Controls.MenuBarTests.MenuBarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UITests.Microsoft_UI_Xaml_Controls.MenuBarTests"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid Margin="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="contentRoot" Grid.Row="0">
            <Button AutomationProperties.Name="FirstButton" Content="Element to test that focus moves correctly" />

            <TextBlock Style="{ThemeResource StandardGroupHeader}" Text="Sample controls" />
            <TextBlock Text="Sample menu bar" />
            <muxc:MenuBar x:Name="menuBar">
                <muxc:MenuBarItem
                    x:Name="FileItem"
                    Title="File"
                    AutomationProperties.Name="FileItem">
                    <MenuFlyoutItem
                        x:Name="NewItem"
                        AutomationProperties.Name="NewItem"
                        Click="NewItem_Click"
                        Text="New" />
                    <MenuFlyoutItem Text="Open..." />
                    <MenuFlyoutItem Text="Save" />
                    <MenuFlyoutItem Text="Save As..." />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Page Setup..." />
                    <MenuFlyoutItem Text="Print..." />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" />
                </muxc:MenuBarItem>

                <muxc:MenuBarItem
                    x:Name="EditItem"
                    Title="Edit"
                    AutomationProperties.Name="EditItem">
                    <MenuFlyoutItem
                        x:Name="UndoItem"
                        AutomationProperties.Name="UndoItem"
                        Text="Undo" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="CutItem"
                        AutomationProperties.Name="CutItem"
                        Text="Cut" />
                    <MenuFlyoutItem Text="Copy" />
                    <MenuFlyoutItem Text="Paste" />
                    <MenuFlyoutItem Text="Delete" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Sub menu">
                        <MenuFlyoutItem Text="Item 1" />
                        <MenuFlyoutItem Text="Item 2" />
                        <MenuFlyoutItem Text="Item 3" />
                    </MenuFlyoutSubItem>
                </muxc:MenuBarItem>

                <muxc:MenuBarItem Title="No children" AutomationProperties.Name="NoChildrenFlyout" />
                <muxc:MenuBarItem
                    x:Name="OneChildrenFlyoutMenuBarItem"
                    Title="One children"
                    AutomationProperties.Name="OneChildrenFlyout">
                    <MenuFlyoutItem Text="Sometext" />
                </muxc:MenuBarItem>

                <muxc:MenuBarItem Title="Format">
                    <MenuFlyoutItem Text="Word Wrap" />
                    <MenuFlyoutItem Text="Font..." />
                </muxc:MenuBarItem>

            </muxc:MenuBar>

            <TextBlock Margin="0,6,0,0" Text="Custom sized menu bar" />
            <muxc:MenuBar
                x:Name="SizedMenuBar"
                Height="24"
                MinHeight="24"
                AutomationProperties.Name="SizedMenuBar">
                <muxc:MenuBarItem
                    x:Name="SizedMenuBarItem"
                    Title="Size"
                    AutomationProperties.Name="SizedMenuBarItem" />
            </muxc:MenuBar>

            <TextBlock Margin="0,6,0,0" Text="Initially empty menubar" />
            <muxc:MenuBar x:Name="EmptyMenuBar" />

            <TextBlock Text="Disabled items test" />
            <StackPanel Orientation="Horizontal">
                <muxc:MenuBar>
                    <muxc:MenuBarItem
                        x:Name="MenuBarPartiallyEnabledOne"
                        Title="MenuBarPartiallyEnabledOne"
                        AutomationProperties.Name="MenuBarPartiallyEnabledOne">
                        <MenuFlyoutItem AutomationProperties.Name="PartiallyEnabledFlyoutOne" Text="PartiallyEnabledFlyoutOne" />
                        <MenuFlyoutItem Text="Open..." />
                        <MenuFlyoutItem Text="Save" />
                        <MenuFlyoutItem Text="Exit" />
                    </muxc:MenuBarItem>

                    <muxc:MenuBarItem Title="Edit" IsEnabled="false">
                        <MenuFlyoutItem AutomationProperties.Name="PartiallyEnabledFlyoutTwo" Text="PartiallyEnabledFlyoutTwo" />
                        <MenuFlyoutItem Text="Cut" />
                        <MenuFlyoutItem Text="Copy" />
                        <MenuFlyoutItem Text="Paste" />
                    </muxc:MenuBarItem>

                    <muxc:MenuBarItem Title="Help">
                        <MenuFlyoutItem AutomationProperties.Name="PartiallyEnabledFlyoutThree" Text="PartiallyEnabledFlyoutThree" />
                        <MenuFlyoutItem Text="About" />
                    </muxc:MenuBarItem>
                </muxc:MenuBar>
                <muxc:MenuBar>
                    <muxc:MenuBarItem
                        x:Name="LoopTestBarOne"
                        Title="LoopTestBarOne"
                        AutomationProperties.Name="LoopTestBarOne">
                        <MenuFlyoutItem AutomationProperties.Name="LoopTestItemOne" Text="PartiallyEnabledFlyoutOne" />
                        <MenuFlyoutItem Text="Open..." />
                        <MenuFlyoutItem Text="Save" />
                        <MenuFlyoutItem Text="Exit" />
                    </muxc:MenuBarItem>

                    <muxc:MenuBarItem Title="Edit" IsEnabled="false">
                        <MenuFlyoutItem AutomationProperties.Name="PartiallyEnabledFlyoutTwo" Text="PartiallyEnabledFlyoutTwo" />
                        <MenuFlyoutItem Text="Cut" />
                        <MenuFlyoutItem Text="Copy" />
                        <MenuFlyoutItem Text="Paste" />
                    </muxc:MenuBarItem>
                </muxc:MenuBar>
            </StackPanel>
        </StackPanel>
        <TextBlock
            Grid.Row="1"
            Style="{ThemeResource StandardGroupHeader}"
            Text="Options" />
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,20"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel.Resources>
                <Style TargetType="Control">
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="FontSize" Value="10" />
                </Style>
            </StackPanel.Resources>
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    x:Name="TestFrameCheckbox"
                    Margin="5"
                    AutomationProperties.Name="TestFrameCheckbox"
                    Checked="TestFrameCheckbox_Checked"
                    Content="Show Test Frame"
                    IsChecked="True"
                    Unchecked="TestFrameCheckbox_Unchecked" />
                <Button
                    x:Name="AddMenuBarItemButton"
                    AutomationProperties.Name="AddMenuBarItemButton"
                    Click="AddMenuBarItem_Click"
                    Content="Add Menu Bar Item" />
                <Button
                    x:Name="RemoveMenuBarItemButton"
                    AutomationProperties.Name="RemoveMenuBarItemButton"
                    Click="RemoveMenuBarItem_Click"
                    Content="Remove Menu Bar Item" />
                <Button
                    x:Name="AddFlyoutItemButton"
                    AutomationProperties.Name="AddFlyoutItemButton"
                    Click="AddFlyoutItem_Click"
                    Content="Add Flyout Item" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="RemoveFlyoutItemButton"
                    AutomationProperties.Name="RemoveFlyoutItemButton"
                    Click="RemoveFlyoutItem_Click"
                    Content="Remove Flyout Item" />
                <Button
                    x:Name="AddItemsToEmptyMenuBar"
                    AutomationProperties.Name="AddItemsToEmptyMenuBar"
                    Click="AddMenuBarToEmptyMenuBarItem_Click"
                    Content="Add a menu item to the empty menu bar" />
                <Button
                    x:Name="RemoveItemsFromOneChildrenItem"
                    AutomationProperties.Name="RemoveItemsFromOneChildrenItem"
                    Click="RemoveItemsFromOneChildrenItem_Click"
                    Content="Remove items from One Children item" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Style="{ThemeResource StandardGroupHeader}" Text="Test output" />
            <TextBlock x:Name="TextOutput" />
        </StackPanel>
    </Grid>
</Page>
