<Page
    x:Class="UITests.Windows_UI_ViewManagement.SoftKeyboardFocusedFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="A flyout that focuses its search box when it opens (test in a phone browser)" />
            <TextBlock Text="1) Tap &quot;Pick (in page)&quot;: the flyout opens, its search box takes focus and the keyboard comes up. The flyout must stay open." TextWrapping="Wrap" />
            <TextBlock Text="2) Tap &quot;Open dialog&quot;, then &quot;Pick (in dialog)&quot;: same check, with the button inside a ContentDialog." TextWrapping="Wrap" />
            <DropDownButton x:Name="PageButton" Content="Pick (in page)">
                <DropDownButton.Flyout>
                    <Flyout
                        x:Name="PageFlyout"
                        Closed="OnFlyoutClosed"
                        Opened="OnFlyoutOpened"
                        Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="280" Spacing="8">
                            <TextBox x:Name="PageSearchBox" PlaceholderText="Search..." />
                            <ListView x:Name="PageList" MaxHeight="240" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Click="OnOpenDialog" Content="Open dialog" />
            <Button Click="OnClearLog" Content="Clear log" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <TextBlock
                x:Name="LogTextBlock"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</Page>
