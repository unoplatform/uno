<Page
    x:Class="UITests.Shared.Windows_UI_Xaml_Controls.ScrollViewerTests.ScrollViewer_SmoothnessTester"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <muxc:TabView IsAddTabButtonVisible="False">
            <muxc:TabViewItem Header="StackPanel - Vertical" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="VerticalStack"
                        Orientation="Vertical"
                        Spacing="4" />
                </ScrollViewer>
            </muxc:TabViewItem>
            <muxc:TabViewItem Header="StackPanel - Horizontal" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel
                        x:Name="HorizontalStack"
                        Orientation="Horizontal"
                        Spacing="4" />
                </ScrollViewer>
            </muxc:TabViewItem>
            <muxc:TabViewItem Header="ListView" IsClosable="False">
                <ListView x:Name="ListViewHost">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Rectangle
                                Width="300"
                                Height="300"
                                Margin="4"
                                Fill="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </muxc:TabViewItem>
            <muxc:TabViewItem Header="ItemsRepeater" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <muxc:ItemsRepeater x:Name="ItemsRepeaterHost">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Orientation="Vertical" Spacing="4" />
                        </muxc:ItemsRepeater.Layout>
                        <muxc:ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Rectangle
                                    Width="300"
                                    Height="300"
                                    Fill="{Binding}" />
                            </DataTemplate>
                        </muxc:ItemsRepeater.ItemTemplate>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </muxc:TabViewItem>
        </muxc:TabView>
    </Grid>
</Page>
