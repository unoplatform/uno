<Page
    x:Class="UITests.Windows_Media.SpeechRecognizerTests"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UITests.Windows_Media"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="12" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind Model.RecognizeCommand}" Content="Recognize" />
                <Button Command="{x:Bind Model.StopCommand}" Content="Stop" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind Model.StartContinuousCommand}" Content="Start continuous" />
                <Button Command="{x:Bind Model.PauseContinuousCommand}" Content="Pause" />
                <Button Command="{x:Bind Model.ResumeContinuousCommand}" Content="Resume" />
                <Button Command="{x:Bind Model.StopContinuousCommand}" Content="Stop continuous" />
                <Button Command="{x:Bind Model.CancelContinuousCommand}" Content="Cancel continuous" />
            </StackPanel>
            <CheckBox Content="Only accept &quot;yes&quot;, &quot;no&quot; or &quot;maybe later&quot; (list constraint)" IsChecked="{x:Bind Model.UseListConstraint, Mode=TwoWay}" />

            <TextBlock Text="{x:Bind Model.State, Mode=OneWay}" />
            <TextBlock
                FontSize="24"
                Text="{x:Bind Model.Hypothesis, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                FontSize="30"
                Text="{x:Bind Model.LastResult, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
            <TextBlock Text="{x:Bind Model.LastResultDetails, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Model.Languages, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Events" />
            <TextBlock Text="{x:Bind Model.Log, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
