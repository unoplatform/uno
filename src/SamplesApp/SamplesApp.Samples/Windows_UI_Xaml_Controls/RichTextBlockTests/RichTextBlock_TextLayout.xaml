<UserControl
    x:Class="Uno.UI.Samples.Content.UITests.RichTextBlockControl.RichTextBlock_TextLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1000"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="Text Layout Properties" />

            <!--  TextWrapping: Wrap (default for RichTextBlock)  -->
            <TextBlock FontWeight="SemiBold" Text="TextWrapping=Wrap (default):" />
            <Border
                Width="250"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="WrapSample" TextWrapping="Wrap">
                    <Paragraph>
                        <Run Text="This is a long text that should wrap at the container boundary. RichTextBlock defaults to Wrap unlike TextBlock." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  TextWrapping: NoWrap  -->
            <TextBlock FontWeight="SemiBold" Text="TextWrapping=NoWrap:" />
            <Border
                Width="250"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="NoWrapSample" TextWrapping="NoWrap">
                    <Paragraph>
                        <Run Text="This text should not wrap and will overflow the container boundary." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  TextTrimming: None  -->
            <TextBlock FontWeight="SemiBold" Text="TextTrimming=None:" />
            <Border
                Width="250"
                Height="40"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock
                    x:Name="TrimNone"
                    TextTrimming="None"
                    TextWrapping="NoWrap">
                    <Paragraph>
                        <Run Text="This text is not trimmed and may overflow." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  TextTrimming: CharacterEllipsis  -->
            <TextBlock FontWeight="SemiBold" Text="TextTrimming=CharacterEllipsis:" />
            <Border
                Width="250"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock
                    x:Name="TrimCharEllipsis"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap">
                    <Paragraph>
                        <Run Text="This text should be trimmed with an ellipsis character." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  TextTrimming: WordEllipsis  -->
            <TextBlock FontWeight="SemiBold" Text="TextTrimming=WordEllipsis:" />
            <Border
                Width="250"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock
                    x:Name="TrimWordEllipsis"
                    TextTrimming="WordEllipsis"
                    TextWrapping="NoWrap">
                    <Paragraph>
                        <Run Text="This text should be trimmed with word ellipsis at word boundaries." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  MaxLines  -->
            <TextBlock FontWeight="SemiBold" Text="MaxLines=2:" />
            <Border
                Width="250"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="MaxLinesSample" MaxLines="2">
                    <Paragraph>
                        <Run Text="This text has MaxLines=2. It should show at most two lines of text even though there is much more content that would normally display across many more lines." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  MaxLines with multiple paragraphs  -->
            <TextBlock FontWeight="SemiBold" Text="MaxLines=3 with multiple paragraphs:" />
            <Border
                Width="250"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="MaxLinesMultiPara" MaxLines="3">
                    <Paragraph>
                        <Run Text="First paragraph line one. First paragraph line two." />
                    </Paragraph>
                    <Paragraph>
                        <Run Text="Second paragraph line one. Second paragraph line two." />
                    </Paragraph>
                    <Paragraph>
                        <Run Text="Third paragraph that should not appear." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  TextAlignment  -->
            <TextBlock FontWeight="SemiBold" Text="TextAlignment:" />
            <Border
                Width="300"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="AlignLeft" TextAlignment="Left">
                    <Paragraph><Run Text="Left aligned text" /></Paragraph>
                </RichTextBlock>
            </Border>
            <Border
                Width="300"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="AlignCenter" TextAlignment="Center">
                    <Paragraph><Run Text="Center aligned text" /></Paragraph>
                </RichTextBlock>
            </Border>
            <Border
                Width="300"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="AlignRight" TextAlignment="Right">
                    <Paragraph><Run Text="Right aligned text" /></Paragraph>
                </RichTextBlock>
            </Border>
            <Border
                Width="300"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="AlignJustify" TextAlignment="Justify">
                    <Paragraph>
                        <Run Text="Justify aligned text that should spread evenly across the available width when text wraps to multiple lines." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  Padding  -->
            <TextBlock FontWeight="SemiBold" Text="Padding=20:" />
            <Border BorderBrush="Gray" BorderThickness="1">
                <RichTextBlock x:Name="PaddingSample" Padding="20">
                    <Paragraph>
                        <Run Text="This text has 20px padding on all sides." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  TextIndent (per paragraph)  -->
            <TextBlock FontWeight="SemiBold" Text="TextIndent=30 on paragraph:" />
            <Border
                Width="300"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="TextIndentSample">
                    <Paragraph TextIndent="30">
                        <Run Text="This paragraph has a 30px text indent. The first line should be indented while subsequent wrapped lines are not." />
                    </Paragraph>
                    <Paragraph>
                        <Run Text="This paragraph has no indent." />
                    </Paragraph>
                </RichTextBlock>
            </Border>

            <!--  Paragraph Margin  -->
            <TextBlock FontWeight="SemiBold" Text="Paragraph Margin:" />
            <Border
                Width="300"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="ParagraphMarginSample">
                    <Paragraph Margin="0,0,0,20">
                        <Run Text="Paragraph with bottom margin of 20." />
                    </Paragraph>
                    <Paragraph Margin="20,0,0,0">
                        <Run Text="Paragraph with left margin of 20." />
                    </Paragraph>
                    <Paragraph>
                        <Run Text="Paragraph with no margin." />
                    </Paragraph>
                </RichTextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
