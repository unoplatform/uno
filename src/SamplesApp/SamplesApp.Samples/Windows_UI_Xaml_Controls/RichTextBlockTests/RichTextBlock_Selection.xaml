<UserControl
    x:Class="Uno.UI.Samples.Content.UITests.RichTextBlockControl.RichTextBlock_Selection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="Text Selection Scenarios" />

            <!--  Selection enabled  -->
            <TextBlock FontWeight="SemiBold" Text="IsTextSelectionEnabled=True:" />
            <RichTextBlock x:Name="SelectableText" IsTextSelectionEnabled="True">
                <Paragraph>
                    <Run Text="This text is selectable. Try clicking and dragging to select text. You can also use Ctrl+A to select all and Ctrl+C to copy." />
                </Paragraph>
                <Paragraph>
                    <Run Text="Selection works across paragraphs too. Try selecting from the first paragraph to this one." />
                </Paragraph>
            </RichTextBlock>

            <!--  Selection disabled (default)  -->
            <TextBlock FontWeight="SemiBold" Text="IsTextSelectionEnabled=False (default):" />
            <RichTextBlock x:Name="NonSelectableText">
                <Paragraph>
                    <Run Text="This text is NOT selectable. Clicking and dragging should have no effect." />
                </Paragraph>
            </RichTextBlock>

            <!--  Selection with highlight color  -->
            <TextBlock FontWeight="SemiBold" Text="Custom SelectionHighlightColor:" />
            <RichTextBlock x:Name="CustomSelectionColor" IsTextSelectionEnabled="True">
                <RichTextBlock.SelectionHighlightColor>
                    <SolidColorBrush Color="LightGreen" />
                </RichTextBlock.SelectionHighlightColor>
                <Paragraph>
                    <Run Text="This text has a custom green selection highlight color. Select some text to see it." />
                </Paragraph>
            </RichTextBlock>

            <!--  SelectAll button  -->
            <TextBlock FontWeight="SemiBold" Text="Programmatic selection:" />
            <RichTextBlock x:Name="ProgrammaticSelection" IsTextSelectionEnabled="True">
                <Paragraph>
                    <Run Text="Use the button below to select all text programmatically." />
                </Paragraph>
            </RichTextBlock>
            <Button Click="OnSelectAllClick" Content="Select All" />
            <Button Click="OnCopyClick" Content="Copy Selection" />
            <TextBlock
                x:Name="SelectedTextDisplay"
                Foreground="Gray"
                Text="(Selected text will appear here)"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
