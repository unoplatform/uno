<UserControl
    x:Class="Uno.UI.Samples.Content.UITests.RichTextBlockControl.RichTextBlock_Basic"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="Basic RichTextBlock Scenarios" />

            <!--  Simple text  -->
            <RichTextBlock x:Name="SimpleText">
                <Paragraph>
                    <Run Text="Hello, this is a simple RichTextBlock with a single paragraph." />
                </Paragraph>
            </RichTextBlock>

            <!--  Multiple paragraphs  -->
            <RichTextBlock x:Name="MultipleParagraphs">
                <Paragraph>
                    <Run Text="First paragraph. This demonstrates multiple paragraphs in a RichTextBlock." />
                </Paragraph>
                <Paragraph>
                    <Run Text="Second paragraph. Each paragraph starts on a new line." />
                </Paragraph>
                <Paragraph>
                    <Run Text="Third paragraph. This is the final paragraph in this block." />
                </Paragraph>
            </RichTextBlock>

            <!--  Inline formatting  -->
            <RichTextBlock x:Name="InlineFormatting">
                <Paragraph>
                    <Run Text="Normal text, " />
                    <Bold>bold text</Bold>
                    <Run Text=", " />
                    <Italic>italic text</Italic>
                    <Run Text=", " />
                    <Underline>underlined text</Underline>
                    <Run Text=", and " />
                    <Bold>
                        <Italic>bold italic text</Italic>
                    </Bold>
                    <Run Text="." />
                </Paragraph>
            </RichTextBlock>

            <!--  Mixed font sizes  -->
            <RichTextBlock x:Name="MixedFontSizes">
                <Paragraph>
                    <Run FontSize="10" Text="Small " />
                    <Run FontSize="16" Text="Medium " />
                    <Run FontSize="24" Text="Large " />
                    <Run FontSize="32" Text="Extra Large" />
                </Paragraph>
            </RichTextBlock>

            <!--  Line break  -->
            <RichTextBlock x:Name="LineBreaks">
                <Paragraph>
                    <Run Text="Line one" />
                    <LineBreak />
                    <Run Text="Line two (after LineBreak)" />
                    <LineBreak />
                    <Run Text="Line three (after another LineBreak)" />
                </Paragraph>
            </RichTextBlock>

            <!--  Colored text  -->
            <RichTextBlock x:Name="ColoredText">
                <Paragraph>
                    <Run Foreground="Red" Text="Red " />
                    <Run Foreground="Green" Text="Green " />
                    <Run Foreground="Blue" Text="Blue " />
                    <Run Foreground="Orange" Text="Orange " />
                    <Run Foreground="Purple" Text="Purple" />
                </Paragraph>
            </RichTextBlock>

            <!--  Empty RichTextBlock  -->
            <Border
                MinHeight="20"
                BorderBrush="Gray"
                BorderThickness="1">
                <RichTextBlock x:Name="EmptyBlock" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
