<Page
    x:Class="Uno.UI.Samples.Content.UITests.RichEditBoxControl.RichEditBox_AllFeatures"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1100"
            Padding="16"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="RichEditBox all-features playground" />
            <TextBlock
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Text="Select text in the editor, use the toolbars, edit or round-trip RTF, exercise clipboard and undo, load MathML, and watch the event log. The 20k stress document probes the bounded rich-layout path."
                TextWrapping="Wrap" />

            <CommandBar
                DefaultLabelPosition="Right"
                IsOpen="True"
                IsSticky="True">
                <AppBarButton Click="OnResetClick" Label="Reset sample" />
                <AppBarButton Click="OnUndoClick" Label="Undo" />
                <AppBarButton Click="OnRedoClick" Label="Redo" />
                <AppBarSeparator />
                <AppBarButton Click="OnBoldClick" Label="Bold" />
                <AppBarButton Click="OnItalicClick" Label="Italic" />
                <AppBarButton Click="OnUnderlineClick" Label="Underline" />
                <AppBarButton Click="OnStrikeClick" Label="Strike" />
                <AppBarButton Click="OnFontIncreaseClick" Label="A+" />
                <AppBarButton Click="OnFontDecreaseClick" Label="A−" />
            </CommandBar>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnRedClick" Content="Red text" />
                <Button Click="OnBlueClick" Content="Blue text" />
                <Button Click="OnYellowHighlightClick" Content="Yellow highlight" />
                <Button Click="OnLeftClick" Content="Align left" />
                <Button Click="OnCenterClick" Content="Center" />
                <Button Click="OnRightClick" Content="Align right" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnBulletClick" Content="Bullets" />
                <Button Click="OnNumberClick" Content="Numbering" />
                <Button Click="OnIndentClick" Content="Indent" />
                <Button Click="OnCopyClick" Content="Copy" />
                <Button Click="OnCutClick" Content="Cut" />
                <Button Click="OnPasteClick" Content="Paste" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnAddLinkClick" Content="Add Uno Platform link" />
                <Button Click="OnInsertImageClick" Content="Insert image" />
                <Button Click="OnLoadStressClick" Content="Load 20k stress document" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnSelectAllClick" Content="Select all" />
                <Button Click="OnCaretToEndClick" Content="Move caret to end" />
                <Button Click="OnSelectFormattingClick" Content="Select formatting word" />
                <Button Click="OnJumpRtfClick" Content="Go to RTF" />
                <Button Click="OnJumpMathClick" Content="Go to MathML" />
                <Button Click="OnJumpEventsClick" Content="Go to event log" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RichEditBox
                    x:Name="Editor"
                    Height="330"
                    MinWidth="520"
                    AcceptsReturn="True"
                    Header="Rich document"
                    IsSpellCheckEnabled="True"
                    PlaceholderText="Type, paste, select, format, drag, and use keyboard shortcuts here…"
                    SelectionHighlightColorWhenNotFocused="{ThemeResource TextControlSelectionHighlightColor}"
                    TextWrapping="Wrap" />

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Input and document options" />
                    <TextBlock
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="Read-only and wrapping are immediately visible. Spell checking uses squiggles; color fonts affect emoji. Prediction and software-keyboard suppression require platform IME support."
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="ReadOnlyToggle"
                        Header="Read-only"
                        Toggled="OnOptionsChanged" />
                    <ToggleSwitch
                        x:Name="SpellCheckToggle"
                        Header="Spell checking"
                        IsOn="True"
                        Toggled="OnOptionsChanged" />
                    <ToggleSwitch
                        x:Name="PredictionToggle"
                        Header="Text prediction"
                        IsOn="True"
                        Toggled="OnOptionsChanged" />
                    <ToggleSwitch
                        x:Name="ColorFontToggle"
                        Header="Color fonts"
                        IsOn="True"
                        Toggled="OnOptionsChanged" />
                    <ToggleSwitch
                        x:Name="WrapToggle"
                        Header="Wrap text"
                        IsOn="True"
                        Toggled="OnOptionsChanged" />
                    <ToggleSwitch
                        x:Name="SuppressKeyboardToggle"
                        Header="Suppress software keyboard on programmatic focus"
                        Toggled="OnOptionsChanged" />
                    <ComboBox
                        x:Name="CopyFormatBox"
                        Header="Clipboard copy format"
                        SelectedIndex="0"
                        SelectionChanged="OnCopyFormatChanged">
                        <ComboBoxItem Content="All formats" />
                        <ComboBoxItem Content="Plain text only" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            x:Name="FindBox"
                            Width="180"
                            Header="Find text"
                            Text="formatting" />
                        <Button
                            VerticalAlignment="Bottom"
                            Click="OnFindClick"
                            Content="Find" />
                    </StackPanel>
                    <TextBlock
                        x:Name="Status"
                        FontFamily="Consolas"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="RTF round-trip" />
                    <TextBox
                        x:Name="RtfBox"
                        Height="190"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        Header="RTF payload"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnExportRtfClick" Content="Export RTF" />
                        <Button Click="OnImportRtfClick" Content="Import RTF" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="MathML" />
                    <TextBlock
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="Malformed XML follows native RichEdit behavior: it clears the math document and can be undone. Well-formed but invalid MathML is rejected atomically."
                        TextWrapping="Wrap" />
                    <RichEditBox
                        x:Name="MathEditor"
                        Height="110"
                        Header="Math-only RichEditBox" />
                    <TextBox
                        x:Name="MathMlBox"
                        Height="110"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        Header="MathML payload"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnLoadMathClick" Content="Load MathML" />
                        <Button Click="OnExtractMathClick" Content="Extract MathML" />
                        <Button Click="OnUndoMathClick" Content="Undo MathML" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBox
                x:Name="EventLog"
                Height="150"
                AcceptsReturn="True"
                FontFamily="Consolas"
                Header="Recent RichEditBox events"
                IsReadOnly="True"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
