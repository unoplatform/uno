<Page
    x:Class="Uno.UI.Samples.Content.UITests.RichEditBoxControl.RichEditBox_UIAutomation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <StackPanel
        MaxWidth="520"
        Padding="16"
        HorizontalAlignment="Left"
        Spacing="8">
        <TextBlock Text="External UI Automation fixture for RichEditBox TextEdit, links, images, ranges, and edit invalidation." TextWrapping="Wrap" />
        <RichEditBox
            x:Name="Editor"
            Height="80"
            AutomationProperties.AutomationId="RichEditBoxUiaFixture"
            ContextMenuOpening="OnContextMenuOpening"
            Header="UI Automation document" />
        <RichEditBox
            x:Name="StructureEditor"
            Height="48"
            AutomationProperties.AutomationId="RichEditBoxUiaStructureFixture"
            Header="Structure event document" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaUpdateComposition"
                Click="OnUpdateComposition"
                Content="Update composition" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaCompleteComposition"
                Click="OnCompleteComposition"
                Content="Complete composition" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaInsertPrefix"
                Click="OnInsertPrefix"
                Content="Insert prefix" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaInsertMiddle"
                Click="OnInsertMiddle"
                Content="Insert middle" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaDeleteMiddle"
                Click="OnDeleteMiddle"
                Content="Delete middle" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaUndo"
                Click="OnUndo"
                Content="Undo" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaRemoveFirstDuplicateLink"
                Click="OnRemoveFirstDuplicateLink"
                Content="Remove first duplicate link" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaAddStructureLink"
                Click="OnAddStructureLink"
                Content="Add structure link" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaRenameStructureLink"
                Click="OnRenameStructureLink"
                Content="Rename structure link" />
            <Button
                AutomationProperties.AutomationId="RichEditBoxUiaExpandStructurePrefix"
                Click="OnExpandStructurePrefix"
                Content="Expand structure prefix" />
        </StackPanel>
        <TextBlock
            x:Name="Status"
            AutomationProperties.AutomationId="RichEditBoxUiaStatus"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
