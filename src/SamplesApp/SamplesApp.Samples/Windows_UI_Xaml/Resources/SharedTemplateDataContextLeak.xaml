<UserControl
    x:Class="UITests.Shared.Windows_UI_Xaml.Resources.SharedTemplateDataContextLeak"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UITests.Shared.Windows_UI_Xaml.Resources"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="LeakSharedTemplate">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
        <Style x:Key="LeakSharedStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="10" />
        </Style>
        <Style x:Key="LeakHolderStyle" TargetType="local:LeakTemplateHolder">
            <Setter Property="ItemTemplate" Value="{StaticResource LeakSharedTemplate}" />
            <Setter Property="ItemStyle" Value="{StaticResource LeakSharedStyle}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Padding="20" Spacing="8">
        <TextBlock TextWrapping="Wrap">
            A DataTemplate and a Style from Resources are assigned (via a Style Setter + StaticResource) to plain custom dependency properties of a control.
            Each run creates the control with a 10 MB view model, loads it, removes it, and forces GCs.
            Expected: template/style DataContext is null and the view model and control are collected.
            Without the fix, the shared DataTemplate and Style keep the last view model (and the Style keeps the control) alive.
        </TextBlock>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="RunButton"
                Click="OnRun"
                Content="Run" />
        </StackPanel>
        <TextBlock
            x:Name="StatusText"
            FontFamily="Consolas"
            TextWrapping="Wrap" />
        <Grid
            x:Name="Host"
            Height="40"
            HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
