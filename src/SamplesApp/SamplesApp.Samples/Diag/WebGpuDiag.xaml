<Page x:Class="UITests.Shared.Diag.WebGpuDiag"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Canvas Width="700"
	        Height="500"
	        Background="White">
		<!-- (20,20) red anchor -->
		<Rectangle Canvas.Left="20"
		           Canvas.Top="20"
		           Width="120"
		           Height="80"
		           Fill="Red" />
		<!-- (20,120) plain text -->
		<TextBlock Canvas.Left="20"
		           Canvas.Top="120"
		           FontSize="24"
		           Foreground="Black"
		           Text="TEXT 20,120" />
		<!-- (20,170) rounded border with thick stroke -->
		<Border Canvas.Left="20"
		        Canvas.Top="170"
		        Width="160"
		        Height="90"
		        Background="LightGreen"
		        BorderBrush="Black"
		        BorderThickness="6"
		        CornerRadius="20" />
		<!-- (220,20) linear gradient -->
		<Rectangle Canvas.Left="220"
		           Canvas.Top="20"
		           Width="160"
		           Height="120">
			<Rectangle.Fill>
				<LinearGradientBrush StartPoint="0,0"
				                     EndPoint="1,1">
					<GradientStop Offset="0"
					              Color="Red" />
					<GradientStop Offset="1"
					              Color="Blue" />
				</LinearGradientBrush>
			</Rectangle.Fill>
		</Rectangle>
		<!-- (220,170) radial gradient -->
		<Ellipse Canvas.Left="220"
		         Canvas.Top="170"
		         Width="160"
		         Height="120">
			<Ellipse.Fill>
				<RadialGradientBrush Center="0.5,0.5"
				                     GradientOrigin="0.25,0.3"
				                     RadiusX="0.5"
				                     RadiusY="0.5">
					<GradientStop Offset="0"
					              Color="Yellow" />
					<GradientStop Offset="1"
					              Color="Purple" />
				</RadialGradientBrush>
			</Ellipse.Fill>
		</Ellipse>
		<!-- (420,20) colored text -->
		<TextBlock Canvas.Left="420"
		           Canvas.Top="20"
		           FontSize="20"
		           Foreground="DarkBlue"
		           Text="Lorem ipsum dolor" />
	</Canvas>
</Page>
