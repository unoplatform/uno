<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<ItemGroup>
		<Page Remove="$(MSBuildThisFileDirectory)Msal\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Msal\**" />

		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Media\RevealBrushes\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Media\RevealBrushes\**" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Media\RevealBrushes\**"
		      Link="Microsoft\UI\Xaml\Media\RevealBrushes\%(RecursiveDir)%(Filename)%(Extension)" />

		<Page Remove="$(MSBuildThisFileDirectory)Windows\Phone\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Windows\Phone\**" />
		<None Include="$(MSBuildThisFileDirectory)Windows\Phone\**"
		      Link="Windows\Phone\%(RecursiveDir)%(Filename)%(Extension)" />

		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\Repeater\FlowLayout_Simple.xaml" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\Repeater\FlowLayout_Simple.xaml.cs" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\Repeater\FlowLayout_Simple.xaml"
		      Link="Microsoft\UI\Xaml\Controls\Repeater\FlowLayout_Simple.xaml" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\Repeater\FlowLayout_Simple.xaml.cs"
		      Link="Microsoft\UI\Xaml\Controls\Repeater\FlowLayout_Simple.xaml.cs" />

		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\PagerControlTests\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\PagerControlTests\**" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\PagerControlTests\**"
		      Link="Microsoft\UI\Xaml\Controls\PagerControlTests\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseWinUI)'=='true'">
		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\WebView\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\WebView\**" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\WebView\**"
		      Link="Microsoft\UI\Xaml\Controls\WebView\%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Some samples rely on internal types -->
		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\ScrollViewTests\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\ScrollViewTests\**" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\ScrollViewTests\**"
		      Link="Microsoft\UI\Xaml\Controls\ScrollViewTests\%(RecursiveDir)%(Filename)%(Extension)" />
		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\ItemsViewTests\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\ItemsViewTests\**" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\ItemsViewTests\**"
		      Link="Microsoft\UI\Xaml\Controls\ItemsViewTests\%(RecursiveDir)%(Filename)%(Extension)" />
		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\SelectorBarTests\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\SelectorBarTests\**" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\SelectorBarTests\**"
		      Link="Microsoft\UI\Xaml\Controls\SelectorBarTests\%(RecursiveDir)%(Filename)%(Extension)" />

		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\WebView2Tests\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\WebView2Tests\**" />
		<None Include="$(MSBuildThisFileDirectory)Microsoft\UI\Xaml\Controls\WebView2Tests\**"
		      Link="Microsoft\UI\Xaml\Controls\WebView2Tests\%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- AppTaskInfo is experimental and is not projected by Microsoft.Windows.SDK.NET.Ref. -->
		<Page Remove="$(MSBuildThisFileDirectory)Windows\UI\Shell\**" />
		<Compile Remove="$(MSBuildThisFileDirectory)Windows\UI\Shell\**" />
		<None Include="$(MSBuildThisFileDirectory)Windows\UI\Shell\**"
		      Link="Windows\UI\Shell\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<!-- SkiaSharp-free build: SKCanvasElement exposes raw SKCanvas (Uno.WinUI.Graphics2DSK) and cannot be neutral. -->
	<ItemGroup Condition="'$(UnoDrawingBackendSkia)'=='false'">
		<Page Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Composition\SKCanvasElement_Simple.xaml" />
		<Compile Remove="$(MSBuildThisFileDirectory)Microsoft\UI\Composition\SKCanvasElement_Simple.xaml.cs" />
	</ItemGroup>
</Project>
