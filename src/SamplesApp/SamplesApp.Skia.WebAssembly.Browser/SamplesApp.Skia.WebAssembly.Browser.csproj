<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<TargetFrameworks>$(NetCurrent)</TargetFrameworks>
	</PropertyGroup>

	<Import Project="../../targetframework-override-noplatform.props" />

	<!-- Drawing-backend build flags (see SamplesApp.Skia.Generic). Default both on = Skia. A SkiaSharp-free build
	     passes -p:UnoDrawingBackendSkia=false (with -p:UnoWebGpuWasm=true so Dawn is linked); DrawingBackendConfiguration
	     then registers the WebGPU renderer over the managed seams. The DefineConstants gate the shared config. -->
	<!-- Head-scoped AOT switch: passing RunAOTCompilation/PublishTrimmed globally breaks the
	     netstandard2.0 generator projects in the graph. -->
	<PropertyGroup Condition="'$(UnoWasmAot)'=='true'">
		<RunAOTCompilation>true</RunAOTCompilation>
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>
	<ItemGroup Condition="'$(UnoWasmAot)'=='true'">
		<!-- The Mono AOT cross-compiler runs out of memory on these giant assemblies. None are on the
		     render path (samples/test infra) — the perf-critical Uno.UI/Composition assemblies stay AOT'd. -->
		<_AOT_InternalForceInterpretAssemblies Include="aot-skip\Microsoft.Graph.dll" />
		<_AOT_InternalForceInterpretAssemblies Include="aot-skip\SamplesApp.Skia.dll" />
		<_AOT_InternalForceInterpretAssemblies Include="aot-skip\Uno.UI.RuntimeTests.dll" />
	</ItemGroup>

	<PropertyGroup>
		<UnoDrawingBackendSkia Condition="'$(UnoDrawingBackendSkia)'==''">true</UnoDrawingBackendSkia>
		<UnoDrawingBackendWebGpu Condition="'$(UnoDrawingBackendWebGpu)'==''">true</UnoDrawingBackendWebGpu>
		<DefineConstants Condition="'$(UnoDrawingBackendSkia)'=='true'">$(DefineConstants);UNO_DRAWING_SKIA</DefineConstants>
		<DefineConstants Condition="'$(UnoDrawingBackendWebGpu)'=='true'">$(DefineConstants);UNO_DRAWING_WEBGPU</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(TargetFramework)</TargetFramework>
		<!-- Required for net9 workloads -->
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<NoWarn>$(NoWarn);NU1903;NU1902</NoWarn>
		
		<!-- To remove when all warnings have been fixed -->
		<NoWarn>$(NoWarn);IL2026;IL2072;IL2067;IL2075;IL2070;IL2077;IL2057;IL2045;IL2111;IL2062;IL2104;IL2080;IL2065;IL2090;IL2007;IL2122</NoWarn>

		<!--
		IL Linking is disabled in Debug configuration.
		When building in Release, see https://platform.uno/docs/articles/features/using-il-linker-webassembly.html
		-->
		<PublishTrimmed Condition="'$(UnoWasmAot)'!='true'">false</PublishTrimmed>
		<WasmShellILLinkerEnabled Condition="'$(UnoWasmAot)'!='true'">false</WasmShellILLinkerEnabled>
		
		<PreBuildUnoUITasks>true</PreBuildUnoUITasks>
		
		<WasmIncludeFullIcuData>true</WasmIncludeFullIcuData>
		<InvariantGlobalization>false</InvariantGlobalization>

		<!-- Include all satellite	assemblies -->
		<WasmShellLoadAllSatelliteResources>true</WasmShellLoadAllSatelliteResources>

		<WasmShellEnableIDBFS>true</WasmShellEnableIDBFS>
		<WasmBuildNative>true</WasmBuildNative>

		<!-- Keep full exception strings in release -->
		<UseSystemResourceKeys>false</UseSystemResourceKeys>

		<!-- Attempt workaround for https://github.com/dotnet/aspnetcore/issues/63970 -->
		<WasmFingerprintAssets>false</WasmFingerprintAssets>
	</PropertyGroup>

	<ItemGroup>
		<WasmShellMonoEnvironment Include="MONO_GC_PARAMS" Value="soft-heap-limit=1024m,nursery-size=64m,evacuation-threshold=66,major=marksweep" />
		<!-- Benchmark hooks (see the perf samples): baked in only when the corresponding property is passed. -->
		<WasmShellMonoEnvironment Include="UNO_PERF_BUTTONS" Value="$(UnoPerfButtons)" Condition="'$(UnoPerfButtons)'!=''" />
		<WasmShellMonoEnvironment Include="UNO_LOG_FPS" Value="1" Condition="'$(UnoPerfLogFps)'=='true'" />
		<WasmShellMonoEnvironment Include="UNO_FORCE_FULL_REPAINT" Value="1" Condition="'$(UnoPerfForceFullRepaint)'=='true'" />
		<WasmShellMonoEnvironment Include="UNO_WEBGPU_STATS" Value="1" Condition="'$(UnoPerfWebGpuStats)'=='true'" />
	</ItemGroup>

	<!-- The managed font provider has no system fonts to enumerate on WASM; feed it the app's default face. -->
	<ItemGroup Condition="'$(UnoDrawingBackendSkia)'!='true'">
		<EmbeddedResource Include="$(NuGetPackageRoot)uno.fonts.opensans\2.8.1\lib\net7.0\Uno.Fonts.OpenSans\Fonts\OpenSans-Regular.ttf" Link="EmbeddedFonts\OpenSans-Regular.ttf" LogicalName="SamplesApp.DefaultFont.ttf" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<MonoRuntimeDebuggerEnabled>true</MonoRuntimeDebuggerEnabled>
		<DefineConstants>$(DefineConstants);TRACE;DEBUG</DefineConstants>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>

	</PropertyGroup>
	
	<ItemGroup>
		<EmbeddedResource Include="WasmScripts\AppManifest.js" />
	
		<Content Include="..\LinkedFiles\WebContent\**\*.*">
			<Link>WebContent\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>

		<WasmShellExtraFilesToDeploy Include="..\LinkedFiles\WebContent\**\*.*">
			<TargetPath>WebContent/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
		</WasmShellExtraFilesToDeploy>
	</ItemGroup>

	<!--
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<WasmShellMonoRuntimeExecutionMode>InterpreterAndAOT</WasmShellMonoRuntimeExecutionMode>
		<WasmShellILLinkerEnabled>false</WasmShellILLinkerEnabled>
		<WasmShellEnableEmccProfiling>true</WasmShellEnableEmccProfiling>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<WasmShellEnableAotProfile Include="aot.profile" />
		<WasmShellExtraEmccFlags Include="-s INITIAL_MEMORY=300MB"/>
	</ItemGroup>
	-->
	
	<ItemGroup>
	  <_WebToolingArtifacts Remove="Properties\launchSettings.json" />
	</ItemGroup>
	
	<ItemGroup>
		<LinkerDescriptor Include="LinkerConfig.xml" />
	</ItemGroup>
	
	<ItemGroup>
	  <None Include="Properties\launchSettings.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
		<PackageReference Include="Uno.Wasm.Bootstrap" />
		<PackageReference Include="Microsoft.Windows.Compatibility" />
		<PackageReference Include="Uno.Fonts.Fluent" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="MSTest.Analyzers" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\SourceGenerators\System.Xaml\Uno.Xaml.csproj" />
		<ProjectReference Include="..\..\Uno.Foundation\Uno.Foundation.Wasm.csproj" />
		<ProjectReference Include="..\..\Uno.UI.Runtime.Skia.WebAssembly.Browser\Uno.UI.Runtime.Skia.WebAssembly.Browser.csproj" />
		<!-- App-level WebGPU backend reference (the host no longer provides it); the app registers it in Program.cs. -->
		<ProjectReference Include="..\..\Uno.UI.Composition.Managed\Uno.UI.Composition.Managed.csproj" />
		<!-- Skia backend referenced only when the app opts into it (default); WebGPU backend for the opt-in render path. -->
		<ProjectReference Include="..\..\Uno.UI.Composition.Skia\Uno.UI.Composition.SkiaBackend.csproj" Condition="'$(UnoDrawingBackendSkia)'=='true'" />
		<ProjectReference Include="..\..\Uno.UI.Composition.WebGpu\Uno.UI.Composition.WebGpu.csproj" Condition="'$(UnoDrawingBackendWebGpu)'=='true'" />
		<ProjectReference Include="..\..\Uno.UI\Uno.UI.csproj" />
		<ProjectReference Include="..\..\Uno.UI.Dispatching\Uno.UI.Dispatching.Wasm.csproj" />
		<ProjectReference Include="..\..\Uno.UWP\Uno.Wasm.csproj" />
		<ProjectReference Include="..\SamplesApp.Skia\SamplesApp.Skia.csproj" />
		<Compile Include="..\DrawingBackendConfiguration.cs" Link="DrawingBackendConfiguration.cs" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Program.cs" />
	</ItemGroup>

	<Import Project="..\..\Uno.UI.Runtime.Skia.WebAssembly.Browser\build\*.Runtime.Skia.WebAssembly.Browser.props" />
	<Import Project="..\..\Uno.UI.Runtime.Skia.WebAssembly.Browser\build\*.Runtime.Skia.WebAssembly.Browser.targets" />

	<PropertyGroup>
		<UnoUIMSBuildTasksPath>$(MSBuildThisFileDirectory)..\..\SourceGenerators\Uno.UI.Tasks\bin\$(Configuration)_Shadow</UnoUIMSBuildTasksPath>
	</PropertyGroup>

	<!-- Required for assets to be included (manual only inside the uno solution, commonly included through build inclusion in nuget packages -->
	<Import Project="..\..\SourceGenerators\Uno.UI.Tasks\Content\Uno.UI.Tasks.targets" Condition="'$(SkipUnoResourceGeneration)' == '' " />

	<Import Project="..\..\..\build\nuget\uno.winui.runtime-replace.targets" />

	<Target Name="_ValidatePublishedItems" AfterTargets="Publish">
		<ItemGroup>
			<_validationPath Include="Uno.Fonts.Fluent/Fonts/uno-fluentui-assets.ttf" />
			<_validationPath Include="Uno.UI.RuntimeTests/Assets/Fonts/uno-fluentui-assets-runtimetest01.ttf" />
		</ItemGroup>

		<Error Condition="!exists('$(PublishDir)%(_validationPath.Identity)')" Text="Failed to find published filed: %(_validationPath.Identity)" />
	</Target>
	
	<!-- https://github.com/dotnet/runtime/issues/109289 -->
	<Target Name="Issue109289_Workaround" AfterTargets="_BrowserWasmWriteRspForLinking" Condition=" $(NETCoreSdkVersion.StartsWith('9.0.')) ">
		<ItemGroup>
			<_WasmLinkStepArgs Remove="@(_EmccLinkStepArgs)" />
			<_EmccLinkStepArgs Remove="&quot;%(_WasmNativeFileForLinking.Identity)&quot;" />
			<_WasmLinkDependencies Remove="@(_WasmNativeFileForLinking)" />

			<_SkiaSharpToReorder Include="@(_WasmNativeFileForLinking)" Condition="$([System.String]::Copy('%(FullPath)').Contains('SkiaSharp'))" />
			<_WasmNativeFileForLinking Remove="@(_SkiaSharpToReorder)" />
			<_WasmNativeFileForLinking Include="@(_SkiaSharpToReorder)" />

			<_EmccLinkStepArgs Include="&quot;%(_WasmNativeFileForLinking.Identity)&quot;" />
			<_WasmLinkDependencies Include="@(_WasmNativeFileForLinking)" />
			<_WasmLinkStepArgs Include="@(_EmccLinkStepArgs)" />
		</ItemGroup>
	</Target>

	<!-- The emdawnwebgpu bridge (small: a browser-WebGPU shim, a few hundred KB in the final .wasm) is always linked
	     so the WASM host's direct WebGpuContext reference always resolves — no reflection. Activating the WebGPU render
	     path stays opt-in: -p:UnoWebGpuWasm=true sets UNO_WEBGPU, which Program.cs reads to register the WebGPU backend. -->
	<Import Project="..\..\Uno.UI.Composition.WebGpu.Init\wgpu-wasm.targets" />
	<ItemGroup Condition="'$(UnoWebGpuWasm)' == 'true'">
		<WasmShellMonoEnvironment Include="UNO_WEBGPU" Value="1" />
	</ItemGroup>
</Project>
