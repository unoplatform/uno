<UserControl
    x:Class="Uno.UI.Samples.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Uno.UI.Samples.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    d:DesignHeight="800"
    d:DesignWidth="320"
    mc:Ignorable="d not_win">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/UITests/Views/Styles/Shell/ShellResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="local:ShellSettingsCard">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:ShellSettingsCard">
                            <Border Style="{StaticResource ShellCardStyle}">
                                <Grid RowSpacing="8" Style="{StaticResource ShellSettingsCardStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="20"
                                        Glyph="{TemplateBinding Glyph}"
                                        IsTextScaleFactorEnabled="False" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="DescriptionPart"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{TemplateBinding Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ContentPresenter
                                        x:Name="ContentPart"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  The card header labels the switch, so the On/Off text would only eat the row (ShellSettingsCard drops the minimum width).  -->
            <Style BasedOn="{StaticResource DefaultToggleSwitchStyle}" TargetType="ToggleSwitch">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
            </Style>

            <Style
                x:Key="ShellSettingsGroupHeaderStyle"
                BasedOn="{StaticResource ShellBodyStrongTextStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>

            <Style
                x:Key="ShellAboutLabelStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <Style x:Key="ShellAboutValueStyle" TargetType="TextBlock">
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="ShellSettingsScrollViewer"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <!--  The right inset keeps the cards clear of the scroll bar.  -->
        <StackPanel Padding="0,0,12,16" Spacing="24">

            <!--  APPEARANCE  -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource ShellSettingsGroupHeaderStyle}" Text="Appearance" />
                <local:ShellSettingsCard
                    Description="Applies to the shell and the sample"
                    Glyph="&#xE793;"
                    Header="Theme">
                    <ComboBox
                        x:Name="ShellSettingsThemeComboBox"
                        MinWidth="160"
                        AutomationProperties.AutomationId="ShellSettingsTheme"
                        SelectedIndex="{Binding AppThemeIndex, Mode=TwoWay}">
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </local:ShellSettingsCard>
                <local:ShellSettingsCard
                    Description="Flips the whole shell"
                    Glyph="&#xE9AB;"
                    Header="Right-to-left">
                    <ToggleSwitch
                        x:Name="ShellSettingsRtlToggle"
                        AutomationProperties.AutomationId="ShellSettingsRtl"
                        IsOn="{Binding UseRtl, Mode=TwoWay}" />
                </local:ShellSettingsCard>
                <local:ShellSettingsCard
                    Description="Merges XamlControlsResources"
                    Glyph="&#xE790;"
                    Header="Fluent styles">
                    <ToggleSwitch
                        x:Name="ShellSettingsFluentStylesToggle"
                        AutomationProperties.AutomationId="ShellSettingsFluentStyles"
                        IsOn="{Binding UseFluentStyles, Mode=TwoWay}" />
                </local:ShellSettingsCard>
                <local:ShellSettingsCard
                    x:Name="ShellSettingsTitleBarCard"
                    Description="Draws the shell under the caption"
                    Glyph="&#xE737;"
                    Header="Extend into title bar">
                    <ToggleSwitch
                        x:Name="ShellSettingsTitleBarToggle"
                        AutomationProperties.AutomationId="ShellSettingsExtendTitleBar"
                        IsOn="{Binding ExtendContentIntoTitleBar, Mode=TwoWay}" />
                </local:ShellSettingsCard>
                <local:ShellSettingsCard
                    x:Name="ShellSettingsMicaCard"
                    Description="Lets the desktop tint the chrome"
                    Glyph="&#xE7F4;"
                    Header="Mica backdrop">
                    <ToggleSwitch
                        x:Name="ShellSettingsMicaToggle"
                        AutomationProperties.AutomationId="ShellSettingsMica"
                        IsOn="{Binding UseMicaBackdrop, Mode=TwoWay}" />
                </local:ShellSettingsCard>
            </StackPanel>

            <!--  DIAGNOSTICS  -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource ShellSettingsGroupHeaderStyle}" Text="Diagnostics" />
                <local:ShellSettingsCard
                    Description="Shows the frame rate counter"
                    Glyph="&#xEC4A;"
                    Header="FPS indicator">
                    <ToggleSwitch
                        x:Name="ShellSettingsFpsToggle"
                        AutomationProperties.AutomationId="ShellSettingsFps"
                        IsOn="{Binding ShowFpsIndicator, Mode=TwoWay}" />
                </local:ShellSettingsCard>
                <not_win:StackPanel Spacing="4">
                    <local:ShellSettingsCard
                        Description="Outlines redrawn areas"
                        Glyph="&#xE81E;"
                        Header="Damage region">
                        <ToggleSwitch
                            x:Name="ShellSettingsDamageRegionToggle"
                            AutomationProperties.AutomationId="ShellSettingsDamageRegion"
                            IsOn="{Binding DamageRegionOverlay, Mode=TwoWay}" />
                    </local:ShellSettingsCard>
                    <local:ShellSettingsCard
                        Description="Reports the mouse as touch"
                        Glyph="&#xE815;"
                        Header="Simulate touch">
                        <ToggleSwitch
                            x:Name="ShellSettingsSimulateTouchToggle"
                            AutomationProperties.AutomationId="ShellSettingsSimulateTouch"
                            IsOn="{Binding SimulateTouch, Mode=TwoWay}" />
                    </local:ShellSettingsCard>
                    <local:ShellSettingsCard
                        Description="Survive a paused debugger"
                        Glyph="&#xE92F;"
                        Header="Keep popups open">
                        <ToggleSwitch
                            x:Name="ShellSettingsKeepPopupsToggle"
                            AutomationProperties.AutomationId="ShellSettingsKeepPopups"
                            IsOn="{Binding PreventLightDismissOnWindowDeactivated, Mode=TwoWay}" />
                    </local:ShellSettingsCard>
                </not_win:StackPanel>
                <local:ShellSettingsCard
                    x:Name="ShellSettingsLogViewDumpCard"
                    Description="Writes the visual tree of the sample to the log"
                    Glyph="&#xEBE8;"
                    Header="Log view dump">
                    <Button
                        x:Name="ShellSettingsLogViewDumpButton"
                        AutomationProperties.AutomationId="ShellSettingsLogViewDump"
                        AutomationProperties.Name="Log view dump"
                        Command="{Binding LogViewDumpCommand}"
                        Content="Dump" />
                </local:ShellSettingsCard>
            </StackPanel>

            <!--  SAMPLE BROWSER  -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource ShellSettingsGroupHeaderStyle}" Text="Sample browser" />
                <local:ShellSettingsCard
                    Description="Hides automated samples"
                    Glyph="&#xE71C;"
                    Header="Manual tests only">
                    <ToggleSwitch
                        x:Name="ShellSettingsManualTestsToggle"
                        AutomationProperties.AutomationId="ShellSettingsManualTests"
                        IsOn="{Binding ManualTestsOnly, Mode=TwoWay}" />
                </local:ShellSettingsCard>
                <local:ShellSettingsCard
                    Description="When started without a link"
                    Glyph="&#xE7E8;"
                    Header="On startup, open">
                    <ComboBox
                        x:Name="ShellSettingsStartupPageComboBox"
                        MinWidth="160"
                        AutomationProperties.AutomationId="ShellSettingsStartupPage"
                        SelectedIndex="{Binding StartupPageIndex, Mode=TwoWay}">
                        <x:String>Home</x:String>
                        <x:String>Playground</x:String>
                        <x:String>Last sample</x:String>
                    </ComboBox>
                </local:ShellSettingsCard>
                <local:ShellSettingsCard
                    Description="Removes every saved sample"
                    Glyph="&#xE734;"
                    Header="Clear favorites">
                    <Button
                        x:Name="ShellSettingsClearFavoritesButton"
                        AutomationProperties.AutomationId="ShellSettingsClearFavorites"
                        AutomationProperties.Name="Clear favorites"
                        Content="Clear">
                        <Button.Flyout>
                            <Flyout x:Name="ShellSettingsClearFavoritesFlyout">
                                <StackPanel MaxWidth="240" Spacing="12">
                                    <TextBlock Text="Remove all favorites?" TextWrapping="Wrap" />
                                    <Button
                                        AutomationProperties.AutomationId="ShellSettingsClearFavoritesConfirm"
                                        Click="ClearFavoritesConfirm_Click"
                                        Content="Clear favorites" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </local:ShellSettingsCard>
                <local:ShellSettingsCard
                    Description="Forgets the recently opened samples"
                    Glyph="&#xE81C;"
                    Header="Clear history">
                    <Button
                        x:Name="ShellSettingsClearHistoryButton"
                        AutomationProperties.AutomationId="ShellSettingsClearHistory"
                        AutomationProperties.Name="Clear history"
                        Content="Clear">
                        <Button.Flyout>
                            <Flyout x:Name="ShellSettingsClearHistoryFlyout">
                                <StackPanel MaxWidth="240" Spacing="12">
                                    <TextBlock Text="Clear the recent samples list?" TextWrapping="Wrap" />
                                    <Button
                                        AutomationProperties.AutomationId="ShellSettingsClearHistoryConfirm"
                                        Click="ClearHistoryConfirm_Click"
                                        Content="Clear history" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </local:ShellSettingsCard>
                <local:ShellSettingsCard
                    x:Name="ShellSettingsRecordCard"
                    Description="Opens every sample and saves a screenshot of each"
                    Glyph="&#xE722;"
                    Header="Record all screenshots">
                    <Button
                        x:Name="ShellSettingsRecordButton"
                        AutomationProperties.AutomationId="ShellSettingsRecordScreenshots"
                        AutomationProperties.Name="Record all screenshots"
                        Content="Record">
                        <Button.Flyout>
                            <Flyout x:Name="ShellSettingsRecordFlyout">
                                <StackPanel MaxWidth="240" Spacing="12">
                                    <TextBlock Text="This walks through every sample and takes a while. The shell stays hidden until it ends." TextWrapping="Wrap" />
                                    <Button
                                        AutomationProperties.AutomationId="ShellSettingsRecordConfirm"
                                        Click="RecordConfirm_Click"
                                        Content="Start recording"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </local:ShellSettingsCard>
            </StackPanel>

            <!--  ABOUT  -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource ShellSettingsGroupHeaderStyle}" Text="About" />
                <Border Style="{StaticResource ShellCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid
                            x:Name="ShellAboutGrid"
                            ColumnSpacing="12"
                            RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource ShellAboutLabelStyle}" Text="Platform" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource ShellAboutValueStyle}"
                                Text="{Binding AppInfo.Platform}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource ShellAboutLabelStyle}"
                                Text="Framework" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource ShellAboutValueStyle}"
                                Text="{Binding AppInfo.TargetFramework}" />
                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource ShellAboutLabelStyle}"
                                Text="Configuration" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource ShellAboutValueStyle}"
                                Text="{Binding AppInfo.Configuration}" />
                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource ShellAboutLabelStyle}"
                                Text="Runtime" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource ShellAboutValueStyle}"
                                Text="{Binding AppInfo.Runtime}" />
                            <TextBlock
                                Grid.Row="4"
                                Style="{StaticResource ShellAboutLabelStyle}"
                                Text="{Binding AppInfo.UIFramework}" />
                            <TextBlock
                                x:Name="ShellAboutUIFrameworkVersion"
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource ShellAboutValueStyle}"
                                Text="{Binding AppInfo.UIFrameworkVersionShort}" />
                            <TextBlock
                                Grid.Row="5"
                                Style="{StaticResource ShellAboutLabelStyle}"
                                Text="OS" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource ShellAboutValueStyle}"
                                Text="{Binding AppInfo.OperatingSystem}" />
                            <TextBlock
                                Grid.Row="6"
                                Style="{StaticResource ShellAboutLabelStyle}"
                                Text="Repository" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Style="{StaticResource ShellMonospaceTextStyle}"
                                Text="{Binding AppInfo.RepositoryDisplay}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Button
                            x:Name="ShellCopyDiagnosticsButton"
                            AutomationProperties.AutomationId="ShellCopyDiagnosticsButton"
                            Click="CopyDiagnostics_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="ShellCopyDiagnosticsIcon"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xE8C8;"
                                    IsTextScaleFactorEnabled="False" />
                                <TextBlock x:Name="ShellCopyDiagnosticsText" Text="Copy diagnostics" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
