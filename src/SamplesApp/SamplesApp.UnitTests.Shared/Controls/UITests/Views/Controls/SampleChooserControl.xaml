<UserControl
    x:Class="Uno.UI.Samples.Controls.SampleChooserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:SampleControl.Entities"
    xmlns:helper="using:Uno.UI.Samples.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:shell="using:Uno.UI.Samples.Helper"
    xmlns:u="using:Uno.UI.Samples.Controls"
    xmlns:ub="using:Uno.UI.Samples.Behaviors"
    xmlns:uub="using:Uno.UI.Behaviors"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d not_win">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/UITests/Views/Styles/Application/_Application.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/UITests/Views/Styles/Controls/_Controls.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/UITests/Views/Styles/SampleControl.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/UITests/Views/Styles/Shell/ShellResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Stock item padding is 12; the rows add 4 to land on the 16 px text inset.  -->
            <DataTemplate x:Key="ShellSampleRowTemplate" x:DataType="entities:SampleChooserContent">
                <Grid
                    MinHeight="{StaticResource ShellRowMinHeight}"
                    Margin="4,0,0,0"
                    AutomationProperties.Name="{x:Bind shell:ShellFunctions.RowName(ControlName, IsFavorite, IsManualTest), Mode=OneWay}"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Uno's ListViewItem has no selection pill yet; WinUI draws its own (the helper keeps this one collapsed there).  -->
                    <Border
                        Grid.ColumnSpan="3"
                        Width="3"
                        Height="16"
                        Margin="-12,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        shell:ShellSelectionIndicator.IsEnabled="True"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="1.5" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ControlName}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource ShellTagStyle}"
                        Visibility="{x:Bind shell:ShellFunctions.Visible(IsManualTest)}">
                        <TextBlock Style="{StaticResource ShellTagTextStyle}" Text="Manual" />
                    </Border>
                    <FontIcon
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE735;"
                        IsTextScaleFactorEnabled="False"
                        Visibility="{x:Bind shell:ShellFunctions.Visible(IsFavorite), Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ShellCategoryRowTemplate" x:DataType="entities:SampleChooserCategory">
                <Grid
                    MinHeight="{StaticResource ShellRowMinHeight}"
                    Margin="4,0,0,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Uno's ListViewItem has no selection pill yet; WinUI draws its own (the helper keeps this one collapsed there).  -->
                    <Border
                        Grid.ColumnSpan="3"
                        Width="3"
                        Height="16"
                        Margin="-12,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        shell:ShellSelectionIndicator.IsEnabled="True"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="1.5" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Category}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding Count}" />
                    <FontIcon
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76C;"
                        IsTextScaleFactorEnabled="False" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ShellSuggestionTemplate" x:DataType="entities:SampleChooserContent">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ControlName}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        Grid.Column="1"
                        MaxWidth="120"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind CategoriesString}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <FontIcon
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE735;"
                        IsTextScaleFactorEnabled="False"
                        Visibility="{x:Bind shell:ShellFunctions.Visible(IsFavorite), Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <!--  Three columns like ShellSuggestionTemplate, so the keycap ends where the category captions end.  -->
            <DataTemplate x:Key="ShellSeeAllSuggestionTemplate" x:DataType="shell:SearchSeeAllItem">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind Text}" />
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource ShellKeycapStyle}"
                        Visibility="{x:Bind shell:ShellFunctions.Visible(HasShortcut)}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Shortcut}" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ShellSearchHeaderTemplate" x:DataType="shell:SearchResultsHeader">
                <TextBlock
                    Margin="4,8,0,0"
                    AutomationProperties.HeadingLevel="Level2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Title}" />
            </DataTemplate>

            <shell:ShellTemplateSelector
                x:Key="ShellSuggestionTemplateSelector"
                ItemTemplate="{StaticResource ShellSuggestionTemplate}"
                SeeAllTemplate="{StaticResource ShellSeeAllSuggestionTemplate}" />

            <shell:ShellTemplateSelector
                x:Key="ShellSearchResultsTemplateSelector"
                HeaderTemplate="{StaticResource ShellSearchHeaderTemplate}"
                ItemTemplate="{StaticResource ShellSampleRowTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="ShellRoot"
        uub:VisibleBoundsPadding.PaddingMask="All"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        SizeChanged="ShellRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  The rail is a sibling of the content, not its host: a NavigationView ancestor would adopt the samples' own NavigationViewItems.  -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ShellRailColumn" Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="ShellTitleBarSpacer"
            Grid.ColumnSpan="2"
            Height="{x:Bind ViewModel.TitleBarVisualHeight, Mode=OneWay, FallbackValue=0}" />

        <NavigationView
            x:Name="ShellRail"
            Grid.Row="1"
            AutomationProperties.AutomationId="ShellRail"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="ShellRail_ItemInvoked"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellRail_SelectionChanged">
            <NavigationView.Resources>
                <!--  The rail sits on the page background; the host layer below draws its own edge.  -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="ShellRailHome"
                    AutomationProperties.AutomationId="ShellRailHome"
                    Content="Home"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ShellRailSamples"
                    AutomationProperties.AutomationId="ShellRailSamples"
                    Content="Samples"
                    Tag="Samples">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ShellRailRuntimeTests"
                    AutomationProperties.AutomationId="ShellRailRuntimeTests"
                    Content="Runtime tests"
                    Tag="RuntimeTests">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ShellRailBenchmarks"
                    AutomationProperties.AutomationId="ShellRailBenchmarks"
                    Content="Benchmarks"
                    Tag="Benchmarks"
                    Visibility="{x:Bind shell:ShellFunctions.Visible(ViewModel.HasBenchmarks), FallbackValue=Collapsed}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ShellRailPlayground"
                    AutomationProperties.AutomationId="ShellRailPlayground"
                    Content="Playground"
                    Tag="Playground">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="ShellRailHelp"
                    AutomationProperties.AutomationId="ShellRailHelp"
                    Content="Help"
                    Tag="Help">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

        </NavigationView>

        <Grid
            x:Name="ShellContentRoot"
            Grid.Row="1"
            Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  HEADER  -->
            <Grid
                x:Name="ShellHeader"
                Height="{StaticResource ShellHeaderHeight}"
                Padding="8,0,8,0"
                ColumnSpacing="8">
                <Grid.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="ms-appx:///Controls/UITests/Views/Styles/Shell/ShellToggleResources.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>
                <!--  The command bar needs a bounded column to move commands into overflow; code caps the location instead (UpdateHeaderLocation).  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Local values rather than a Style: an explicit style would drop the implicit Fluent template on Uno.  -->
                <ToggleButton
                    x:Name="ShellBrowserToggle"
                    Width="40"
                    Height="40"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    AutomationProperties.AutomationId="ShellBrowserToggle"
                    AutomationProperties.Name="Sample browser"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                    BorderThickness="0"
                    IsChecked="{x:Bind ViewModel.IsSplitVisible, Mode=TwoWay, FallbackValue=False}"
                    IsEnabled="{x:Bind shell:ShellFunctions.Not(ViewModel.IsRecordAllTests), Mode=OneWay, FallbackValue=True}">
                    <FontIcon
                        x:Name="ShellBrowserToggleIcon"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Glyph="&#xE8A0;"
                        IsTextScaleFactorEnabled="False" />
                </ToggleButton>

                <!--  Location: breadcrumb (hidden while the pane shows its own), then the sample title  -->
                <StackPanel
                    x:Name="ShellLocation"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Code shows the host only when the whole breadcrumb fits; the binding owns the panel's own visibility.  -->
                    <Border x:Name="ShellBreadcrumbHost" VerticalAlignment="Center">
                        <StackPanel
                            x:Name="ShellBreadcrumbPanel"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{x:Bind shell:ShellFunctions.HeaderBreadcrumbVisibility(ViewModel.CurrentBreadcrumb, ViewModel.IsSplitVisible, ViewModel.IsHomeVisible), Mode=OneWay, FallbackValue=Collapsed}">
                            <BreadcrumbBar
                                x:Name="ShellBreadcrumb"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ShellBreadcrumb"
                                ItemClicked="ShellBreadcrumb_ItemClicked"
                                ItemsSource="{x:Bind ViewModel.CurrentBreadcrumb, Mode=OneWay}">
                                <BreadcrumbBar.Resources>
                                    <ResourceDictionary>
                                        <!--  One size for crumbs and title; crumbs stay secondary so the title leads.  -->
                                        <x:Double x:Key="BreadcrumbBarItemThemeFontSize">20</x:Double>
                                        <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <SolidColorBrush x:Key="BreadcrumbBarNormalForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
                                                <SolidColorBrush x:Key="BreadcrumbBarCurrentNormalForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Dark">
                                                <SolidColorBrush x:Key="BreadcrumbBarNormalForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
                                                <SolidColorBrush x:Key="BreadcrumbBarCurrentNormalForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </BreadcrumbBar.Resources>
                            </BreadcrumbBar>
                            <!--  Same glyph, size and gap as the BreadcrumbBar separator (its last item has none).  -->
                            <FontIcon
                                Margin="2,0,3,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE974;"
                                IsTextScaleFactorEnabled="False"
                                MirroredWhenRightToLeft="True" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        x:Name="ShellSampleTitle"
                        MaxWidth="480"
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1"
                        IsTextSelectionEnabled="True"
                        MaxLines="1"
                        Style="{StaticResource ShellHeaderTitleTextStyle}"
                        Text="{x:Bind shell:ShellFunctions.HeaderTitle(ViewModel.CurrentSelectedSample.ControlName, ViewModel.IsHomeVisible), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSelectedSample.ControlName, Mode=OneWay}" />

                    <!--  Code hides the host when the title needs the room; the binding owns the tag's own visibility.  -->
                    <Border x:Name="ShellManualTagHost" VerticalAlignment="Center">
                        <Border
                            x:Name="ShellManualTag"
                            Margin="8,0,0,0"
                            Style="{StaticResource ShellTagStyle}"
                            Visibility="{x:Bind shell:ShellFunctions.ManualTagVisibility(ViewModel.CurrentSelectedSample.IsManualTest, ViewModel.IsHomeVisible), Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock Style="{StaticResource ShellTagTextStyle}" Text="Manual" />
                        </Border>
                    </Border>
                </StackPanel>

                <CommandBar
                    x:Name="ShellCommandBar"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ShellCommandBar"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True"
                    OverflowButtonVisibility="Auto"
                    TabFocusNavigation="Once"
                    Visibility="{x:Bind shell:ShellFunctions.Collapsed(ViewModel.IsHomeVisible), Mode=OneWay}">
                    <AppBarButton
                        x:Name="ShellPreviousSampleButton"
                        Width="40"
                        AutomationProperties.AutomationId="ShellPreviousSampleButton"
                        Command="{x:Bind ViewModel.LoadPreviousTestCommand, Mode=OneWay}"
                        DynamicOverflowOrder="3"
                        Label="Previous sample"
                        LabelPosition="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE892;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="ShellNextSampleButton"
                        Width="40"
                        AutomationProperties.AutomationId="ShellNextSampleButton"
                        Command="{x:Bind ViewModel.LoadNextTestCommand, Mode=OneWay}"
                        DynamicOverflowOrder="3"
                        Label="Next sample"
                        LabelPosition="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE893;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="ShellReloadSampleButton"
                        Width="40"
                        AutomationProperties.AutomationId="ShellReloadSampleButton"
                        Command="{x:Bind ViewModel.ReloadCurrentTestCommand, Mode=OneWay}"
                        Label="Reload sample"
                        LabelPosition="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator x:Name="ShellSampleCommandsSeparator" />
                    <AppBarToggleButton
                        x:Name="ShellFavoriteToggle"
                        AutomationProperties.AutomationId="ShellFavoriteToggle"
                        AutomationProperties.Name="{x:Bind shell:ShellFunctions.FavoriteLabel(ViewModel.IsFavoritedSample), Mode=OneWay}"
                        DynamicOverflowOrder="1"
                        IsChecked="{x:Bind ViewModel.IsFavoritedSample, Mode=TwoWay, FallbackValue=False}"
                        Label="Favorite">
                        <AppBarToggleButton.Icon>
                            <FontIcon
                                x:Name="ShellFavoriteIcon"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Glyph="{x:Bind shell:ShellFunctions.FavoriteGlyph(ViewModel.IsFavoritedSample), Mode=OneWay}" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarButton
                        x:Name="InfoButton"
                        AutomationProperties.AutomationId="ShellInfoButton"
                        DynamicOverflowOrder="2"
                        Label="Info">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout Opening="InfoFlyout_Opening" Placement="BottomEdgeAlignedRight">
                                <u:SampleInfoControl x:Name="SampleInfoFlyoutContent" DataContext="{x:Null}" />
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton
                        x:Name="OverflowSettingsButton"
                        Width="40"
                        AutomationProperties.AutomationId="ShellQuickSettingsButton"
                        AutomationProperties.Name="Quick settings"
                        Click="OverflowSettingsButton_Click"
                        Label="Quick settings"
                        LabelPosition="Collapsed"
                        ToolTipService.ToolTip="Quick settings">
                        <AppBarButton.Icon>
                            <!--  No Source: the fallback draws the sliders glyph, so the gear stays unique to All settings.  -->
                            <controls:AnimatedIcon x:Name="OverflowSettingsIcon">
                                <controls:AnimatedIcon.FallbackIconSource>
                                    <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9E9;" />
                                </controls:AnimatedIcon.FallbackIconSource>
                            </controls:AnimatedIcon>
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout
                                x:Name="ShellQuickSettingsFlyout"
                                Opening="ShellQuickSettingsFlyout_Opening"
                                Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutSubItem
                                    x:Name="ThemeMenuFlyout"
                                    AutomationProperties.AutomationId="ShellQuickTheme"
                                    Text="Theme">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE793;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <RadioMenuFlyoutItem
                                        GroupName="AppTheme"
                                        IsChecked="{Binding IsAppThemeSystem, Mode=TwoWay}"
                                        Tag="Auto"
                                        Text="System" />
                                    <RadioMenuFlyoutItem
                                        GroupName="AppTheme"
                                        IsChecked="{Binding IsAppThemeLight, Mode=TwoWay}"
                                        Tag="Light"
                                        Text="Light" />
                                    <RadioMenuFlyoutItem
                                        GroupName="AppTheme"
                                        IsChecked="{Binding IsAppThemeDark, Mode=TwoWay}"
                                        Tag="Dark"
                                        Text="Dark" />
                                </MenuFlyoutSubItem>
                                <ToggleMenuFlyoutItem
                                    AutomationProperties.AutomationId="ShellQuickRtl"
                                    IsChecked="{Binding UseRtl, Mode=TwoWay}"
                                    Text="Flow right-to-left">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9AB;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    AutomationProperties.AutomationId="ShellQuickFps"
                                    IsChecked="{Binding ShowFpsIndicator, Mode=TwoWay}"
                                    Text="Show FPS indicator">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEC4A;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <not_win:ToggleMenuFlyoutItem
                                    AutomationProperties.AutomationId="ShellQuickSimulateTouch"
                                    IsChecked="{Binding SimulateTouch, Mode=TwoWay}"
                                    Text="Simulate touch">
                                    <not_win:ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE815;" />
                                    </not_win:ToggleMenuFlyoutItem.Icon>
                                </not_win:ToggleMenuFlyoutItem>
                                <not_win:ToggleMenuFlyoutItem
                                    AutomationProperties.AutomationId="ShellQuickDamageRegion"
                                    IsChecked="{Binding DamageRegionOverlay, Mode=TwoWay}"
                                    Text="Show damage region">
                                    <not_win:ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81E;" />
                                    </not_win:ToggleMenuFlyoutItem.Icon>
                                </not_win:ToggleMenuFlyoutItem>
                                <not_win:ToggleMenuFlyoutItem
                                    AutomationProperties.AutomationId="ShellQuickKeepPopups"
                                    IsChecked="{Binding PreventLightDismissOnWindowDeactivated, Mode=TwoWay}"
                                    Text="Keep popups open on breakpoints">
                                    <not_win:ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE92F;" />
                                    </not_win:ToggleMenuFlyoutItem.Icon>
                                </not_win:ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    AutomationProperties.AutomationId="ShellQuickFluentStyles"
                                    IsChecked="{Binding UseFluentStyles, Mode=TwoWay}"
                                    Text="Use Fluent styles">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    AutomationProperties.AutomationId="ShellQuickExtendTitleBar"
                                    IsChecked="{Binding ExtendContentIntoTitleBar, Mode=TwoWay}"
                                    Text="Extend content into title bar">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE737;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <!--  The strip's close button has no way back otherwise; checked state is synced on Opening.  -->
                                <ToggleMenuFlyoutItem
                                    x:Name="ShellQuickDescriptionItem"
                                    AutomationProperties.AutomationId="ShellQuickDescription"
                                    Click="ShellQuickDescriptionItem_Click"
                                    Text="Show sample description">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A5;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Name="ShellQuickAllSettingsItem"
                                    AutomationProperties.AutomationId="ShellQuickAllSettings"
                                    Command="{x:Bind ViewModel.ShowSettingsCommand, Mode=OneWay}"
                                    Text="All settings…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ShellQuickHelpItem"
                                    AutomationProperties.AutomationId="ShellQuickHelp"
                                    Command="{x:Bind ViewModel.OpenHelpCommand, Mode=OneWay}"
                                    Text="Help">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE897;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            x:Name="ShellCopyLinkButton"
                            AutomationProperties.AutomationId="ShellCopyLinkButton"
                            Command="{x:Bind ViewModel.CopySampleLinkCommand, Mode=OneWay}"
                            Label="Copy link">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71B;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="ShellOpenInNewWindowButton"
                            AutomationProperties.AutomationId="ShellOpenInNewWindowButton"
                            Command="{x:Bind ViewModel.OpenSampleInNewWindowCommand, Mode=OneWay}"
                            Label="Open in new window">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="ShellViewSourceButton"
                            AutomationProperties.AutomationId="ShellViewSourceButton"
                            Command="{x:Bind ViewModel.OpenSourceOnGitHubCommand, Mode=OneWay}"
                            Label="View source on GitHub">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE774;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="ShellCopyTypeNameButton"
                            AutomationProperties.AutomationId="ShellCopyTypeNameButton"
                            Command="{x:Bind ViewModel.CopyTypeNameCommand, Mode=OneWay}"
                            Label="Copy type name">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton
                            x:Name="ShellLogViewDumpButton"
                            AutomationProperties.AutomationId="ShellLogViewDumpButton"
                            Command="{x:Bind ViewModel.LogViewDumpCommand, Mode=OneWay}"
                            Label="Log view dump">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEBD2;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="ShellFocusModeButton"
                            AutomationProperties.AutomationId="ShellFocusModeButton"
                            Command="{x:Bind ViewModel.ToggleFocusModeCommand, Mode=OneWay}"
                            Label="Focus mode">
                            <AppBarButton.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE740;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <!--  Search stays the last column so it sits in the same spot on every page  -->
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="3"
                    Width="280"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ShellSearchBox"
                    AutomationProperties.LandmarkType="Search"
                    AutomationProperties.Name="Search samples"
                    ItemTemplateSelector="{StaticResource ShellSuggestionTemplateSelector}"
                    ItemsSource="{x:Bind shell:ShellFunctions.TopSuggestions(ViewModel.FilteredSamples, ViewModel.SearchTerm, ShowShortcutHints), Mode=OneWay}"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="Search samples (Ctrl+F)"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged"
                    TextMemberPath="ControlName"
                    UpdateTextOnSelect="False" />

                <AppBarButton
                    x:Name="ShellSearchButton"
                    Grid.Column="3"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ShellSearchButton"
                    AutomationProperties.Name="Search samples"
                    Click="ShellSearchButton_Click"
                    LabelPosition="Collapsed"
                    Visibility="Collapsed">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE721;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </Grid>

            <!--  DESCRIPTION STRIP (the chrome states collapse the host; the binding owns the strip)  -->
            <Border x:Name="ShellDescriptionHost" Grid.Row="1">
                <Grid
                    x:Name="ShellDescriptionStrip"
                    MinHeight="32"
                    Padding="16,0,8,0"
                    ColumnSpacing="8"
                    Visibility="{x:Bind shell:ShellFunctions.ShowDescription(ViewModel.CurrentSelectedSample.Description, ViewModel.IsDescriptionCollapsed, ViewModel.IsHomeVisible), Mode=OneWay, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ShellDescriptionText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.CurrentSelectedSample.Description, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSelectedSample.Description, Mode=OneWay}" />
                    <HyperlinkButton
                        x:Name="ShellDescriptionMoreButton"
                        Grid.Column="1"
                        Padding="4,2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ShellDescriptionMoreButton"
                        AutomationProperties.Name="More about this sample"
                        Click="ShellDescriptionMoreButton_Click">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="More" />
                    </HyperlinkButton>
                    <Button
                        x:Name="ShellCollapseDescriptionButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="ShellCollapseDescriptionButton"
                        AutomationProperties.Name="Hide description"
                        Click="ShellCollapseDescriptionButton_Click"
                        Style="{StaticResource ShellSubtleButtonStyle}"
                        ToolTipService.ToolTip="Hide description">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="&#xE711;"
                            IsTextScaleFactorEnabled="False" />
                    </Button>
                </Grid>
            </Border>

            <!--  BROWSER + HOST  -->
            <SplitView
                x:Name="SplitView"
                Grid.Row="2"
                DisplayMode="Inline"
                IsPaneOpen="{Binding IsSplitVisible, Mode=TwoWay}"
                OpenPaneLength="{StaticResource ShellPaneWidth}"
                PaneBackground="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <SplitView.Pane>
                    <Grid
                        x:Name="ShellBrowserPane"
                        Padding="8,4"
                        uub:VisibleBoundsPadding.PaddingMask="Left,Top,Bottom"
                        RowSpacing="4">
                        <Grid.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="ms-appx:///Controls/UITests/Views/Styles/Shell/ShellToggleResources.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                                <x:Double x:Key="ListViewItemMinHeight">32</x:Double>
                                <!--  Selected rows use the subtle fill (the stock WinUI 2.6+ look), not Uno's accent-filled template default.  -->
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SubtleFillColorSecondary}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SubtleFillColorTertiary}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SubtleFillColorSecondary}" />
                                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource TextFillColorPrimary}" />
                                        <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                        <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SubtleFillColorSecondary}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SubtleFillColorTertiary}" />
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SubtleFillColorSecondary}" />
                                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{ThemeResource TextFillColorPrimary}" />
                                        <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                        <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <AutoSuggestBox
                            x:Name="ShellPaneSearchBox"
                            Margin="0,4"
                            AutomationProperties.AutomationId="ShellPaneSearchBox"
                            AutomationProperties.LandmarkType="Search"
                            AutomationProperties.Name="Search samples"
                            ItemTemplateSelector="{StaticResource ShellSuggestionTemplateSelector}"
                            ItemsSource="{x:Bind shell:ShellFunctions.PaneSuggestions(ViewModel.FilteredSamples, ViewModel.SearchTerm, ShowShortcutHints), Mode=OneWay}"
                            KeyDown="SearchBox_KeyDown"
                            PlaceholderText="Search samples"
                            QueryIcon="Find"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            TextChanged="SearchBox_TextChanged"
                            TextMemberPath="ControlName"
                            UpdateTextOnSelect="False"
                            Visibility="Collapsed" />

                        <!--  SAMPLES VIEW  -->
                        <Grid
                            x:Name="ShellSamplesView"
                            Grid.Row="1"
                            RowSpacing="4"
                            Visibility="{x:Bind shell:ShellFunctions.SamplesViewVisibility(ViewModel.BrowserView), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <SelectorBar
                                x:Name="ShellBrowserTabs"
                                AutomationProperties.AutomationId="ShellBrowserTabs"
                                SelectionChanged="ShellBrowserTabs_SelectionChanged"
                                TabFocusNavigation="Once">
                                <SelectorBarItem
                                    x:Name="ShellRecentsTab"
                                    AutomationProperties.AutomationId="ShellRecentsTab"
                                    IsSelected="{x:Bind ViewModel.RecentsVisibility, Mode=OneWay, FallbackValue=False}"
                                    Tag="Recents"
                                    Text="Recent">
                                    <SelectorBarItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81C;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem
                                    x:Name="ShellFavoritesTab"
                                    AutomationProperties.AutomationId="ShellFavoritesTab"
                                    IsSelected="{x:Bind ViewModel.FavoritesVisibility, Mode=OneWay, FallbackValue=False}"
                                    Tag="Favorites"
                                    Text="Favorites">
                                    <SelectorBarItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE734;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem
                                    x:Name="ShellLibraryTab"
                                    AutomationProperties.AutomationId="ShellLibraryTab"
                                    IsSelected="{x:Bind ViewModel.CategoriesSelected, Mode=OneWay, FallbackValue=False}"
                                    Tag="Library"
                                    Text="Library">
                                    <SelectorBarItem.Icon>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8F1;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                            </SelectorBar>

                            <!--  Context header: categories count + manual filter  -->
                            <Grid
                                Grid.Row="1"
                                MinHeight="32"
                                Padding="8,0,4,0"
                                ColumnSpacing="8"
                                Visibility="{x:Bind ViewModel.CategoryVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind shell:ShellFunctions.CategoryCountText(ViewModel.CategoryCount), Mode=OneWay}" />
                                <ToggleButton
                                    x:Name="ShellManualTestsChip"
                                    Grid.Column="1"
                                    Padding="8,2"
                                    AutomationProperties.AutomationId="ShellManualTestsChip"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    IsChecked="{Binding ManualTestsOnly, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Show manual tests only">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            x:Name="ShellManualTestsChipIcon"
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="12"
                                            Glyph="&#xE71C;"
                                            IsTextScaleFactorEnabled="False" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Manual tests" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <!--  Context header: drill-up breadcrumb inside a category  -->
                            <Grid
                                Grid.Row="1"
                                MinHeight="32"
                                Padding="0,0,8,0"
                                ColumnSpacing="8"
                                Visibility="{x:Bind ViewModel.SampleVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <BreadcrumbBar
                                    x:Name="ShellPaneBreadcrumb"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ShellPaneBreadcrumb"
                                    ItemClicked="ShellPaneBreadcrumb_ItemClicked"
                                    ItemsSource="{x:Bind shell:ShellFunctions.CategoryCrumbs(ViewModel.SelectedCategory), Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding SelectedCategory.Count}" />
                            </Grid>

                            <!--  Context header: search results  -->
                            <Grid
                                x:Name="ShellSearchHeader"
                                Grid.Row="1"
                                MinHeight="32"
                                Padding="8,0,0,0"
                                ColumnSpacing="8"
                                Visibility="{x:Bind ViewModel.SearchVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="ShellSearchTitle"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Text="{x:Bind shell:ShellFunctions.SearchResultsTitle(ViewModel.SearchTerm), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    x:Name="ShellSearchResultCount"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.LiveSetting="Polite"
                                    AutomationProperties.Name="{x:Bind shell:ShellFunctions.SearchResultCountName(ViewModel.SearchResultCount), Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SearchResultCount, Mode=OneWay}" />
                                <Button
                                    x:Name="ShellCloseSearchButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="ShellCloseSearchButton"
                                    AutomationProperties.Name="Close search results"
                                    Click="ShellCloseSearchButton_Click"
                                    Style="{StaticResource ShellSubtleButtonStyle}"
                                    ToolTipService.ToolTip="Close search results">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="12"
                                        Glyph="&#xE711;"
                                        IsTextScaleFactorEnabled="False" />
                                </Button>
                            </Grid>

                            <ListView
                                x:Name="ShellCategoriesList"
                                Grid.Row="2"
                                helper:ListViewBaseCommand.Command="{Binding ShowNewSectionCommand}"
                                helper:ListViewBaseCommand.CommandParameter="Samples"
                                AutomationProperties.AutomationId="ShellCategoriesList"
                                AutomationProperties.Name="Categories"
                                IsItemClickEnabled="True"
                                ItemTemplate="{StaticResource ShellCategoryRowTemplate}"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                SelectionMode="Single"
                                Visibility="{x:Bind ViewModel.CategoryVisibility, Mode=OneWay, FallbackValue=Collapsed}" />

                            <ListView
                                x:Name="ShellSamplesList"
                                Grid.Row="2"
                                ub:SplitViewBehavior.CloseOnClick="True"
                                AutomationProperties.AutomationId="ShellSamplesList"
                                AutomationProperties.Name="Samples"
                                IsItemClickEnabled="True"
                                ItemTemplate="{StaticResource ShellSampleRowTemplate}"
                                ItemsSource="{Binding SampleContents}"
                                SelectedItem="{Binding SelectedLibrarySample, Mode=TwoWay}"
                                SelectionMode="Single"
                                Visibility="{x:Bind ViewModel.SampleVisibility, Mode=OneWay, FallbackValue=Collapsed}" />

                            <StackPanel
                                Grid.Row="2"
                                Margin="16,48"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind shell:ShellFunctions.LibraryLoadingVisibility(ViewModel.CategoryVisibility, ViewModel.IsSampleIndexLoaded), Mode=OneWay, FallbackValue=Collapsed}">
                                <ProgressRing IsActive="True" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Indexing samples…" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="2"
                                Margin="16,48"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind shell:ShellFunctions.SavedSamplesLoadingVisibility(ViewModel.FavoritesVisibility, ViewModel.RecentsVisibility, ViewModel.AreSavedSamplesLoaded), Mode=OneWay, FallbackValue=Collapsed}">
                                <ProgressRing IsActive="True" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Loading…" />
                            </StackPanel>

                            <!--  SEARCH RESULTS: SearchResultsGrouped flattened into heading and sample rows (code)  -->
                            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.SearchVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <ListView
                                    x:Name="ShellSearchResultsList"
                                    ub:SplitViewBehavior.CloseOnClick="True"
                                    AutomationProperties.AutomationId="ShellSearchResultsList"
                                    AutomationProperties.Name="Search results"
                                    IsItemClickEnabled="True"
                                    ItemClick="ShellSearchResultsList_ItemClick"
                                    ItemTemplateSelector="{StaticResource ShellSearchResultsTemplateSelector}"
                                    SelectionChanged="ShellSearchResultsList_SelectionChanged"
                                    SelectionMode="Single" />
                                <StackPanel
                                    Margin="16,48"
                                    HorizontalAlignment="Center"
                                    Spacing="8"
                                    Visibility="{x:Bind shell:ShellFunctions.SearchEmptyVisibility(ViewModel.SearchResultCount, ViewModel.SearchTerm), Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="32"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE721;"
                                        IsTextScaleFactorEnabled="False" />
                                    <TextBlock
                                        x:Name="ShellSearchEmptyTitle"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind shell:ShellFunctions.SearchEmptyTitle(ViewModel.SearchTerm), Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Search looks at names, categories and type names."
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.FavoritesVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <ListView
                                    x:Name="ShellFavoritesList"
                                    ub:SplitViewBehavior.CloseOnClick="True"
                                    AutomationProperties.AutomationId="ShellFavoritesList"
                                    AutomationProperties.Name="Favorites"
                                    IsItemClickEnabled="True"
                                    ItemTemplate="{StaticResource ShellSampleRowTemplate}"
                                    ItemsSource="{Binding FavoriteSamples}"
                                    SelectedItem="{Binding SelectedFavoriteSample, Mode=TwoWay}"
                                    SelectionMode="Single" />
                                <StackPanel
                                    Margin="16,48"
                                    HorizontalAlignment="Center"
                                    Spacing="8"
                                    Visibility="{x:Bind shell:ShellFunctions.EmptyListVisibility(ViewModel.HasFavorites, ViewModel.AreSavedSamplesLoaded), Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="32"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE734;"
                                        IsTextScaleFactorEnabled="False" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="No favorites yet" />
                                    <TextBlock
                                        x:Name="ShellFavoritesEmptyHint"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Star a sample (Ctrl+Shift+D) to keep it here."
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.RecentsVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <ListView
                                    x:Name="ShellRecentsList"
                                    ub:SplitViewBehavior.CloseOnClick="True"
                                    AutomationProperties.AutomationId="ShellRecentsList"
                                    AutomationProperties.Name="Recent"
                                    IsItemClickEnabled="True"
                                    ItemTemplate="{StaticResource ShellSampleRowTemplate}"
                                    ItemsSource="{Binding RecentSamples}"
                                    SelectedItem="{Binding SelectedRecentSample, Mode=TwoWay}"
                                    SelectionMode="Single" />
                                <StackPanel
                                    Margin="16,48"
                                    HorizontalAlignment="Center"
                                    Spacing="8"
                                    Visibility="{x:Bind shell:ShellFunctions.EmptyListVisibility(ViewModel.HasRecents, ViewModel.AreSavedSamplesLoaded), Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="32"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE81C;"
                                        IsTextScaleFactorEnabled="False" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Nothing here yet" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind shell:ShellFunctions.RecentsEmptyHint(ViewModel.RecentsEnabled)}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!--  Footer: the results view lists the best matches only  -->
                            <TextBlock
                                Grid.Row="3"
                                Padding="8,8"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind shell:ShellFunctions.SearchCapText(ViewModel.SearchResultCount), Mode=OneWay}"
                                Visibility="{x:Bind shell:ShellFunctions.SearchCapVisibility(ViewModel.SearchVisibility, ViewModel.SearchResultCount), Mode=OneWay, FallbackValue=Collapsed}" />

                            <!--  Footer: count + clear (Favorites and Recent)  -->
                            <Grid
                                Grid.Row="3"
                                MinHeight="32"
                                Padding="8,0,4,0"
                                ColumnSpacing="8"
                                Visibility="{x:Bind ViewModel.FavoritesVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind shell:ShellFunctions.FavoritesCountText(ViewModel.FavoritesCount), Mode=OneWay}" />
                                <HyperlinkButton
                                    x:Name="ShellClearFavoritesButton"
                                    Grid.Column="1"
                                    Padding="4,2"
                                    AutomationProperties.AutomationId="ShellClearFavoritesButton"
                                    Click="ShellClearLink_Click"
                                    IsEnabled="{x:Bind ViewModel.HasFavorites, Mode=OneWay, FallbackValue=False}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Clear" />
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout x:Name="ShellClearFavoritesFlyout" Placement="Top">
                                            <StackPanel MaxWidth="240" Spacing="12">
                                                <TextBlock Text="Remove all favorites?" TextWrapping="Wrap" />
                                                <Button Click="ShellClearFavorites_Click" Content="Clear favorites" />
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </HyperlinkButton>
                            </Grid>

                            <Grid
                                Grid.Row="3"
                                MinHeight="32"
                                Padding="8,0,4,0"
                                ColumnSpacing="8"
                                Visibility="{x:Bind ViewModel.RecentsVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind shell:ShellFunctions.RecentsCountText(ViewModel.RecentSamples), Mode=OneWay}" />
                                <HyperlinkButton
                                    x:Name="ShellClearRecentsButton"
                                    Grid.Column="1"
                                    Padding="4,2"
                                    AutomationProperties.AutomationId="ShellClearRecentsButton"
                                    Click="ShellClearLink_Click"
                                    IsEnabled="{x:Bind ViewModel.HasRecents, Mode=OneWay, FallbackValue=False}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Clear" />
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout x:Name="ShellClearRecentsFlyout" Placement="Top">
                                            <StackPanel MaxWidth="240" Spacing="12">
                                                <TextBlock Text="Clear the recent samples list?" TextWrapping="Wrap" />
                                                <Button Click="ShellClearRecents_Click" Content="Clear history" />
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </HyperlinkButton>
                            </Grid>
                        </Grid>

                        <!--  SETTINGS VIEW (filled in by the settings view)  -->
                        <Grid
                            x:Name="ShellSettingsHost"
                            Grid.Row="1"
                            RowSpacing="8"
                            Visibility="{x:Bind shell:ShellFunctions.SettingsViewVisibility(ViewModel.BrowserView), Mode=OneWay, FallbackValue=Collapsed}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid MinHeight="40" Padding="8,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Settings" />
                                <Button
                                    x:Name="ShellCloseSettingsButton"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="ShellCloseSettingsButton"
                                    AutomationProperties.Name="Close settings"
                                    Click="ShellCloseSettingsButton_Click"
                                    Style="{StaticResource ShellSubtleButtonStyle}"
                                    ToolTipService.ToolTip="Close settings">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="12"
                                        Glyph="&#xE711;"
                                        IsTextScaleFactorEnabled="False" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Grid.Row="1"
                                Margin="8,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Use the quick settings button in the header to change the theme and diagnostics."
                                TextWrapping="Wrap" />
                        </Grid>
                        <!--  Phones hide the rail, so its destinations move to the bottom of the pane, within thumb reach.  -->
                        <Grid
                            x:Name="ShellPaneDestinations"
                            Grid.Row="2"
                            Padding="0,4,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                            <!--  One star column per destination so the row always fits the pane; the Benchmarks column collapses with its button (code).  -->
                            <Grid
                                x:Name="ShellPaneDestinationsRow"
                                AutomationProperties.Name="Destinations"
                                TabFocusNavigation="Once"
                                XYFocusKeyboardNavigation="Enabled">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ShellPaneBenchmarksColumn" Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="ShellPaneHomeButton"
                                    AutomationProperties.AutomationId="ShellPaneHomeButton"
                                    AutomationProperties.Name="Home"
                                    Click="ShellDestinationButton_Click"
                                    Style="{StaticResource ShellDestinationButtonStyle}"
                                    Tag="Home">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE80F;"
                                        IsTextScaleFactorEnabled="False" />
                                </Button>
                                <Button
                                    x:Name="ShellPaneRuntimeTestsButton"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="ShellPaneRuntimeTestsButton"
                                    AutomationProperties.Name="Runtime tests"
                                    Click="ShellDestinationButton_Click"
                                    Style="{StaticResource ShellDestinationButtonStyle}"
                                    Tag="RuntimeTests">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE9D5;"
                                        IsTextScaleFactorEnabled="False" />
                                </Button>
                                <Button
                                    x:Name="ShellPaneBenchmarksButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="ShellPaneBenchmarksButton"
                                    AutomationProperties.Name="Benchmarks"
                                    Click="ShellDestinationButton_Click"
                                    Style="{StaticResource ShellDestinationButtonStyle}"
                                    Tag="Benchmarks"
                                    Visibility="{x:Bind shell:ShellFunctions.Visible(ViewModel.HasBenchmarks), FallbackValue=Collapsed}">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE9D2;"
                                        IsTextScaleFactorEnabled="False" />
                                </Button>
                                <Button
                                    x:Name="ShellPanePlaygroundButton"
                                    Grid.Column="3"
                                    AutomationProperties.AutomationId="ShellPanePlaygroundButton"
                                    AutomationProperties.Name="Playground"
                                    Click="ShellDestinationButton_Click"
                                    Style="{StaticResource ShellDestinationButtonStyle}"
                                    Tag="Playground">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE943;"
                                        IsTextScaleFactorEnabled="False" />
                                </Button>
                                <Button
                                    x:Name="ShellPaneHelpButton"
                                    Grid.Column="4"
                                    AutomationProperties.AutomationId="ShellPaneHelpButton"
                                    AutomationProperties.Name="Help"
                                    Click="ShellDestinationButton_Click"
                                    Style="{StaticResource ShellDestinationButtonStyle}"
                                    Tag="Help">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE897;"
                                        IsTextScaleFactorEnabled="False" />
                                </Button>
                                <Button
                                    x:Name="ShellPaneSettingsButton"
                                    Grid.Column="5"
                                    AutomationProperties.AutomationId="ShellPaneSettingsButton"
                                    AutomationProperties.Name="Settings"
                                    Click="ShellDestinationButton_Click"
                                    Style="{StaticResource ShellDestinationButtonStyle}"
                                    Tag="Settings">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="&#xE713;"
                                        IsTextScaleFactorEnabled="False" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </SplitView.Pane>

                <SplitView.Content>
                    <Grid
                        x:Name="ShellHostLayer"
                        AutomationProperties.AutomationId="ShellHost"
                        AutomationProperties.LandmarkType="Main"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="{StaticResource ShellHostCornerRadius}">
                        <Grid.Resources>
                            <!--  Samples paint the page background over the layer fill, so the edge alone draws the card; the dark card stroke vanishes on the dark page.  -->
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ShellHostStrokeBrush" Color="{ThemeResource CardStrokeColorDefault}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="ShellHostStrokeBrush" Color="{ThemeResource ControlStrokeColorDefault}" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="ShellHostStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <ContentControl
                            x:Name="SampleHost"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.ContentPhone, Mode=OneWay}"
                            IsTabStop="False"
                            Visibility="{x:Bind shell:ShellFunctions.SampleHostVisibility(ViewModel.IsHomeVisible), Mode=OneWay}" />

                        <StackPanel
                            x:Name="ShellHostEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind shell:ShellFunctions.EmptyHostVisibility(ViewModel.ContentPhone, ViewModel.IsHomeVisible), Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Spacing="8" Visibility="{x:Bind shell:ShellFunctions.Collapsed(ViewModel.IsSampleIndexLoaded), Mode=OneWay, FallbackValue=Visible}">
                                <ProgressRing IsActive="{x:Bind shell:ShellFunctions.Not(ViewModel.IsSampleIndexLoaded), Mode=OneWay, FallbackValue=True}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Indexing samples…" />
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="{x:Bind shell:ShellFunctions.Visible(ViewModel.IsSampleIndexLoaded), Mode=OneWay, FallbackValue=Collapsed}">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="48"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE721;"
                                    IsTextScaleFactorEnabled="False" />
                                <TextBlock Style="{StaticResource ShellEmptyStateTitleStyle}" Text="No sample open" />
                                <TextBlock
                                    x:Name="ShellHostEmptyHint"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Press Ctrl+F to find one" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Placeholder until the Home view lands  -->
                        <StackPanel
                            x:Name="ShellHomeView"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsHomeVisible, Mode=OneWay, FallbackValue=Collapsed}">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="48"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE80F;"
                                IsTextScaleFactorEnabled="False" />
                            <TextBlock Style="{StaticResource ShellEmptyStateTitleStyle}" Text="Pick a sample" />
                            <TextBlock
                                x:Name="ShellHomeHint"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Search with Ctrl+F or browse with Ctrl+B." />
                        </StackPanel>

                        <!--  Drawn over the sample, which usually paints the page background across the host fill.  -->
                        <Border
                            x:Name="ShellHostEdge"
                            BorderBrush="{ThemeResource ShellHostStrokeBrush}"
                            BorderThickness="1,1,0,0"
                            CornerRadius="{StaticResource ShellHostCornerRadius}"
                            IsHitTestVisible="False" />
                    </Grid>
                </SplitView.Content>
            </SplitView>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellLayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SplitView.DisplayMode" Value="Overlay" />
                        <Setter Target="ShellSampleTitle.Style" Value="{StaticResource BodyStrongTextBlockStyle}" />
                        <Setter Target="SearchBox.Visibility" Value="Collapsed" />
                        <Setter Target="ShellSearchButton.Visibility" Value="Visible" />
                        <Setter Target="ShellPaneSearchBox.Visibility" Value="Visible" />
                        <Setter Target="ShellPaneDestinations.Visibility" Value="Visible" />
                        <Setter Target="ShellCommandBar.DefaultLabelPosition" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="TabletState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SplitView.DisplayMode" Value="Overlay" />
                        <Setter Target="SearchBox.Width" Value="200" />
                        <Setter Target="ShellCommandBar.DefaultLabelPosition" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="ShellChromeStates">
                <VisualState x:Name="ChromeNormalState" />
                <!--  Runtime tests and other automation: the header keeps its height so the runner keeps its top offset.  -->
                <VisualState x:Name="ChromeAutomationState">
                    <VisualState.Setters>
                        <Setter Target="ShellRail.IsPaneVisible" Value="False" />
                        <Setter Target="ShellDescriptionHost.Visibility" Value="Collapsed" />
                        <Setter Target="ShellBrowserToggle.Visibility" Value="Collapsed" />
                        <Setter Target="ShellHostEdge.Visibility" Value="Collapsed" />
                        <Setter Target="ShellHostLayer.CornerRadius" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <!--  Screenshots and focus mode: the sample fills everything below the title bar.  -->
                <VisualState x:Name="ChromeHiddenState">
                    <VisualState.Setters>
                        <Setter Target="ShellRail.IsPaneVisible" Value="False" />
                        <Setter Target="ShellHeader.Visibility" Value="Collapsed" />
                        <Setter Target="ShellDescriptionHost.Visibility" Value="Collapsed" />
                        <Setter Target="ShellBrowserPane.Visibility" Value="Collapsed" />
                        <Setter Target="ShellHostEdge.Visibility" Value="Collapsed" />
                        <Setter Target="ShellHostLayer.CornerRadius" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
