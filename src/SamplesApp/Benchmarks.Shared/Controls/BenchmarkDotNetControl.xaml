<UserControl
    x:Class="Benchmarks.Shared.Controls.BenchmarkDotNetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Benchmarks.Shared.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="benchmarkControl"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/UITests/Views/Styles/Shell/ShellResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="ShellBenchScroller"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        SizeChanged="OnScrollerSizeChanged"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="ShellBenchRoot"
            Padding="24,16"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="ShellBenchTitleHost" Grid.Row="0">
                <TextBlock
                    x:Name="ShellBenchTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource ShellHeaderTitleTextStyle}"
                    Text="BenchmarkDotNet" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="In-process suite · SamplesApp.Benchmarks.Suite"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                x:Name="ShellBenchCard"
                Grid.Row="1"
                SizeChanged="OnCardSizeChanged"
                Style="{StaticResource ShellCardStyle}">
                <Grid
                    x:Name="ShellBenchControls"
                    ColumnSpacing="12"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="ShellBenchFilter"
                        Grid.Row="0"
                        Grid.Column="0"
                        MinWidth="240"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Header="Class filter"
                        PlaceholderText="Class name contains…"
                        Text="{x:Bind ClassFilter, Mode=TwoWay}" />
                    <CheckBox
                        x:Name="debugLog"
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Content="Debug logging"
                        IsChecked="False" />
                    <Button
                        x:Name="runButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Run benchmarks"
                        Click="OnRunTests"
                        Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE768;" />
                            <TextBlock Text="Run benchmarks" />
                        </StackPanel>
                    </Button>

                    <Grid
                        x:Name="ShellBenchStatusGrid"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressRing
                            x:Name="ShellBenchProgress"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="runStatus"
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Text="Not initialized"
                            TextWrapping="Wrap" />
                        <StackPanel
                            x:Name="ShellBenchCountPanel"
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Types run:" />
                            <TextBlock
                                x:Name="runCount"
                                VerticalAlignment="Center"
                                Style="{StaticResource ShellBodyStrongTextStyle}"
                                Text="" />
                        </StackPanel>
                        <Button
                            x:Name="downloadResults"
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Download results"
                            Click="{x:Bind OnDownloadResults}"
                            IsEnabled="false">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE896;" />
                                <TextBlock Text="Download results" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid
                x:Name="ShellBenchOutput"
                Grid.Row="2"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ShellBenchLogCard"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="0"
                    Background="{ThemeResource ShellLogBackgroundBrush}"
                    Style="{StaticResource ShellCardStyle}">
                    <Grid>
                        <ScrollViewer
                            x:Name="ShellBenchLogScroller"
                            Padding="12"
                            AutomationProperties.Name="Benchmark log"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="runLogs" Style="{StaticResource ShellMonospaceTextStyle}" />
                        </ScrollViewer>
                        <TextBlock
                            x:Name="ShellBenchLogEmpty"
                            Margin="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Run benchmarks to see the log here."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border
                    x:Name="ShellBenchHostCard"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource ShellCardStyle}">
                    <Grid>
                        <ContentControl x:Name="testHost" />
                        <TextBlock
                            x:Name="ShellBenchHostEmpty"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Benchmarks that render UI appear here while running."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
