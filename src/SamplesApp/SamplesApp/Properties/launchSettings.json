{
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:8080",
      "sslPort": 0
    }
  },
  "profiles": {
    // Desktop is first so it is the one a plain F5 (and dotnet run) picks: it is the fastest loop and
    // the target the samples are developed against. The WebAssembly profiles below mirror the ones
    // dotnet new unoapp generates.
    "SamplesApp (Desktop)": {
      "commandName": "Project",
      "compatibleTargetFramework": "desktop"
    },
    // The TFM is part of the path, so it tracks $(NetCurrent) in Directory.Build.props. Building with
    // a UnoTargetFrameworkOverride that pins the previous .NET moves the output, and this needs to follow.
    "SamplesApp (Desktop WSL2)": {
      "commandName": "WSL2",
      "commandLineArgs": "{ProjectDir}/bin/Debug/net11.0-desktop/SamplesApp.dll",
      "distributionName": "",
      "compatibleTargetFramework": "desktop"
    },
    "SamplesApp (WebAssembly)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5000",
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "SamplesApp (WebAssembly IIS Express)": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    // Note: In order to select this profile, you'll need to comment the `Packaged` profile below until this is fixed: https://aka.platform.uno/wasdk-maui-debug-profile-issue
    "SamplesApp (WinAppSDK Unpackaged)": {
      "commandName": "Project",
      "compatibleTargetFramework": "windows"
    },
    "SamplesApp (WinAppSDK Packaged)": {
      "commandName": "MsixPackage",
      "compatibleTargetFramework": "windows"
    }
  }
}
