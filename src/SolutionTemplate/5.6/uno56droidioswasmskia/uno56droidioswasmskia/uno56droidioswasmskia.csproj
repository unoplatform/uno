<Project Sdk="Uno.Sdk.Private">
  <PropertyGroup>
    <TargetFrameworks>net11.0-browserwasm;net11.0-ios;net11.0-android;net11.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>uno56droidioswasmskia</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.uno56droidioswasmskia</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
      MediaPlayerElement;
      WebView;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- This file should not cause a duplicate content inclusion on Wasm -->
    <Content Include="TestStaticContent.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- nuget package reference validation -->
    <PackageReference Include="Uno56NugetLibrary" />
    <PackageReference Include="Uno56NugetPlainLibrary" />
  </ItemGroup>
  
  <ItemGroup>
    <Using Include="MyCustom.Logging.ILogger" Alias="ILogger" />
  </ItemGroup>

  <!-- fail the build if a BundleResource.LogicalName contains a rooted path -->
  <Target Name="ValidateBundleResourceLogicalName" AfterTargets="AfterBuild">
    <Error 
      Condition="'%(BundleResource.LogicalName)' != '' And $([System.IO.Path]::IsPathRooted('%(BundleResource.LogicalName)'))" 
      Text="BundleResource.LogicalName must not contain a rooted path" />
  </Target>
  
  <!--
    On Skia mobile heads a multi-targeted package must keep its platform-specific asset, and a plain netX.0 package
    its netX.0 one, for both compile and runtime.
  -->
  <Target Name="ValidatePlatformSpecificPackageAsset"
          AfterTargets="ResolveReferences"
          Condition="'$(TargetPlatformIdentifier)' == 'android' OR '$(TargetPlatformIdentifier)' == 'ios'">
    <PropertyGroup>
      <_PlatformAssetFolder>lib$([System.IO.Path]::DirectorySeparatorChar)$(TargetFramework.ToLowerInvariant())</_PlatformAssetFolder>
      <_PlainAssetFolder>lib$([System.IO.Path]::DirectorySeparatorChar)$(TargetFramework.Split('-')[0])$([System.IO.Path]::DirectorySeparatorChar)</_PlainAssetFolder>
    </PropertyGroup>
    <ItemGroup>
      <_ExpectedPackageAsset Include="Uno56NugetLibrary" Folder="$(_PlatformAssetFolder)" />
      <_ExpectedPackageAsset Include="Uno56NugetPlainLibrary" Folder="$(_PlainAssetFolder)" />

      <_PackageAssetUse Include="@(ReferencePath)" Use="compile" Condition="'%(Filename)' == 'Uno56NugetLibrary' OR '%(Filename)' == 'Uno56NugetPlainLibrary'" />
      <_PackageAssetUse Include="@(RuntimeCopyLocalItems)" Use="runtime" Condition="'%(Filename)%(Extension)' == 'Uno56NugetLibrary.dll' OR '%(Filename)%(Extension)' == 'Uno56NugetPlainLibrary.dll'" />
      <_PackageAssetUse Update="@(_PackageAssetUse)" Folder="%(_ExpectedPackageAsset.Folder)" Condition="'%(_PackageAssetUse.Filename)' == '%(_ExpectedPackageAsset.Identity)'" />
    </ItemGroup>
    <Error Condition="@(_PackageAssetUse->Count()) != 4"
           Text="Expected a compile and a runtime asset for each test package, got '@(_PackageAssetUse)'" />
    <Error Condition="!$([System.String]::Copy('%(_PackageAssetUse.FullPath)').Contains('%(_PackageAssetUse.Folder)'))"
           Text="%(_PackageAssetUse.Filename) must use its %(_PackageAssetUse.Folder) asset for %(_PackageAssetUse.Use), got '%(_PackageAssetUse.FullPath)'" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\UnoLibrary1\UnoLibrary1.csproj" />
  </ItemGroup>

</Project>
