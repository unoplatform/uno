<Project>
	<PropertyGroup>
		<IsIOSOrCatalyst>true</IsIOSOrCatalyst>
		<IsIOS>true</IsIOS>
		<_UnoDefaultedSupportedOSPlatformVersion Condition=" $(SupportedOSPlatformVersion) == '' ">true</_UnoDefaultedSupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition=" $(SupportedOSPlatformVersion) == '' ">14.2</SupportedOSPlatformVersion>

		<EnableDefaultiOSItems Condition="$(EnableDefaultiOSItems) == ''">false</EnableDefaultiOSItems>

		<IsMSALSupported>true</IsMSALSupported>

		<!--
		The iOS SDK fails a build against the version 27 SDKs with MT7199 when Info.plist has no scene manifest.
		Uno Platform adopts the scene lifecycle in code for such apps, which that check can't see.
		-->
		<ValidateSceneManifest Condition=" '$(ValidateSceneManifest)' == '' ">false</ValidateSceneManifest>
	</PropertyGroup>

	<Import Project="$(MSBuildThisFileDirectory)Uno.SingleProject.iOS.targets" Condition=" $(_IsUnoSingleProjectAndLegacy) == 'true' " />
</Project>
