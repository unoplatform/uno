<Project>
	<!--
		Include all required PackageReference to be available before any target is executed
		in order for VS and C# Dev Kit to show nuget references in their respective solution explorers.
		The version is not required, and VS/Code waits for some design-time targets to be executed to evaluate it.
	-->
	<!-- This file is only imported for Uno Platform targets (not WinAppSDK). The Skia backend and its
	     SkiaSharp bindings are referenced when the 'skia' feature is present (implied by default), so a
	     skia-free build (e.g. WebGPU-only) drops them. -->
	<ItemGroup Condition="$(UnoFeatures.Contains(';skia;'))">
		<_UnoProjectSystemPackageReference Include="Uno.UI.Composition.Skia" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="SkiaSharp.Views.Uno.WinUI" ProjectSystem="true"/>
	</ItemGroup>

	<!-- The WebGPU backend is additive: it coexists with Skia and the runtime negotiates which one to use. -->
	<ItemGroup Condition="$(UnoFeatures.Contains(';webgpu;'))">
		<_UnoProjectSystemPackageReference Include="Uno.UI.Composition.WebGpu" ProjectSystem="true" />
	</ItemGroup>

	<!-- Lottie and SVG each ship a SkiaSharp add-in over a neutral seam that Uno.WinUI also implements without
	     SkiaSharp, so without a Skia renderer there is nothing for the add-in to draw with and the host builder
	     resolves the managed engine instead. Lottie stays implicit because it is pure managed and adds ~144 KB
	     where SkiaSharp is already present, which is not worth downgrading every app to the managed engine. -->
	<ItemGroup Condition="$(UnoFeatures.Contains(';skia;'))">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Lottie" ProjectSystem="true" />
	</ItemGroup>

	<ItemGroup Condition="$(UnoFeatures.Contains(';skia;')) AND $(UnoFeatures.Contains(';svg;')) AND $(IsUnoHead) == 'true'">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Svg" ProjectSystem="true" />
	</ItemGroup>

	<ItemGroup Condition="$(UnoFeatures.Contains(';spellchecking;'))">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.SpellChecking" ProjectSystem="true" />
	</ItemGroup>

	<ItemGroup Condition=" '$(IsPackable)' != 'true' AND $(UnoFeatures.Contains(';skia;'))">
		<!-- Uno.WinUI.Lottie declares Skottie only on its mobile groups, so the plain TFMs need it injected here. -->
		<_UnoProjectSystemPackageReference Include="SkiaSharp.Skottie" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="Svg.Skia" ProjectSystem="true" Condition="$(UnoFeatures.Contains(';svg;')) AND $(IsUnoHead) == 'true'" />
	</ItemGroup>
</Project>
