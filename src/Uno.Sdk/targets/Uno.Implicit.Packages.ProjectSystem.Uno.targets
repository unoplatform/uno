<Project>
	<!--
		Include all required PackageReference to be available before any target is executed
		in order for VS and C# Dev Kit to show nuget references in their respective solution explorers.
		The version is not required, and VS/Code waits for some design-time targets to be executed to evaluate it.
	-->
	<!-- This file is only imported for Uno Platform targets (not WinAppSDK). The Skia backend is referenced
	     when the 'skia' feature is present (implied by default), so a skia-free build (e.g. WebGPU-only) drops it. -->
	<ItemGroup Condition="$(UnoFeatures.Contains(';skia;'))">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Composition.Skia" ProjectSystem="true" />
	</ItemGroup>

	<!-- The WebGPU backend is additive: it coexists with Skia and the runtime negotiates which one to use. -->
	<ItemGroup Condition="$(UnoFeatures.Contains(';webgpu;'))">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Composition.WebGpu" ProjectSystem="true" />
	</ItemGroup>

	<!-- SVG ships a SkiaSharp add-in over a neutral seam that Uno.WinUI also implements without SkiaSharp, so
	     without a Skia renderer there is nothing for the add-in to draw with and the host builder resolves the
	     managed engine instead. Lottie needs no package: Skottie comes with the Skia backend. -->
	<ItemGroup Condition="$(UnoFeatures.Contains(';skia;')) AND $(UnoFeatures.Contains(';svg;')) AND $(IsUnoHead) == 'true'">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Svg" ProjectSystem="true" />
	</ItemGroup>

	<ItemGroup Condition="$(UnoFeatures.Contains(';spellchecking;'))">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.SpellChecking" ProjectSystem="true" />
	</ItemGroup>

	<ItemGroup Condition=" '$(IsPackable)' != 'true' AND $(UnoFeatures.Contains(';skia;'))">
		<_UnoProjectSystemPackageReference Include="Svg.Skia" ProjectSystem="true" Condition="$(UnoFeatures.Contains(';svg;')) AND $(IsUnoHead) == 'true'" />
	</ItemGroup>
</Project>
