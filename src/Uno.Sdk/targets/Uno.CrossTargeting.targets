<Project>

	<PropertyGroup Condition="'$(IsCrossruntime)' == ''">
		<!--
		Every target framework Uno Platform provides is rendered by Uno itself; only the WinAppSDK one is
		rendered by WinUI. Note this does not name a drawing backend: Uno.UI compiles once and selects its
		backend at runtime.
		-->
		<IsCrossruntime>true</IsCrossruntime>
		<IsCrossruntime Condition="$(IsWinAppSdk)">false</IsCrossruntime>
	</PropertyGroup>

	<ItemGroup>
		<None Include="**\*.crossruntime.cs" Exclude="bin\**\*.crossruntime.cs;obj\**\*.crossruntime.cs" Condition="!$(IsCrossruntime)" />
		<Compile Remove="**\*.crossruntime.cs" Condition="!$(IsCrossruntime)" />

		<None Include="**\*.wasm.cs" Exclude="bin\**\*.wasm.cs;obj\**\*.wasm.cs" Condition="!$(IsBrowserWasm)" />
		<Compile Remove="**\*.wasm.cs" Condition="!$(IsBrowserWasm)" />

		<None Include="**\*.browserwasm.cs" Exclude="bin\**\*.browserwasm.cs;obj\**\*.browserwasm.cs" Condition="!$(IsBrowserWasm)" />
		<Compile Remove="**\*.browserwasm.cs" Condition="!$(IsBrowserWasm)" />

		<!-- .skia.cs is the historical spelling of .crossruntime.cs and carries the same meaning. -->
		<None Include="**\*.skia.cs" Exclude="bin\**\*.skia.cs;obj\**\*.skia.cs" Condition="!$(IsCrossruntime)" />
		<Compile Remove="**\*.skia.cs" Condition="!$(IsCrossruntime)" />

		<None Include="**\*.desktop.cs" Exclude="bin\**\*.desktop.cs;obj\**\*.desktop.cs" Condition="!$(IsDesktop)" />
		<Compile Remove="**\*.desktop.cs" Condition="!$(IsDesktop)" />

		<None Include="**\*.iOS.cs" Exclude="bin\**\*.iOS.cs;obj\**\*.iOS.cs" Condition="!$(IsIOS)" />
		<Compile Remove="**\*.iOS.cs" Condition="!$(IsIOS)" />

		<None Include="**\*.tvOS.cs" Exclude="bin\**\*.tvOS.cs;obj\**\*.tvOS.cs" Condition="!$(IsTvOS)" />
		<Compile Remove="**\*.tvOS.cs" Condition="!$(IsTvOS)" />

		<None Include="**\*.UIKit.cs" Exclude="bin\**\*.UIKit.cs;obj\**\*.UIKit.cs" Condition="!$(IsAppleUIKit)" />
		<Compile Remove="**\*.UIKit.cs" Condition="!$(IsAppleUIKit)" />

		<None Include="**\*.Android.cs" Exclude="bin\**\*.Android.cs;obj\**\*.Android.cs" Condition="!$(IsAndroid)" />
		<Compile Remove="**\*.Android.cs" Condition="!$(IsAndroid)" />

		<None Include="**\*.WinAppSDK.cs" Exclude="bin\**\*.WinAppSDK.cs;obj\**\*.WinAppSDK.cs" Condition="!$(IsWinAppSDK)" />
		<Compile Remove="**\*.WinAppSDK.cs" Condition="!$(IsWinAppSDK)" />
	</ItemGroup>

</Project>
