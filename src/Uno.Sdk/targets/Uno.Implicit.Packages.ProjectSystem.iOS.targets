<Project>
	<!--
		Include all required PackageReference to be available before any target is executed
		in order for VS and C# Dev Kit to show nuget references in their respective solution explorers.
		The version is not required, and VS/Code waits for some design-time targets to be executed to evaluate it.
	-->
	<Import Project="$(MSBuildThisFileDirectory)Uno.Implicit.Packages.ProjectSystem.Uno.targets" />

	<ItemGroup Condition="$(_IsExecutable) == 'true'">
		<_UnoProjectSystemPackageReference Include="Uno.Extensions.Logging.OSLog" ProjectSystem="true" />
	</ItemGroup>

	<ItemGroup Condition=" $(_IsExecutable) == 'true' ">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Runtime.AppleUIKit" ProjectSystem="true" />
		<!-- Native libraries are referenced explicitly rather than left to the managed SkiaSharp / HarfBuzzSharp
		     packages' own dependencies. HarfBuzz shapes text for the font providers in Uno.WinUI; Skia is the skia feature's. -->
		<_UnoProjectSystemPackageReference Include="HarfBuzzSharp.NativeAssets.iOS" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="SkiaSharp.NativeAssets.iOS" ProjectSystem="true" Condition="$(UnoFeatures.Contains(';skia;'))" />
	</ItemGroup>

	<ItemGroup Condition=" $(_IsExecutable) == 'false' ">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Runtime.AppleUIKit" PrivateAssets="all" IncludeAssets="build" ProjectSystem="true" />
	</ItemGroup>

	<ItemGroup Condition="$(_IsExecutable) == 'true' AND $(UnoFeatures.Contains(';mauiembedding;'))">
		<_UnoProjectSystemPackageReference Include="Uno.Extensions.Maui.WinUI.Runtime.Skia" ProjectSystem="true" />
	</ItemGroup>
</Project>
