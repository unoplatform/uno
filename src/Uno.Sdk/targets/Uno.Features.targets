<Project>

	<PropertyGroup>
		<UnoFeatures>$([System.Text.RegularExpressions.Regex]::Replace($(UnoFeatures), '\s', '').ToLowerInvariant())</UnoFeatures>
		<UnoFeatures Condition="$(UnoFeatures) == ''">;</UnoFeatures>
		<UnoFeatures Condition="!$(UnoFeatures.StartsWith(';'))">;$(UnoFeatures)</UnoFeatures>
		<UnoFeatures Condition="!$(UnoFeatures.EndsWith(';'))">$(UnoFeatures);</UnoFeatures>

		<!-- A renderer is required, so 'skia' is implied when the app names none. Naming 'webgpu' counts as
		     naming one, which is what lets an app be SkiaSharp-free. Listing both references both, and Skia
		     still renders by default; the head opts into WebGPU on the host builder. The legacy
		     'nativerenderer' token is ignored, and 'skiarenderer' is mapped to 'skia' for backwards
		     compatibility. -->
		<UnoFeatures>$(UnoFeatures.Replace(';nativerenderer;', ';'))</UnoFeatures>
		<UnoFeatures>$(UnoFeatures.Replace(';skiarenderer;', ';'))</UnoFeatures>
		<UnoFeatures Condition="!$(UnoFeatures.Contains(';skia;')) And !$(UnoFeatures.Contains(';webgpu;'))">$(UnoFeatures)skia;</UnoFeatures>
	</PropertyGroup>

	<PropertyGroup Condition="$(UnoFeatures.Contains(';mauiembedding;'))">
		<UseMaui>true</UseMaui>
	</PropertyGroup>


	<Target Name="_UnoIncludeUnoUIRuntimeIdentifier"
			BeforeTargets="BeforeBuild;GetAssemblyAttributes">
		<ItemGroup Condition=" '$(UnoUIRuntimeIdentifier)' != '' ">
			<AssemblyMetadata Include="UnoUIRuntimeIdentifier" Value="$(UnoUIRuntimeIdentifier)" />
		</ItemGroup>
	</Target>
</Project>
