<Project>

	<PropertyGroup>
		<UnoFeatures>$([System.Text.RegularExpressions.Regex]::Replace($(UnoFeatures), '\s', '').ToLowerInvariant())</UnoFeatures>
		<UnoFeatures Condition="$(UnoFeatures) == ''">;</UnoFeatures>
		<UnoFeatures Condition="!$(UnoFeatures.StartsWith(';'))">;$(UnoFeatures)</UnoFeatures>
		<UnoFeatures Condition="!$(UnoFeatures.EndsWith(';'))">$(UnoFeatures);</UnoFeatures>

		<!-- A renderer is required, so 'skia' is implied when the app names none. Naming 'webgpu' counts as
		     naming one, which is what lets an app be SkiaSharp-free. Listing both references both, and Skia
		     still renders by default; the head opts into WebGPU on the host builder. WinAppSDK renders with
		     WinUI, so nothing is implied there: a Windows head that uses SKCanvasElement lists 'skia'. The
		     legacy 'nativerenderer' token is ignored, and 'skiarenderer' is mapped to 'skia' for backwards
		     compatibility. 'lottie' is ignored too: Lottie is built into Uno.WinUI. -->
		<UnoFeatures>$(UnoFeatures.Replace(';nativerenderer;', ';'))</UnoFeatures>
		<UnoFeatures>$(UnoFeatures.Replace(';lottie;', ';'))</UnoFeatures>
		<UnoFeatures>$(UnoFeatures.Replace(';skiarenderer;', ';skia;'))</UnoFeatures>
		<UnoFeatures Condition="!$(UnoFeatures.Contains(';skia;')) And !$(UnoFeatures.Contains(';webgpu;')) And '$(IsWinAppSdk)' != 'true'">$(UnoFeatures)skia;</UnoFeatures>
		<!-- WebGpuCanvasElement draws only with the WebGPU backend, so 'webgpucanvas' brings it in. It is added after
		     the renderer default above, so it adds WebGPU next to Skia rather than replacing it. -->
		<UnoFeatures Condition="$(UnoFeatures.Contains(';webgpucanvas;')) And !$(UnoFeatures.Contains(';webgpu;')) And '$(IsWinAppSdk)' != 'true'">$(UnoFeatures)webgpu;</UnoFeatures>
	</PropertyGroup>

	<PropertyGroup Condition="$(UnoFeatures.Contains(';mauiembedding;'))">
		<UseMaui>true</UseMaui>
	</PropertyGroup>

	<!--
		MauiHandlers: MAUI controls and libraries run on Uno through Uno.Maui.Embedding / Uno.Maui.Handlers, which rewrite the Windows builds of the official MAUI assemblies.
		- MAUI itself must be the version the rewrite rules are written for, not the one of the mauiembedding feature (override with MauiVersion).
		- A control library that ships only platform builds (no neutral net*) has no asset for an Uno head, and restore stops with NU1202: its Windows build is the fallback.
		  This has to be set here: a package's own build files are not imported until its first restore succeeded.
		- UseMaui stays off: the project is an Uno project, not a MAUI one (the package turns off MAUI's global usings and default XAML items by itself).
	-->
	<PropertyGroup Condition="$(UnoFeatures.Contains(';mauihandlers;'))">
		<MauiVersion Condition="'$(MauiVersion)' == ''">10.0.101</MauiVersion>
		<AssetTargetFallback>$(AssetTargetFallback);net10.0-windows10.0.19041.0;net10.0-windows10.0.19041;net10.0-windows;net9.0-windows10.0.19041.0;net8.0-windows10.0.19041.0;net7.0-windows10.0.19041.0;net6.0-windows10.0.19041.0</AssetTargetFallback>
	</PropertyGroup>

</Project>
