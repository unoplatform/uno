<Project>
	<!--
		Include all required PackageReference to be available before any target is executed
		in order for VS and C# Dev Kit to show nuget references in their respective solution explorers.
		The version is not required, and VS/Code waits for some design-time targets to be executed to evaluate it.
	-->
	<Import Project="$(MSBuildThisFileDirectory)Uno.Implicit.Packages.ProjectSystem.Uno.targets" />

	<ItemGroup Condition="$(UnoFeatures.Contains(';glcanvas;'))">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Graphics3DGL" ProjectSystem="true" />
	</ItemGroup>

	<ItemGroup Condition="$(UnoFeatures.Contains(';mediaplayerelement;')) OR $(UnoFeatures.Contains(';mediaelement;'))">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.MediaPlayer.Win32" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.MediaPlayer.X11" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="VideoLAN.LibVLC.Windows" ProjectSystem="true" />
	</ItemGroup>

	<PropertyGroup>
		<UnoWebView2Aliases Condition=" '$(UnoWebView2Aliases)' == '' ">mswebview2</UnoWebView2Aliases>
	</PropertyGroup>

	<ItemGroup Condition="$(UnoFeatures.Contains(';webview;'))">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.WebView.X11" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="Microsoft.Web.WebView2" ProjectSystem="true" Aliases="$(UnoWebView2Aliases)" />
	</ItemGroup>

	<ItemGroup Condition="$(_IsExecutable) == 'true'">
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Runtime.Linux.FrameBuffer" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Runtime.MacOS" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Runtime.Win32" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="Uno.WinUI.Runtime.X11" ProjectSystem="true" />

		<!-- Native libraries are referenced explicitly rather than left to the managed SkiaSharp / HarfBuzzSharp
		     packages' own dependencies. HarfBuzz shapes text for the font providers in Uno.WinUI; Skia is the skia feature's. -->
		<_UnoProjectSystemPackageReference Include="HarfBuzzSharp.NativeAssets.Win32" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="HarfBuzzSharp.NativeAssets.macOS" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="HarfBuzzSharp.NativeAssets.Linux" ProjectSystem="true" />
		<_UnoProjectSystemPackageReference Include="SkiaSharp.NativeAssets.Win32" ProjectSystem="true" Condition="$(UnoFeatures.Contains(';skia;'))" />
		<_UnoProjectSystemPackageReference Include="SkiaSharp.NativeAssets.macOS" ProjectSystem="true" Condition="$(UnoFeatures.Contains(';skia;'))" />
		<_UnoProjectSystemPackageReference Include="SkiaSharp.NativeAssets.Linux" ProjectSystem="true" Condition="$(UnoFeatures.Contains(';skia;'))" />
	</ItemGroup>
</Project>
