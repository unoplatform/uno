<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<IsUnoHead Condition="'$(OutputType)'=='Exe' OR '$(OutputType)'=='WinExe'">true</IsUnoHead>
	</PropertyGroup>

	<Target Name="_UnoSkiaWin32FeatureDefines" AfterTargets="PrepareForBuild">

		<PropertyGroup>
			<DefineConstants>$(DefineConstants);UNO_REFERENCE_API;HAS_UNO_SKIA;HAS_UNO_SKIA_WIN32;__DESKTOP__;__UNO_SKIA__;__UNO_SKIA_WIN32__</DefineConstants>
		</PropertyGroup>

	</Target>

	<!-- Copy Content files to the output folder like APPX packaging does. -->
	<Target Name="_UnoBeforeCopyLocal" BeforeTargets="CopyFilesToOutputDirectory;_CopyFilesMarkedCopyLocal">
		<ItemGroup>
			<ContentWithTargetPath
				Update="@(ContentWithTargetPath)"
				CopyToOutputDirectory="Always" />
		</ItemGroup>
	</Target>

	<Target Name="_UnoIncludeWin32AppNotificationAssets" BeforeTargets="AssignTargetPaths" Condition="'$(IsUnoHead)'=='true'">
		<PropertyGroup>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.EndsWith('-x86'))">x86</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.EndsWith('-x64'))">x64</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.EndsWith('-arm64'))">arm64</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(_UnoWin32AppRuntimeArchitecture)' == '' and ('$(PlatformTarget)' == 'x86' or '$(Platform)' == 'x86' or '$(Platform)' == 'Win32')">x86</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(_UnoWin32AppRuntimeArchitecture)' == '' and ('$(PlatformTarget)' == 'x64' or '$(Platform)' == 'x64')">x64</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(_UnoWin32AppRuntimeArchitecture)' == '' and ('$(PlatformTarget)' == 'arm64' or '$(Platform)' == 'arm64')">arm64</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(_UnoWin32AppRuntimeArchitecture)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-x86'">x86</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(_UnoWin32AppRuntimeArchitecture)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">x64</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeArchitecture Condition="'$(_UnoWin32AppRuntimeArchitecture)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">arm64</_UnoWin32AppRuntimeArchitecture>
			<_UnoWin32AppRuntimeBootstrapPath Condition="'$(_UnoWin32AppRuntimeArchitecture)' != ''">$(MSBuildThisFileDirectory)..\runtimes\win-$(_UnoWin32AppRuntimeArchitecture)\native\Microsoft.WindowsAppRuntime.Bootstrap.dll</_UnoWin32AppRuntimeBootstrapPath>
		</PropertyGroup>
		<Error
			Condition="'$(_UnoWin32AppRuntimeArchitecture)' == '' and $([MSBuild]::IsOsPlatform('Windows'))"
			Text="Unable to determine the Windows architecture for Microsoft.WindowsAppRuntime.Bootstrap.dll." />
		<Error
			Condition="'$(_UnoWin32AppRuntimeBootstrapPath)' != '' and !Exists('$(_UnoWin32AppRuntimeBootstrapPath)')"
			Text="The Windows App SDK bootstrap DLL was not found at '$(_UnoWin32AppRuntimeBootstrapPath)'." />
		<ItemGroup>
			<Content Include="$(_UnoWin32AppRuntimeBootstrapPath)" Condition="'$(_UnoWin32AppRuntimeBootstrapPath)' != ''">
				<TargetPath>Microsoft.WindowsAppRuntime.Bootstrap.dll</TargetPath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</Content>
			<Content Include="$(MSBuildThisFileDirectory)..\runtimes\win\native\Microsoft.Windows.AppNotifications.winmd" Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\win\native\Microsoft.Windows.AppNotifications.winmd')">
				<TargetPath>Microsoft.Windows.AppNotifications.winmd</TargetPath>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</Content>
		</ItemGroup>
	</Target>

</Project>
