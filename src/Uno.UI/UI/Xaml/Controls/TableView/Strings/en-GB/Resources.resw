  <!-- Group header fallback strings -->
  <data name="TableViewGroupHeaderCountFormat" xml:space="preserve">
    <value>({0})</value>
    <comment>Format string for the item count shown in group headers. {0} is the culture-formatted item count.</comment>
  </data>
  <data name="TableViewGroupHeaderNull" xml:space="preserve">
    <value>(null)</value>
    <comment>Placeholder text shown in group headers when the grouping key is null.</comment>
  </data>
