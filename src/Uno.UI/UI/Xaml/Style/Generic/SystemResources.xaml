<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<Thickness x:Key="ProgressBarBorderThemeThickness">0</Thickness>

			<Color x:Key="SystemAccentColor">#FF0078D7</Color>
			<Color x:Key="SystemAccentColorDark1">#FF005A9E</Color>
			<Color x:Key="SystemAccentColorDark2">#FF004275</Color>
			<Color x:Key="SystemAccentColorDark3">#FF002642</Color>
			<Color x:Key="SystemAccentColorLight1">#FF429CE3</Color>
			<Color x:Key="SystemAccentColorLight2">#FF76B9ED</Color>
			<Color x:Key="SystemAccentColorLight3">#FFA6D8FF</Color>
			<Color x:Key="SystemColorButtonFaceColor">#FFF0F0F0</Color>
			<Color x:Key="SystemColorButtonTextColor">#FF000000</Color>
			<SolidColorBrush x:Key="SystemColorControlAccentBrush" Color="{StaticResource SystemAccentColor}" />
			<Color x:Key="SystemColorGrayTextColor">#FF6D6D6D</Color>
			<Color x:Key="SystemColorHighlightColor">#FF3399FF</Color>
			<Color x:Key="SystemColorHighlightTextColor">#FFFFFFFF</Color>
			<Color x:Key="SystemColorHotlightColor">#FF0066CC</Color>
			<Color x:Key="SystemColorWindowColor">#FFFFFFFF</Color>
			<Color x:Key="SystemColorWindowTextColor">#FF000000</Color>
		</ResourceDictionary>

		<ResourceDictionary x:Key="HighContrast">
			<Thickness x:Key="ProgressBarBorderThemeThickness">1</Thickness>

			<Color x:Key="SystemAccentColor">#FF0078D7</Color>
			<Color x:Key="SystemAccentColorDark1">#FF005A9E</Color>
			<Color x:Key="SystemAccentColorDark2">#FF004275</Color>
			<Color x:Key="SystemAccentColorDark3">#FF002642</Color>
			<Color x:Key="SystemAccentColorLight1">#FF429CE3</Color>
			<Color x:Key="SystemAccentColorLight2">#FF76B9ED</Color>
			<Color x:Key="SystemAccentColorLight3">#FFA6D8FF</Color>
			<Color x:Key="SystemColorButtonFaceColor">#FF000000</Color>
			<Color x:Key="SystemColorButtonTextColor">#FFFFFFFF</Color>
			<SolidColorBrush x:Key="SystemColorControlAccentBrush" Color="{StaticResource SystemAccentColor}" />
			<Color x:Key="SystemColorGrayTextColor">#FF3FF23F</Color>
			<Color x:Key="SystemColorHighlightColor">#FF1AEBFF</Color>
			<Color x:Key="SystemColorHighlightTextColor">#FF000000</Color>
			<Color x:Key="SystemColorHotlightColor">#FFFFFF00</Color>
			<Color x:Key="SystemColorWindowColor">#FF000000</Color>
			<Color x:Key="SystemColorWindowTextColor">#FF000000</Color>
		</ResourceDictionary>

		<ResourceDictionary x:Key="Light">
			<Thickness x:Key="ProgressBarBorderThemeThickness">0</Thickness>

			<Color x:Key="SystemAccentColor">#FF0078D7</Color>
			<Color x:Key="SystemAccentColorDark1">#FF005A9E</Color>
			<Color x:Key="SystemAccentColorDark2">#FF004275</Color>
			<Color x:Key="SystemAccentColorDark3">#FF002642</Color>
			<Color x:Key="SystemAccentColorLight1">#FF429CE3</Color>
			<Color x:Key="SystemAccentColorLight2">#FF76B9ED</Color>
			<Color x:Key="SystemAccentColorLight3">#FFA6D8FF</Color>
			<Color x:Key="SystemColorButtonFaceColor">#FF000000</Color>
			<Color x:Key="SystemColorButtonTextColor">#FFFFFFFF</Color>
			<SolidColorBrush x:Key="SystemColorControlAccentBrush" Color="{StaticResource SystemAccentColor}" />
			<Color x:Key="SystemColorGrayTextColor">#FF3FF23F</Color>
			<Color x:Key="SystemColorHighlightColor">#FF1AEBFF</Color>
			<Color x:Key="SystemColorHighlightTextColor">#FF000000</Color>
			<Color x:Key="SystemColorHotlightColor">#FFFFFF00</Color>
			<Color x:Key="SystemColorWindowColor">#FF000000</Color>
			<Color x:Key="SystemColorWindowTextColor">#FF000000</Color>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<x:Double x:Key="SliderHorizontalThumbHeight">18</x:Double>
	<x:Double x:Key="SliderHorizontalThumbWidth">18</x:Double>
</ResourceDictionary>
