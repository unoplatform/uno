<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <PropertyGroup>
	  <_Uno_XamlMerge_Task_Version>1.27.0-dev.44</_Uno_XamlMerge_Task_Version>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Uno.XamlMerge.Task" Version="$(_Uno_XamlMerge_Task_Version)" />
  </ItemGroup>

  <PropertyGroup>
	<XamlMergeOutputFile>$(MSBuildProjectDirectory)\UI\Xaml\Style\mergedstyles.xaml</XamlMergeOutputFile>
  </PropertyGroup>

  <ItemGroup>
	  <!--
		Keep the imported WinUI Generic.xaml as the base dictionary so the merged
		Uno and MUX control dictionaries can override its resources. SystemResources.xaml
		provides Uno system values that WinUI resolves natively, and stays out of the merge
		so its resources remain overridable (see the When_Theme_Changed_Animated_Value test).

		The override only works while Generic.xaml is registered into MasterDictionary before
		mergedstyles.xaml, since the last merged dictionary wins. That ordering comes from the
		generator and is guarded by
		Given_GenericResources.When_ScrollViewer_Compatibility_Style_Is_Applied.
	  -->
	  <_NonMergedXamlResources Include="$(MSBuildProjectDirectory)\UI\Xaml\Style\Generic\Generic.xaml" />
	  <_NonMergedXamlResources Include="$(MSBuildProjectDirectory)\UI\Xaml\Style\Generic\SystemResources.xaml" />
  </ItemGroup>

  <Import Project="$(NuGetPackageRoot)\uno.xamlmerge.task\$(_Uno_XamlMerge_Task_Version)\build\Uno.XamlMerge.Task.targets"
				  Condition="'$(TargetFramework)' == '' and exists('$(NuGetPackageRoot)\uno.xamlmerge.task\$(_Uno_XamlMerge_Task_Version)')" />

  <Target Name="_GenerateMergedXaml"
				  DependsOnTargets="GenerateMergedXaml"
				  BeforeTargets="DispatchToInnerBuilds"
				  Condition="'$(TargetFramework)' == '' and exists('$(NuGetPackageRoot)\uno.xamlmerge.task\$(_Uno_XamlMerge_Task_Version)')">
  </Target>

</Project>
