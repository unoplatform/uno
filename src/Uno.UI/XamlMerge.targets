<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <ItemGroup>
	  <PackageReference Include="Uno.XamlMerge.Task" />
  </ItemGroup>

  <PropertyGroup>
	<XamlMergeOutputFile>$(MSBuildProjectDirectory)\UI\Xaml\Style\mergedstyles.xaml</XamlMergeOutputFile>
  </PropertyGroup>

  <ItemGroup>
	  <!--
		Keep the imported WinUI Generic.xaml as the base dictionary so the merged
		Uno and MUX control dictionaries can override its resources. SystemResources.xaml
		provides Uno system values that WinUI resolves natively.
	  -->
	  <_NonMergedXamlResources Include="$(MSBuildProjectDirectory)\UI\Xaml\Style\Generic\Generic.xaml" />
	  <_NonMergedXamlResources Include="$(MSBuildProjectDirectory)\UI\Xaml\Style\Generic\SystemResources.xaml" />
  </ItemGroup>

  <Import Project="$(NuGetPackageRoot)\uno.xamlmerge.task\$(UnoXamlMergeTaskVersion)\build\Uno.XamlMerge.Task.targets"
				  Condition="'$(TargetFramework)' == '' and exists('$(NuGetPackageRoot)\uno.xamlmerge.task\$(UnoXamlMergeTaskVersion)')" />

  <Target Name="_GenerateMergedXaml"
				  DependsOnTargets="GenerateMergedXaml"
				  BeforeTargets="DispatchToInnerBuilds"
				  Condition="'$(TargetFramework)' == '' and exists('$(NuGetPackageRoot)\uno.xamlmerge.task\$(UnoXamlMergeTaskVersion)')">
  </Target>

</Project>
