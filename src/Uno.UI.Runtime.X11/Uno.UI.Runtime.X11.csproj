<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetSkiaPreviousAndCurrent)</TargetFrameworks>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<Import Project="../targetframework-override-noplatform.props" />

	<PropertyGroup>
		<GeneratePackageOnBuild Condition="'$(Configuration)'=='Release'">true</GeneratePackageOnBuild>
		<Description>This package provides the X11 host for Uno Platform projects.</Description>

		<PackageId>Uno.WinUI.Runtime.X11</PackageId>

		<RootNamespace>Uno.UI.Runtime.X11</RootNamespace>

		<UseCommonOverridePackage>true</UseCommonOverridePackage>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Common\uno.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Tmds.DBus.Protocol" />
		<PackageReference Include="Tmds.DBus.Generator" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="dbus-interfaces/org.freedesktop.DBus.xml" Namespace="Uno.UI.Runtime.X11.DBus" GenerateDBusTypes="true" />
		<AdditionalFiles Include="dbus-interfaces/org.freedesktop.portal.FileChooser.xml" Namespace="Uno.UI.Runtime.X11.DBus" GenerateDBusTypes="true" />
		<AdditionalFiles Include="dbus-interfaces/org.freedesktop.portal.Request.xml" Namespace="Uno.UI.Runtime.X11.DBus" GenerateDBusTypes="true" />
		<AdditionalFiles Include="dbus-interfaces/org.freedesktop.portal.Settings.xml" Namespace="Uno.UI.Runtime.X11.DBus" GenerateDBusTypes="true" />
		<AdditionalFiles Include="dbus-interfaces/org.freedesktop.IBus.Portal.xml" Namespace="Uno.UI.Runtime.X11.DBus.IBus" GenerateDBusTypes="true" />
		<AdditionalFiles Include="dbus-interfaces/org.fcitx.Fcitx.InputMethod1.xml" Namespace="Uno.UI.Runtime.X11.DBus.Fcitx" GenerateDBusTypes="true" />
		<AdditionalFiles Include="dbus-interfaces/org.fcitx.Fcitx.InputContext1.xml" Namespace="Uno.UI.Runtime.X11.DBus.Fcitx" GenerateDBusTypes="true" />
		<AdditionalFiles Include="dbus-interfaces/org.fcitx.Fcitx.InputMethod.xml" Namespace="Uno.UI.Runtime.X11.DBus.Fcitx" GenerateDBusTypes="true" />
		<AdditionalFiles Include="dbus-interfaces/org.fcitx.Fcitx.InputContext.xml" Namespace="Uno.UI.Runtime.X11.DBus.Fcitx" GenerateDBusTypes="true" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="HarfbuzzSharp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.Runtime\Uno.UI.Runtime.csproj" />
		<!-- WebGPU "init half": the host calls WebGpuContext.Create* to build a WebGpu window+context for the
		     GraphicsContextKind.WebGpu kind. The host uses only the renderer-agnostic init API, not the renderer. -->
		<ProjectReference Include="..\Uno.UI.Composition.WebGpu.Init\Uno.UI.Composition.WebGpu.Init.csproj" />
		<ProjectReference Include="..\Uno.Foundation\Uno.Foundation.Generic.csproj" TreatAsPackageReference="false" PrivateAssets="all" />
		<ProjectReference Include="..\Uno.UI\Uno.UI.csproj" />
		<ProjectReference Include="..\Uno.WinRT\Uno.WinRT.Generic.csproj" TreatAsPackageReference="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="buildTransitive/*.*">
			<Pack>true</Pack>
			<PackagePath>buildTransitive</PackagePath>
		</Content>
	</ItemGroup>
</Project>
