<Project>
	<!-- Fetches the pinned wgpu-native (modern webgpu.h ABI) release for the host OS/arch and drops the native
	     library next to the consuming output so the DllImportResolver ("webgpu") finds it. Import this from the
	     WebGpu backend project and from any app head that renders with the WebGPU backend. Cached under obj/. -->
	<PropertyGroup>
		<WgpuNativeVersion>v29.0.1.1</WgpuNativeVersion>
		<WgpuNativeCacheDir>$(MSBuildThisFileDirectory)obj\wgpu-native\$(WgpuNativeVersion)\</WgpuNativeCacheDir>
	</PropertyGroup>

	<!-- The Apple mobile SDKs (Xamarin.MacDev.Tasks) register their own "Unzip" task with different parameters,
	     shadowing MSBuild's built-in. Register the built-in under its full name and invoke it fully-qualified. -->
	<UsingTask TaskName="Microsoft.Build.Tasks.Unzip" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll" />

	<!-- Pick the native by the target RuntimeIdentifier when set (so a cross-publish, e.g. Linux -> win-x64, gets the
	     right binary), else fall back to the build host OS/arch. Target-scoped properties persist once this runs, so
	     both the build-copy and the publish-item targets below can depend on it. -->
	<Target Name="_SelectWgpuAsset">
		<PropertyGroup>
			<_WgpuTpi>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_WgpuTpi>
			<!-- TPIs with dedicated provisioning (Android per-ABI .so, iOS/tvOS static .a) must never take the
			     host-OS desktop fallback: the desktop binary would leak into the app package (see the Android
			     libdl.so.2 incident) or double-provision next to the static link. -->
			<_WgpuHostFallbackAllowed>true</_WgpuHostFallbackAllowed>
			<_WgpuHostFallbackAllowed Condition="'$(_WgpuTpi)' == 'android' Or '$(_WgpuTpi)' == 'ios' Or '$(_WgpuTpi)' == 'tvos' Or '$(_WgpuTpi)' == 'maccatalyst'">false</_WgpuHostFallbackAllowed>
		</PropertyGroup>
		<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
			<_WgpuAsset>wgpu-windows-x86_64-msvc-release.zip</_WgpuAsset>
			<_WgpuNativeFile>wgpu_native.dll</_WgpuNativeFile>
		</PropertyGroup>
		<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
			<_WgpuAsset>wgpu-linux-x86_64-release.zip</_WgpuAsset>
			<_WgpuNativeFile>libwgpu_native.so</_WgpuNativeFile>
		</PropertyGroup>
		<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
			<_WgpuAsset>wgpu-macos-aarch64-release.zip</_WgpuAsset>
			<_WgpuNativeFile>libwgpu_native.dylib</_WgpuNativeFile>
		</PropertyGroup>
		<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
			<_WgpuAsset>wgpu-macos-x86_64-release.zip</_WgpuAsset>
			<_WgpuNativeFile>libwgpu_native.dylib</_WgpuNativeFile>
		</PropertyGroup>

		<!-- Host-OS fallbacks (no RID). These MUST NOT engage on an Android head: it imports this .targets too, and
		     Android is multi-ABI via _ProvisionWgpuNativeAndroid / @(AndroidNativeLibrary). Without the android exclusion
		     the Linux/Windows host .so leaks into the head's OutDir and gets packaged into every APK lib/<abi>/, shadowing
		     the real bionic per-ABI binaries (dlopen then fails: the desktop .so needs glibc's libdl.so.2). -->
		<PropertyGroup Condition="'$(_WgpuAsset)' == '' And $([MSBuild]::IsOSPlatform('Linux')) And '$(_WgpuHostFallbackAllowed)' == 'true'">
			<_WgpuAsset>wgpu-linux-x86_64-release.zip</_WgpuAsset>
			<_WgpuNativeFile>libwgpu_native.so</_WgpuNativeFile>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_WgpuAsset)' == '' And $([MSBuild]::IsOSPlatform('Windows')) And '$(_WgpuHostFallbackAllowed)' == 'true'">
			<_WgpuAsset>wgpu-windows-x86_64-msvc-release.zip</_WgpuAsset>
			<_WgpuNativeFile>wgpu_native.dll</_WgpuNativeFile>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_WgpuAsset)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64' And '$(_WgpuHostFallbackAllowed)' == 'true'">
			<_WgpuAsset>wgpu-macos-aarch64-release.zip</_WgpuAsset>
			<_WgpuNativeFile>libwgpu_native.dylib</_WgpuNativeFile>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_WgpuAsset)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64' And '$(_WgpuHostFallbackAllowed)' == 'true'">
			<_WgpuAsset>wgpu-macos-x86_64-release.zip</_WgpuAsset>
			<_WgpuNativeFile>libwgpu_native.dylib</_WgpuNativeFile>
		</PropertyGroup>
	</Target>

	<!-- Download + unzip the pinned release into the obj cache (once; OS-agnostic HTTP + unzip, so cross-provisioning
	     the Windows dll from a Linux host works). No target-level Condition on $(_WgpuAsset): a target's Condition is
	     evaluated BEFORE its DependsOnTargets run, so it would still be empty here — the task-level conditions below
	     (evaluated after _SelectWgpuAsset has run) are the correct guard. -->
	<Target Name="_FetchWgpuNative" DependsOnTargets="_SelectWgpuAsset">
		<MakeDir Directories="$(WgpuNativeCacheDir)" Condition="'$(_WgpuAsset)' != ''" />
		<DownloadFile Condition="'$(_WgpuAsset)' != '' And !Exists('$(WgpuNativeCacheDir)$(_WgpuAsset)')"
			SourceUrl="https://github.com/gfx-rs/wgpu-native/releases/download/$(WgpuNativeVersion)/$(_WgpuAsset)"
			DestinationFolder="$(WgpuNativeCacheDir)" Retries="3" />
		<Microsoft.Build.Tasks.Unzip Condition="'$(_WgpuAsset)' != '' And !Exists('$(WgpuNativeCacheDir)lib\$(_WgpuNativeFile)')"
			SourceFiles="$(WgpuNativeCacheDir)$(_WgpuAsset)" DestinationFolder="$(WgpuNativeCacheDir)" />
	</Target>

	<!-- Run-from-build: drop the native next to the build output so the DllImportResolver finds it when running the
	     app straight out of bin/. Guard on OutDir (AfterTargets=Build also fires in the outer multi-TFM pass where
	     OutDir is empty → an unguarded Copy throws MSB3023). Only for app heads (OutputType != Library): a referenced
	     library would otherwise leave a loose desktop .so next to its dll, which .NET-Android harvests transitively and
	     packs into every APK lib/<abi>/, shadowing the real per-ABI bionic binaries (dlopen then fails on libdl.so.2). -->
	<Target Name="ProvisionWgpuNative" AfterTargets="Build" DependsOnTargets="_FetchWgpuNative">
		<Message Importance="high" Text="ProvisionWgpuNative: asset=$(_WgpuAsset) outputType=$(OutputType) -> $(OutDir)" />
		<Copy Condition="'$(_WgpuAsset)' != '' And '$(OutDir)' != '' And '$(OutputType)' != 'Library'"
			SourceFiles="$(WgpuNativeCacheDir)lib\$(_WgpuNativeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

	<!-- Publish: register the native as a real publish item so `dotnet publish` (incl. `-o <dir>` and self-contained)
	     copies it to the publish root. A loose file in OutDir is NOT a tracked publish item, so it would otherwise be
	     dropped from the published output (the DllNotFound the WebGPU head hit on Windows). AfterTargets so it appends
	     to the ResolvedFileToPublish that ComputeFilesToPublish just built, before the copy targets consume it. -->
	<Target Name="_AddWgpuNativeToPublish" AfterTargets="ComputeFilesToPublish" DependsOnTargets="_FetchWgpuNative">
		<ItemGroup>
			<ResolvedFileToPublish Include="$(WgpuNativeCacheDir)lib\$(_WgpuNativeFile)" Condition="'$(_WgpuNativeFile)' != ''">
				<RelativePath>$(_WgpuNativeFile)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<!-- Android is multi-ABI: fetch libwgpu_native.so for every ABI and add each as an @(AndroidNativeLibrary) with
	     its Abi so the .NET-Android build packs it into the APK's lib/<abi>/. The DllImportResolver's bare-name
	     "libwgpu_native.so" then resolves via the Android loader. Import this .targets into the android app head so
	     the items land in the APK build. Runs before assembly resolution so the native-lib collection sees them. -->
	<Target Name="_ProvisionWgpuNativeAndroid"
			BeforeTargets="_ResolveAssemblies;_ConvertResourcesCases;BeforeBuild"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ItemGroup>
			<_WgpuAndroidAbi Include="aarch64"><Abi>arm64-v8a</Abi></_WgpuAndroidAbi>
			<_WgpuAndroidAbi Include="armv7"><Abi>armeabi-v7a</Abi></_WgpuAndroidAbi>
			<_WgpuAndroidAbi Include="x86_64"><Abi>x86_64</Abi></_WgpuAndroidAbi>
			<_WgpuAndroidAbi Include="i686"><Abi>x86</Abi></_WgpuAndroidAbi>
		</ItemGroup>
		<MakeDir Directories="$(WgpuNativeCacheDir)android\%(_WgpuAndroidAbi.Identity)\" />
		<DownloadFile Condition="!Exists('$(WgpuNativeCacheDir)android\%(_WgpuAndroidAbi.Identity)\wgpu-android-%(_WgpuAndroidAbi.Identity)-release.zip')"
			SourceUrl="https://github.com/gfx-rs/wgpu-native/releases/download/$(WgpuNativeVersion)/wgpu-android-%(_WgpuAndroidAbi.Identity)-release.zip"
			DestinationFolder="$(WgpuNativeCacheDir)android\%(_WgpuAndroidAbi.Identity)\" Retries="3" />
		<Microsoft.Build.Tasks.Unzip Condition="!Exists('$(WgpuNativeCacheDir)android\%(_WgpuAndroidAbi.Identity)\lib\libwgpu_native.so')"
			SourceFiles="$(WgpuNativeCacheDir)android\%(_WgpuAndroidAbi.Identity)\wgpu-android-%(_WgpuAndroidAbi.Identity)-release.zip"
			DestinationFolder="$(WgpuNativeCacheDir)android\%(_WgpuAndroidAbi.Identity)\" />
		<ItemGroup>
			<AndroidNativeLibrary Include="$(WgpuNativeCacheDir)android\%(_WgpuAndroidAbi.Identity)\lib\libwgpu_native.so">
				<Abi>%(_WgpuAndroidAbi.Abi)</Abi>
			</AndroidNativeLibrary>
		</ItemGroup>
	</Target>

	<!-- iOS/tvOS is STATIC-linked: Apple forbids dlopen'ing arbitrary dylibs, so wgpu-native ships a static
	     libwgpu_native.a per slice. Link it into the app with @(NativeReference Kind=Static ForceLoad=true) so its
	     symbols land in the main program image; WebGpuLoader.Resolve then returns NativeLibrary.GetMainProgramHandle()
	     for "webgpu". Pick the slice by RuntimeIdentifier (device vs simulator, arm64 vs x64). Import this .targets
	     into the iOS app head. Not yet verified on-device — verify on a Mac that (a) the release zip
	     lays the archive at lib/libwgpu_native.a, and (b) the Rust static lib's system deps are satisfied — the iOS
	     workload auto-links Metal/Foundation/QuartzCore, but wgpu may additionally need libc++/libresolv; add
	     @(NativeReference Include="c++") / frameworks here if the link fails with undefined symbols.
	     Asset names confirmed at v29.0.1.1: wgpu-ios-aarch64-release, wgpu-ios-aarch64-simulator-release,
	     wgpu-ios-x86_64-simulator-release. -->
	<!-- BeforeTargets must include _SanitizeNativeReferences: that's the first Apple-SDK target to read
	     @(NativeReference) (feeding _ExpandNativeReferences); items added only before BeforeBuild arrive too late
	     and the static lib silently never reaches the native link. -->
	<Target Name="_ProvisionWgpuNativeIos"
			BeforeTargets="_SanitizeNativeReferences;_ExpandNativeReferences;_ResolveAssemblies;BeforeBuild"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">
		<PropertyGroup>
			<_WgpuIosSlice Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">aarch64</_WgpuIosSlice>
			<_WgpuIosSlice Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64'">aarch64-simulator</_WgpuIosSlice>
			<_WgpuIosSlice Condition="'$(RuntimeIdentifier)' == 'iossimulator-x64'">x86_64-simulator</_WgpuIosSlice>
			<!-- Default to the device slice when the RID isn't set yet (outer restore/build pass). -->
			<_WgpuIosSlice Condition="'$(_WgpuIosSlice)' == ''">aarch64</_WgpuIosSlice>
			<_WgpuIosZip>wgpu-ios-$(_WgpuIosSlice)-release.zip</_WgpuIosZip>
			<_WgpuIosDir>$(WgpuNativeCacheDir)ios\$(_WgpuIosSlice)\</_WgpuIosDir>
		</PropertyGroup>
		<MakeDir Directories="$(_WgpuIosDir)" />
		<DownloadFile Condition="!Exists('$(_WgpuIosDir)$(_WgpuIosZip)')"
			SourceUrl="https://github.com/gfx-rs/wgpu-native/releases/download/$(WgpuNativeVersion)/$(_WgpuIosZip)"
			DestinationFolder="$(_WgpuIosDir)" Retries="3" />
		<Microsoft.Build.Tasks.Unzip Condition="!Exists('$(_WgpuIosDir)lib\libwgpu_native.a')"
			SourceFiles="$(_WgpuIosDir)$(_WgpuIosZip)" DestinationFolder="$(_WgpuIosDir)" />
		<ItemGroup>
			<NativeReference Include="$(_WgpuIosDir)lib\libwgpu_native.a">
				<Kind>Static</Kind>
				<ForceLoad>True</ForceLoad>
				<SmartLink>False</SmartLink>
			</NativeReference>
		</ItemGroup>
		<!-- The final link uses -dead_strip and -exported_symbols_list (mtouch-symbols.list): a force_load'ed static
		     lib's symbols are NOT exported unless listed, and the SDK's automatic list only covers __Internal
		     DllImports — ours say "webgpu" and resolve at runtime through NativeLibrary.GetMainProgramHandle(),
		     i.e. dlsym on the main image, which only sees EXPORTED symbols. Enumerate the archive's public wgpu*
		     symbols (macOS `nm`; iOS links only happen with an Apple toolchain) and declare them as
		     @(ReferenceNativeSymbol) so the bundler exports them. -->
		<Exec Condition="$([MSBuild]::IsOSPlatform('OSX')) And !Exists('$(_WgpuIosDir)wgpu.symbols')"
			Command="nm -gUj '$(_WgpuIosDir)lib/libwgpu_native.a' 2>/dev/null | grep '^_wgpu' | sed 's/^_//' | sort -u &gt; '$(_WgpuIosDir)wgpu.symbols'" />
		<ReadLinesFromFile File="$(_WgpuIosDir)wgpu.symbols" Condition="Exists('$(_WgpuIosDir)wgpu.symbols')">
			<Output TaskParameter="Lines" ItemName="_WgpuExportedSymbol" />
		</ReadLinesFromFile>
		<ItemGroup>
			<ReferenceNativeSymbol Include="@(_WgpuExportedSymbol)" SymbolType="Function" />
		</ItemGroup>
	</Target>
</Project>
