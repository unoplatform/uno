<Project>

	<!--
	Drops the wgpu native payload from an app that cannot reach the WebGPU backend.

	Skia renders by default wherever it is referenced (UnoPlatformHostBuilder.TryLightUpGraphicsBackend), so an app
	that names both features only gets WebGPU if its own code registers it on the host builder. That is a compile-time
	fact: registering means naming a type from Uno.UI.Composition.WebGpu, which puts the assembly in the compiled
	AssemblyRef table. When no app assembly names it, the backend is unreachable and its native is dead weight.

	Deliberately conservative: it only engages when Skia is also present (without Skia, WebGPU is the only renderer
	and the native is always required), and any doubt keeps the payload. Set UnoWebGpuForceNative=true to keep it
	regardless, e.g. when a NuGet library registers the backend on the app's behalf.
	-->

	<UsingTask TaskName="UnoDetectWebGpuUsage" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Assemblies ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<Used ParameterType="System.Boolean" Output="true" />
		</ParameterGroup>
		<Task>
			<Code Type="Fragment" Language="cs"><![CDATA[
				// A raw scan answers "does this assembly name the WebGPU backend" without a metadata reader in the
				// task; erring towards a match only keeps the payload, which is the safe direction. An assembly
				// reference stores the name UTF-8 (#Strings) and a reflective Type.GetType literal UTF-16 (#US).
				var needles = new byte[][]
				{
					System.Text.Encoding.UTF8.GetBytes("Uno.UI.Composition.WebGpu"),
					System.Text.Encoding.Unicode.GetBytes("Uno.UI.Composition.WebGpu"),
				};
				Used = false;
				foreach (var item in Assemblies)
				{
					var path = item.GetMetadata("FullPath");
					if (!System.IO.File.Exists(path))
					{
						continue;
					}

					byte[] bytes;
					try
					{
						bytes = System.IO.File.ReadAllBytes(path);
					}
					catch (System.IO.IOException)
					{
						// Unreadable means unknown, and unknown must keep the payload.
						Used = true;
						break;
					}

					foreach (var needle in needles)
					{
						for (var i = 0; i + needle.Length <= bytes.Length && !Used; i++)
						{
							var match = true;
							for (var j = 0; j < needle.Length; j++)
							{
								if (bytes[i + j] != needle[j]) { match = false; break; }
							}

							Used = match;
						}

						if (Used)
						{
							break;
						}
					}

					if (Used)
					{
						break;
					}
				}
			]]></Code>
		</Task>
	</UsingTask>

	<Target Name="_UnoWebGpuDetectUsage"
			AfterTargets="CoreCompile"
			Condition="'$(UnoWebGpuForceNative)' != 'true' And '@(IntermediateAssembly)' != ''">
		<!-- The app's own assemblies: the head plus anything it builds alongside. A registration can live in either. -->
		<ItemGroup>
			<_UnoWebGpuScan Include="@(IntermediateAssembly)" />
			<_UnoWebGpuScan Include="@(_ResolvedProjectReferencePaths)" />
		</ItemGroup>

		<UnoDetectWebGpuUsage Assemblies="@(_UnoWebGpuScan)" Condition="'@(_UnoWebGpuScan)' != ''">
			<Output TaskParameter="Used" PropertyName="_UnoWebGpuReferencedByApp" />
		</UnoDetectWebGpuUsage>

		<PropertyGroup>
			<!-- Only ever drop when Skia is present to render instead. -->
			<_UnoWebGpuSkiaPresent>false</_UnoWebGpuSkiaPresent>
			<_UnoWebGpuSkiaPresent Condition="$(UnoFeatures.Contains(';skia;'))">true</_UnoWebGpuSkiaPresent>
			<_UnoWebGpuNativeUnused Condition="'$(_UnoWebGpuReferencedByApp)' != 'true' And '$(_UnoWebGpuSkiaPresent)' == 'true'">true</_UnoWebGpuNativeUnused>
		</PropertyGroup>

		<Message Importance="normal" Condition="'$(_UnoWebGpuNativeUnused)' == 'true'"
				 Text="No app assembly references Uno.UI.Composition.WebGpu and Skia is present, so the wgpu native payload is omitted. Set UnoWebGpuForceNative=true to keep it." />
	</Target>

	<!-- Build output and publish resolve the payload through separate item lists, so both are filtered. -->
	<Target Name="_UnoWebGpuDropNativeFromOutput"
			AfterTargets="_UnoWebGpuDetectUsage"
			BeforeTargets="CopyFilesToOutputDirectory"
			Condition="'$(_UnoWebGpuNativeUnused)' == 'true'">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').Contains('wgpu_native'))" />
		</ItemGroup>
	</Target>

	<Target Name="_UnoWebGpuDropNativeFromPublish"
			AfterTargets="ComputeResolvedFilesToPublishList"
			Condition="'$(_UnoWebGpuNativeUnused)' == 'true'">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').Contains('wgpu_native'))" />
		</ItemGroup>
	</Target>

</Project>
