<Project>

	<!--
	Drops the wgpu native payload from an app that cannot reach it.

	Skia renders by default wherever it is referenced (UnoPlatformHostBuilder.TryLightUpGraphicsBackend), so an app
	that names both features reaches WebGPU only through its own code. DetectWebGpuUsage_v0 reads that out of the
	compiled metadata: a reference to a WebGPU assembly, a P/Invoke into the native module, or registering a graphics
	backend at all. That last one is deliberately broad, because the provider an app registers may be a WebGPU one we
	did not write, and metadata cannot say which it is.

	Every uncertainty keeps the payload, including an assembly that cannot be read. UnoWebGpuForceNative=true keeps it
	outright, for a registration that lives in a NuGet package where this cannot see it. To drop it deliberately, do
	not name the webgpu feature.
	-->

	<UsingTask TaskName="Uno.Sdk.Tasks.DetectWebGpuUsage_v0" AssemblyFile="$(UnoSdkTasksAssembly)"
			   Condition="'$(UnoSdkTasksAssembly)' != '' And Exists('$(UnoSdkTasksAssembly)')" />

	<Target Name="_UnoWebGpuDetectUsage"
			AfterTargets="CoreCompile"
			Condition="'$(UnoWebGpuForceNative)' != 'true' And '@(IntermediateAssembly)' != ''
					   And '$(UnoSdkTasksAssembly)' != '' And Exists('$(UnoSdkTasksAssembly)')">
		<!-- The app's own assemblies: the head plus anything it builds alongside. A registration can live in either. -->
		<ItemGroup>
			<_UnoWebGpuScan Include="@(IntermediateAssembly)" />
			<_UnoWebGpuScan Include="@(_ResolvedProjectReferencePaths)" />
		</ItemGroup>

		<Uno.Sdk.Tasks.DetectWebGpuUsage_v0 Assemblies="@(_UnoWebGpuScan)" Condition="'@(_UnoWebGpuScan)' != ''">
			<Output TaskParameter="CanReachWebGpu" PropertyName="_UnoWebGpuReferencedByApp" />
			<Output TaskParameter="Reason" PropertyName="_UnoWebGpuReferencedBy" />
		</Uno.Sdk.Tasks.DetectWebGpuUsage_v0>

		<PropertyGroup>
			<!-- Only ever drop when Skia is present to render instead. -->
			<_UnoWebGpuSkiaPresent>false</_UnoWebGpuSkiaPresent>
			<_UnoWebGpuSkiaPresent Condition="$(UnoFeatures.Contains(';skia;'))">true</_UnoWebGpuSkiaPresent>
			<_UnoWebGpuNativeUnused Condition="'$(_UnoWebGpuReferencedByApp)' != 'true' And '$(_UnoWebGpuSkiaPresent)' == 'true'">true</_UnoWebGpuNativeUnused>
		</PropertyGroup>

		<Message Importance="normal" Condition="'$(_UnoWebGpuNativeUnused)' == 'true'"
				 Text="Nothing in this app goes near WebGPU and Skia is present, so the wgpu native payload is omitted. Set UnoWebGpuForceNative=true to keep it." />
		<Message Importance="low" Condition="'$(_UnoWebGpuReferencedByApp)' == 'true'"
				 Text="Keeping the wgpu native payload: $(_UnoWebGpuReferencedBy) names WebGPU or registers a graphics backend." />
	</Target>

	<!-- Build output and publish resolve the payload through separate item lists, so both are filtered. -->
	<Target Name="_UnoWebGpuDropNativeFromOutput"
			AfterTargets="_UnoWebGpuDetectUsage"
			BeforeTargets="CopyFilesToOutputDirectory"
			Condition="'$(_UnoWebGpuNativeUnused)' == 'true'">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').Contains('wgpu_native'))" />
		</ItemGroup>
	</Target>

	<Target Name="_UnoWebGpuDropNativeFromPublish"
			AfterTargets="ComputeResolvedFilesToPublishList"
			Condition="'$(_UnoWebGpuNativeUnused)' == 'true'">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').Contains('wgpu_native'))" />
		</ItemGroup>
	</Target>

</Project>
