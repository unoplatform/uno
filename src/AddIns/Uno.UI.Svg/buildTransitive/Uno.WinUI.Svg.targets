<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<!-- Desktop and headless heads, the ones this check has always applied to. -->
		<_UnoSvgCheckApplies>false</_UnoSvgCheckApplies>
		<_UnoSvgCheckApplies
			Condition="'$(UnoHasRuntimeHost)'=='true' and ('$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))'=='desktop' or '$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))'=='')">true</_UnoSvgCheckApplies>
	</PropertyGroup>

	<Target Name="_ValidateSvgDependencySkia"
			BeforeTargets="Compile"
			Condition="'$(IsUnoHead)'=='true' and '$(_UnoSvgCheckApplies)'=='true' and '$(UnoDisableSvgSkiaVersionCheck)'==''">

		<!--
		Nuget does not support dynamic references in packages, and we need Svg.Skia only for the Skia UnoRuntime
		We do the validation at runtime to determine if the Svg.Skia package is referenced.
		-->

		<ItemGroup>
			<_SvgSkiaRefs Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Svg.Skia' AND '%(ReferencePath.NuGetPackageVersion)' >= '1.0.0.1'" />
		</ItemGroup>

		<Error Condition="'@(_SvgSkiaRefs)'==''" Text="In order to use Uno Svg support, the 'Svg.Skia' NuGet Package (1.0.0.1 or later) must be referenced in the project. You can add &lt;PackageReference Include=&quot;Svg.Skia&quot; Version=&quot;1.0.0.1&quot; /> to your project." />
	</Target>
</Project>
