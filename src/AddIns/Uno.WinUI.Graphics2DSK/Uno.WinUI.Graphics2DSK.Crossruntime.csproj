<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(NetReferencePreviousAndCurrent)</TargetFrameworks>
		<UnoShouldUseNoPlatformOverride>true</UnoShouldUseNoPlatformOverride>
	</PropertyGroup>
	<Import Project="../../targetframework-override.props" />
	<Import Project="..\..\SourceGenerators\Uno.UI.SourceGenerators\Content\Uno.UI.SourceGenerators.props" />

	<PropertyGroup>
		<AssemblyName>Uno.WinUI.Graphics2DSK</AssemblyName>
		<RootNamespace>Uno.WinUI.Graphics2DSK</RootNamespace>

		<Nullable>enable</Nullable>
		
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" />
		<!-- Only the opt-in GL-island fallback (SkiaGLCanvasElement) needs Silk, to override GLCanvasElement's
		     GL-typed methods. PrivateAssets so it isn't flowed to 2DSK-only consumers (matching the Graphics3DGL
		     reference); when the island is actually used, Graphics3DGL brings Silk along. -->
		<PackageReference Include="Silk.NET.OpenGL" Version="2.16.0" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<DefineConstants>$(DefineConstants);CROSSRUNTIME</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Uno.UI\Uno.UI.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\Uno.WinUI.Graphics3DGL\Uno.WinUI.Graphics3DGL.csproj" PrivateAssets="all" />
	</ItemGroup>
	

	<ItemGroup>
		<None Include="..\..\Common\uno.png" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
