<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<!-- Desktop and headless heads, the ones this check has always applied to. -->
		<_UnoLottieCheckApplies>false</_UnoLottieCheckApplies>
		<_UnoLottieCheckApplies
			Condition="'$(UnoHasRuntimeHost)'=='true' and ('$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))'=='desktop' or '$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))'=='')">true</_UnoLottieCheckApplies>
	</PropertyGroup>

	<Target Name="_ValidateLottieDependencySkia"
			BeforeTargets="Compile"
			Condition="'$(IsUnoHead)'=='true' and '$(_UnoLottieCheckApplies)'=='true' and '$(UnoDisableLottieSkiaVersionCheck)'==''">

		<!--
		Nuget does not support dynamic references in packages, and we need Skottie only for the Skia UnoRuntime
		We do the validation at runtime to determine if the SkiaSharp.Skottie package is referenced.
		-->

		<ItemGroup>
			<_SkottieRefs Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'SkiaSharp.Skottie'" />
		</ItemGroup>

		<Error Condition="'@(_SkottieRefs)'==''" Text="The 'SkiaSharp.Skottie' NuGet Package (4.151.1 or later) must be referenced in the project. You can add &lt;PackageReference Include=&quot;SkiaSharp.Skottie&quot; Version=&quot;4.151.1&quot; /> to your project." />
	</Target>
</Project>
