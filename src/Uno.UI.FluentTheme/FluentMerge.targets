<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <PropertyGroup>
	<_Uno_XamlMerge_Task_Version>1.27.0-dev.44</_Uno_XamlMerge_Task_Version>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  ExcludeAssets="build;buildTransitive" keeps the package's targets from being auto-imported into
	  every variant; they are imported explicitly below, only for the variants carrying theme resources.
	-->
	<PackageReference Include="Uno.XamlMerge.Task" Version="$(_Uno_XamlMerge_Task_Version)" ExcludeAssets="build;buildTransitive" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
	<!--
	  Build artifact, not committed (#23399). The source generator requires it at the project root under
	  this exact name - XamlCodeGeneration matches the project-relative path to register
	  ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml - so it cannot move to obj\.
	  Sources and output are both kept out of the automatic Page glob; the merge feeds on the explicit
	  XamlMergeInput below, and the Uno.XamlMerge.Task targets add the merged file to @(Page).
	-->
	<XamlMergeOutputFile>$(MSBuildThisFileDirectory)themeresources.xaml</XamlMergeOutputFile>
	<PageExclusions>$(MSBuildThisFileDirectory)Resources\**\*.xaml;$(XamlMergeOutputFile)</PageExclusions>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  Templates intentionally dropped from the Fluent theme: either broken under Uno or superseded by an
	  Uno-specific implementation (ProgressRing, ScrollViewer, SplitView, RadioMenuFlyoutItem).
	-->
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\RadioMenuFlyoutItem_themeresources.xaml" />
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\ProgressRing.xaml" />
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\ScrollViewer.xaml" />
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\ScrollViewer_themeresources.xaml" />
	<!-- UNO TODO Fails to display correctly for multiple reasons, including https://github.com/unoplatform/uno/issues/325 but also undiagnosed issues -->
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\SplitView_themeresources.xaml" />

	<!--
	  Explicit merge inputs (not @(Page)) so every variant merges the same content into the shared
	  output file - this avoids a variant that disables the Page glob writing an empty file over it.
	-->
	<XamlMergeInput Include="$(MSBuildThisFileDirectory)Resources\**\*.xaml" Exclude="@(_ExcludedTemplates)" />

	<!--
	  Directory.Build.targets appends @(Page) to XamlMergeInput as soon as XamlMergeOutputFile is set, which
	  would fold the density dictionaries into the merged theme - they have to stay separate pages so that
	  ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml keeps resolving and Compact stays opt-in.
	-->
	<_NonMergedXamlResources Include="$(MSBuildThisFileDirectory)DensityStyles\**\*.xaml" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UnoRuntimeFlavor)'=='Reference'">
	<EnableAutomaticXamlPageInclusion>false</EnableAutomaticXamlPageInclusion>
  </PropertyGroup>

  <!--
    The task loads from the restored NuGet package, so it has no dependency on the Uno.UI.Tasks build
    output ($(Configuration)_Shadow) - which the merge cannot rely on, running as it does before
    ResolveProjectReferences.

    Not imported for the Reference stub, which carries no theme resources.

    Unlike Uno.UI/XamlMerge.targets the import is not gated on TargetFramework: PageExclusions above
    keeps the merged output out of the automatic Page glob, so it is the package's own
    _AdjustedMergedXamlItems target that feeds it to @(Page), and every inner build needs it. The
    package's own _GenerateMergedXaml then runs the merge in the outer build before
    DispatchToInnerBuilds. Inner builds re-merge the identical XamlMergeInput set, and the task only
    rewrites the file when the content differs.
  -->
  <Import Project="$(NuGetPackageRoot)\uno.xamlmerge.task\$(_Uno_XamlMerge_Task_Version)\build\Uno.XamlMerge.Task.targets"
		  Condition="'$(UnoRuntimeFlavor)' != 'Reference' and exists('$(NuGetPackageRoot)\uno.xamlmerge.task\$(_Uno_XamlMerge_Task_Version)')" />

  <!--
    The merged file is no longer committed, so a skipped merge (unrestored package, relocated
    NuGetPackageRoot, stale version literal) would otherwise produce a theme assembly with no
    resources and a successful build - the source generator registers
    ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml only when the file is present.
  -->
  <Target Name="_VerifyMergedThemeResource"
		  BeforeTargets="CoreCompile"
		  Condition="'$(UnoRuntimeFlavor)' != 'Reference' and '$(DesignTimeBuild)' != 'true'">
	<Error Condition="!Exists('$(XamlMergeOutputFile)')"
		   Text="$(XamlMergeOutputFile) was not generated. Uno.XamlMerge.Task $(_Uno_XamlMerge_Task_Version) must be restored (expected under '$(NuGetPackageRoot)\uno.xamlmerge.task\$(_Uno_XamlMerge_Task_Version)'). Run 'dotnet restore'." />
  </Target>

  <PropertyGroup>
	<!-- Used by the other Uno.UI.Tasks tasks (e.g. ResourcesGenerationTask) imported via
	     Uno.UI.Tasks.targets; those run after ResolveProjectReferences, so the shadow copy exists. -->
	<UnoUIMSBuildTasksPath>$(MSBuildThisFileDirectory)..\SourceGenerators\Uno.UI.Tasks\bin\$(Configuration)_Shadow</UnoUIMSBuildTasksPath>
  </PropertyGroup>

  <Import Project="..\SourceGenerators\Uno.UI.SourceGenerators\Content\Uno.UI.SourceGenerators.props" />

</Project>
