<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <ItemGroup>
	<!--
	  ExcludeAssets="build;buildTransitive" keeps the package's targets from being auto-imported into
	  every variant; they are imported explicitly below, only for the variants carrying theme resources.
	-->
	<PackageReference Include="Uno.XamlMerge.Task" ExcludeAssets="build;buildTransitive" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
	<!--
	  Build artifacts, not committed (#23399). The source generator requires them at these exact
	  project-relative paths - XamlCodeGeneration matches them to register
	  ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml and
	  ms-appx:///Microsoft.UI.Xaml.Controls.Tabular/Themes/{themeresources,generic}.xaml - so they cannot
	  move to obj\. Sources and outputs are all kept out of the automatic Page glob; the merge feeds on the
	  explicit XamlMergeInput below, and the Uno.XamlMerge.Task targets add the merged files to @(Page).
	-->
	<_FluentThemeResourcesMergeFile>$(MSBuildThisFileDirectory)themeresources.xaml</_FluentThemeResourcesMergeFile>
	<!--
	  The Tabular controls (TableView) get their own generic.xaml and themeresources.xaml, as the
	  Microsoft.UI.Xaml.Controls.Tabular binary ships them on Windows. The task pairs each XamlMergeInput with
	  an output by MergeFile = output *file name*, so the Tabular theme file needs a name distinct from the
	  Fluent one on disk; the URI it is registered under keeps the WinUI name.
	-->
	<_TabularGenericMergeFile>$(MSBuildThisFileDirectory)Tabular\Themes\generic.xaml</_TabularGenericMergeFile>
	<_TabularThemeResourcesMergeFile>$(MSBuildThisFileDirectory)Tabular\Themes\tabular_themeresources.xaml</_TabularThemeResourcesMergeFile>
	<PageExclusions>$(MSBuildThisFileDirectory)Resources\**\*.xaml;$(MSBuildThisFileDirectory)Tabular\**\*.xaml;$(_FluentThemeResourcesMergeFile)</PageExclusions>
  </PropertyGroup>

  <ItemGroup>
	<!--
	  Templates intentionally dropped from the Fluent theme: either broken under Uno or superseded by an
	  Uno-specific implementation (ProgressRing, ScrollViewer, SplitView, RadioMenuFlyoutItem).
	-->
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\RadioMenuFlyoutItem_themeresources.xaml" />
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\ProgressRing.xaml" />
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\ScrollViewer.xaml" />
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\ScrollViewer_themeresources.xaml" />
	<!-- UNO TODO Fails to display correctly for multiple reasons, including https://github.com/unoplatform/uno/issues/325 but also undiagnosed issues -->
	<_ExcludedTemplates Include="$(MSBuildThisFileDirectory)Resources\PriorityDefault\SplitView_themeresources.xaml" />

	<!--
	  Several outputs, so XamlMergeOutputFile stays unset (the task refuses both). That also keeps
	  Directory.Build.targets from appending @(Page) to XamlMergeInput, so the density dictionaries remain
	  separate pages: ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml keeps resolving and Compact stays opt-in.
	-->
	<XamlMergeOutputFiles Include="$(_FluentThemeResourcesMergeFile)" />
	<XamlMergeOutputFiles Include="$(_TabularGenericMergeFile)" />
	<XamlMergeOutputFiles Include="$(_TabularThemeResourcesMergeFile)" />

	<!--
	  Explicit merge inputs (not @(Page)) so every variant merges the same content into the shared
	  output files - this avoids a variant that disables the Page glob writing an empty file over them.
	-->
	<XamlMergeInput Include="$(MSBuildThisFileDirectory)Resources\**\*.xaml" Exclude="@(_ExcludedTemplates)" MergeFile="themeresources.xaml" />

	<!--
	  Tabular pages in the order the Windows build merges them (Tabular.ProjectImports.targets): vcxitems in
	  import order (ResizeGripper, SortIndicator, TableView), TabularSurfaces (Priority 2) ahead of the
	  unprioritized theme pages. DefaultStyle pages go to generic.xaml, ThemeResources pages to themeresources.xaml.
	-->
	<XamlMergeInput Include="$(MSBuildThisFileDirectory)Tabular\Resources\Generic\ResizeGripper.xaml" MergeFile="generic.xaml" />
	<XamlMergeInput Include="$(MSBuildThisFileDirectory)Tabular\Resources\Generic\SortIndicator.xaml" MergeFile="generic.xaml" />
	<XamlMergeInput Include="$(MSBuildThisFileDirectory)Tabular\Resources\Generic\TableView.xaml" MergeFile="generic.xaml" />
	<XamlMergeInput Include="$(MSBuildThisFileDirectory)Tabular\Resources\ThemeResources\TabularSurfaces_themeresources.xaml" MergeFile="tabular_themeresources.xaml" />
	<XamlMergeInput Include="$(MSBuildThisFileDirectory)Tabular\Resources\ThemeResources\SortIndicator_themeresources.xaml" MergeFile="tabular_themeresources.xaml" />
	<XamlMergeInput Include="$(MSBuildThisFileDirectory)Tabular\Resources\ThemeResources\TableView_themeresources.xaml" MergeFile="tabular_themeresources.xaml" />
  </ItemGroup>

  <!--
    The task loads from the restored NuGet package, so it has no dependency on the Uno.UI.Tasks build
    output ($(Configuration)_Shadow) - which the merge cannot rely on, running as it does before
    ResolveProjectReferences.

    Unlike Uno.UI/XamlMerge.targets the import is not gated on TargetFramework: PageExclusions above
    keeps the merged output out of the automatic Page glob, so it is the package's own
    _AdjustedMergedXamlItems target that feeds it to @(Page), and every inner build needs it. The
    package's own _GenerateMergedXaml then runs the merge in the outer build before
    DispatchToInnerBuilds. Inner builds re-merge the identical XamlMergeInput set, and the task only
    rewrites the file when the content differs.
  -->
  <Import Project="$(NuGetPackageRoot)\uno.xamlmerge.task\$(UnoXamlMergeTaskVersion)\build\Uno.XamlMerge.Task.targets"
		  Condition="exists('$(NuGetPackageRoot)\uno.xamlmerge.task\$(UnoXamlMergeTaskVersion)')" />

  <!--
    The merged file is no longer committed, so a skipped merge (unrestored package, relocated
    NuGetPackageRoot, stale version literal) would otherwise produce a theme assembly with no
    resources and a successful build - the source generator registers each
    ms-appx:///.../Themes/*.xaml dictionary only when its file is present.
  -->
  <Target Name="_VerifyMergedThemeResource"
		  BeforeTargets="CoreCompile"
		  Condition="'$(DesignTimeBuild)' != 'true'">
	<Error Condition="!Exists('%(XamlMergeOutputFiles.FullPath)')"
		   Text="%(XamlMergeOutputFiles.FullPath) was not generated. Uno.XamlMerge.Task $(UnoXamlMergeTaskVersion) must be restored (expected under '$(NuGetPackageRoot)\uno.xamlmerge.task\$(UnoXamlMergeTaskVersion)'). Run 'dotnet restore'." />
  </Target>

  <PropertyGroup>
	<!-- Used by the other Uno.UI.Tasks tasks (e.g. ResourcesGenerationTask) imported via
	     Uno.UI.Tasks.targets; those run after ResolveProjectReferences, so the shadow copy exists. -->
	<UnoUIMSBuildTasksPath>$(MSBuildThisFileDirectory)..\SourceGenerators\Uno.UI.Tasks\bin\$(Configuration)_Shadow</UnoUIMSBuildTasksPath>
  </PropertyGroup>

  <Import Project="..\SourceGenerators\Uno.UI.SourceGenerators\Content\Uno.UI.SourceGenerators.props" />

</Project>
