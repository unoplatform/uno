<!--
	Uno deltas on top of the verbatim WinUI dictionaries in this folder's siblings.
	The folder sorts after PriorityDefault, so these keys win the merge.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
	<ResourceDictionary.ThemeDictionaries>
		<!-- WinUI paints these surfaces with a DesktopAcrylicBackdrop, which popups do not support yet, so keep the in-app acrylic fill. -->
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
			<StaticResource x:Key="CommandBarFlyoutBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
			<StaticResource x:Key="CommandBarFlyoutBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!-- VirtualizingStackPanel is not implemented on Skia, so FlipView keeps a StackPanel. -->
	<Style TargetType="FlipView" BasedOn="{StaticResource DefaultFlipViewStyle}">
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel AreScrollSnapPointsRegular="True" Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
