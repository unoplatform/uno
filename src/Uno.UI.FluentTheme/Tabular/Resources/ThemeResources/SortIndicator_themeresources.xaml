<!-- MUX Reference controls\dev\SortIndicator\SortIndicator_themeresources.xaml, tag winui3/main, commit dc28206ea35 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="SortIndicatorForeground" ResourceKey="TextFillColorPrimaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="SortIndicatorForeground" ResourceKey="TextFillColorPrimaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SortIndicatorForeground" ResourceKey="SystemColorWindowTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Box is larger than the glyph on purpose: a Segoe Fluent Icons line box is taller than its
         font size and a Grid does not clip, so equal sizes would let the chevron overflow. -->
    <x:Double x:Key="SortIndicatorSize">16</x:Double>

    <!-- Sized independently of the box so consumers can pad without scaling the glyph. -->
    <x:Double x:Key="SortIndicatorGlyphSize">12</x:Double>
</ResourceDictionary>
