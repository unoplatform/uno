<!-- MUX Reference controls\dev\ResizeGripper\ResizeGripper_themeresources.xaml, tag winui3/main, commit 79209e041 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Must be registered as a ThemeResources page (ResizeGripper.vcxitems), or these keys are
         missing at runtime and the gripper template throws. -->

    <Thickness x:Key="ResizeGripperSeparatorThickness">0,0,1,0</Thickness>
    <Thickness x:Key="ResizeGripperSeparatorThicknessVertical">0,0,0,1</Thickness>

    <ResourceDictionary.ThemeDictionaries>
        <!-- ControlStrongStrokeColorDefault. "Default" means Dark once "Light" is defined. -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ResizeGripperSeparatorBrush" Color="#72000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ResizeGripperSeparatorBrush" Color="#8BFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <!-- Not the accent brush: under High Contrast it matches the window background. -->
            <SolidColorBrush x:Key="ResizeGripperSeparatorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
