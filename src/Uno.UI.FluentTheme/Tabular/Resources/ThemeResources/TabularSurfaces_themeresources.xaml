<!-- MUX Reference controls\dev\CommonStyles\TabularSurfaces_themeresources.xaml, tag winui3/main, commit dc28206ea35 -->
<!--
    Tabular Surfaces — shared theming tokens for any control that paints tabular UI
    (rows, headers, gridlines, cells, selection, focus). Authored as a framework
    primitive so future controls (TableView, DataGrid, list-of-rows, etc.) consume
    a single named-token surface instead of inventing their own brushes.

    Token namespace: MUX_TabularSurface*
        Row*           - row-level surfaces (background, hover, selected, foreground)
        Header*        - column-header surfaces
        GridLine*      - row/column separator brushes and metrics
        Cell*          - cell-level metrics (padding)
        Focus*         - focus-indicator brushes for cell/row focus

    IMPORTANT — why literal SolidColorBrush per theme instead of <StaticResource>
    aliases to TextFillColor*Brush / SubtleFillColor*Brush / etc.:

    The aliased pattern (`<StaticResource ResourceKey="TextFillColorPrimaryBrush" />`)
    works ONLY when this file is consumed via the dll's master themeresources.xaml
    (produced by BatchMergeXaml + bundled in Microsoft.UI.Xaml.Controls.dll). In that
    context every alias resolves against the same compiled XBF blob.

    Consuming apps merge this file directly via
       <ResourceDictionary Source="ms-appx:///TabularSurfaces_themeresources.xaml" />
    because XamlControlsResources does NOT deploy the dll's master themeresources to
    the consumer's package. When merged that way, the StaticResource aliases must
    cross-reference into ANOTHER merged dictionary (XamlControlsResources's theme
    dicts) at runtime — which the XAML resolver does NOT do reliably for keys nested
    inside ThemeDictionaries blocks of a sibling MergedDictionary. The result was
    silent fallbacks (Light-theme black brushes used in Dark theme → dark-on-dark
    body cells + header text, hard to read).

    Fix is to inline the WinUI Fluent color values per theme so the brushes are
    self-contained. The hex values mirror controls/dev/CommonStyles/Common_themeresources_any.xaml
    exactly so the visual identity stays in sync with the rest of WinUI. If the
    Fluent design system tweaks a token, refresh the corresponding hex here.

    HighContrast block continues to use {ThemeResource SystemColor*} which is a
    re-resolving markup extension and works correctly across MergedDictionary
    boundaries.
-->
<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">

            <!-- Row backgrounds -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundBrush" Color="#00FFFFFF" />                          <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundAlternatingBrush" Color="#0FFFFFFF" />               <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPointerOverBrush" Color="#0FFFFFFF" />               <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundPressedBrush" Color="#0AFFFFFF" />                   <!-- SubtleFillColorTertiary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedBrush" Color="#0FFFFFFF" />                  <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPointerOverBrush" Color="#0AFFFFFF" />       <!-- SubtleFillColorTertiary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundSelectedPressedBrush" Color="#0FFFFFFF" />           <!-- SubtleFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceRowBackgroundDisabledBrush" Color="#00FFFFFF" />                  <!-- SubtleFillColorTransparent -->
            <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="TabularSurfaceSelectionIndicatorDisabledBrush" Color="#5DFFFFFF" />

            <!-- Row foregrounds -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundBrush" Color="#FFFFFF" />                            <!-- TextFillColorPrimary -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedBrush" Color="#FFFFFF" />                    <!-- TextFillColorPrimary -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPointerOverBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundSelectedPressedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundPointerOverBrush" Color="#FFFFFF" />                  <!-- TextFillColorPrimary (subtle pointer-over fill keeps primary text) -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundPressedBrush" Color="#FFFFFF" />                     <!-- TextFillColorPrimary -->
            <SolidColorBrush x:Key="TabularSurfaceRowForegroundDisabledBrush" Color="#5DFFFFFF" />                  <!-- TextFillColorDisabled -->

            <!-- Header surfaces. Header background bumped from #19 (~10%) to #26 (~15%) during visual tuning for
                 visible step above row banding and proportional parity with the Light theme. -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderBackgroundBrush" Color="#26FFFFFF" />                       <!-- ~15% white (#26 alpha) -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderForegroundBrush" Color="#C5FFFFFF" />                       <!-- TextFillColorSecondary -->
            <SolidColorBrush x:Key="TabularSurfaceHeaderSeparatorBrush" Color="#12FFFFFF" />                        <!-- ControlStrokeColorDefault -->

            <!-- Group-header row surfaces (P2.8 grouped rows) -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBackgroundBrush" Color="#4C3A3A3A" />                  <!-- LayerFillColorDefault -->
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderForegroundBrush" Color="#FFFFFF" />                    <!-- TextFillColorPrimary -->
            <x:Double x:Key="TabularSurfaceGroupHeaderCountOpacity">0.7</x:Double>
            <SolidColorBrush x:Key="TabularSurfaceGroupHeaderBorderBrush" Color="Transparent" />
            <Thickness x:Key="TabularSurfaceGroupHeaderBorderThickness">0</Thickness>

            <!-- Grid lines. DividerStrokeColorDefault (~16% white on Dark) — visible above row
                 banding without dominating the surface. Earlier ControlStrokeColorDefault (~7%
                 white) was too faint at 1-px width on alternating rows. -->
            <SolidColorBrush x:Key="TabularSurfaceGridLineBrush" Color="#29FFFFFF" />                               <!-- DividerStrokeColorDefault (Dark) — bumped 8.2%→16.1% for readability over banding -->
            <Thickness x:Key="TabularSurfaceGridLineThickness">0,0,0,1</Thickness>
            <Thickness x:Key="TabularSurfaceVerticalGridLineThickness">0,0,1,0</Thickness>

            <!-- Cell metrics -->
            <Thickness x:Key="TabularSurfaceCellPadding">12,4,12,4</Thickness>
            <Thickness x:Key="TabularSurfaceHeaderCellPadding">8,4,8,4</Thickness>
            <x:Double x:Key="TabularSurfaceRowMinHeight">28</x:Double>
            <x:Double x:Key="TabularSurfaceHeaderMinHeight">40</x:Double>
            <CornerRadius x:Key="TabularSurfaceCornerRadius">4</CornerRadius>

            <!-- Focus / selection visuals -->
            <SolidColorBrush x:Key="TabularSurfaceFocusBorderBrush" Color="#FFFFFF" />                              <!-- FocusStrokeColorOuter -->
            <SolidColorBrush x:Key="TabularSurfaceSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}" />
            <Thickness x:Key="TabularSurfaceSelectedBorderThickness">2</Thickness>

            <!-- Back-compat aliases: keep the old MUX_-prefixed key names so any out-of-tree
                 consumer (or in-tree test) that references MUX_TabularSurface* by string still
                 resolves to the same primary value. New consumers should reference the unprefixed
                 keys above. The MUX_ aliases will be removed in a future cleanup when no consumer
                 references them — track via grep `MUX_TabularSurface`. -->
            <StaticResource x:Key="MUX_TabularSurfaceRowBackgroundBrush" ResourceKey="TabularSurfaceRowBackgroundBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowBackgroundAlternatingBrush" ResourceKey="TabularSurfaceRowBackgroundAlternatingBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowBackgroundPointerOverBrush" ResourceKey="TabularSurfaceRowBackgroundPointerOverBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowBackgroundPressedBrush" ResourceKey="TabularSurfaceRowBackgroundPressedBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowBackgroundSelectedBrush" ResourceKey="TabularSurfaceRowBackgroundSelectedBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowBackgroundSelectedPointerOverBrush" ResourceKey="TabularSurfaceRowBackgroundSelectedPointerOverBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowBackgroundSelectedPressedBrush" ResourceKey="TabularSurfaceRowBackgroundSelectedPressedBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowBackgroundDisabledBrush" ResourceKey="TabularSurfaceRowBackgroundDisabledBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceSelectionIndicatorBrush" ResourceKey="TabularSurfaceSelectionIndicatorBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowForegroundBrush" ResourceKey="TabularSurfaceRowForegroundBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowForegroundSelectedBrush" ResourceKey="TabularSurfaceRowForegroundSelectedBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowForegroundSelectedPointerOverBrush" ResourceKey="TabularSurfaceRowForegroundSelectedPointerOverBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowForegroundSelectedPressedBrush" ResourceKey="TabularSurfaceRowForegroundSelectedPressedBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceRowForegroundDisabledBrush" ResourceKey="TabularSurfaceRowForegroundDisabledBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceHeaderBackgroundBrush" ResourceKey="TabularSurfaceHeaderBackgroundBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceHeaderForegroundBrush" ResourceKey="TabularSurfaceHeaderForegroundBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceHeaderSeparatorBrush" ResourceKey="TabularSurfaceHeaderSeparatorBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceGroupHeaderBackgroundBrush" ResourceKey="TabularSurfaceGroupHeaderBackgroundBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceGroupHeaderForegroundBrush" ResourceKey="TabularSurfaceGroupHeaderForegroundBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceGridLineBrush" ResourceKey="TabularSurfaceGridLineBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceGridLineThickness" ResourceKey="TabularSurfaceGridLineThickness" />
            <StaticResource x:Key="MUX_TabularSurfaceVerticalGridLineThickness" ResourceKey="TabularSurfaceVerticalGridLineThickness" />
            <StaticResource x:Key="MUX_TabularSurfaceCellPadding" ResourceKey="TabularSurfaceCellPadding" />
            <StaticResource x:Key="MUX_TabularSurfaceHeaderCellPadding" ResourceKey="TabularSurfaceHeaderCellPadding" />
            <StaticResource x:Key="MUX_TabularSurfaceRowMinHeight" ResourceKey="TabularSurfaceRowMinHeight" />
            <StaticResource x:Key="MUX_TabularSurfaceHeaderMinHeight" ResourceKey="TabularSurfaceHeaderMinHeight" />
            <StaticResource x:Key="MUX_TabularSurfaceCornerRadius" ResourceKey="TabularSurfaceCornerRadius" />
            <StaticResource x:Key="MUX_TabularSurfaceFocusBorderBrush" ResourceKey="TabularSurfaceFocusBorderBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceSelectedBorderBrush" ResourceKey="TabularSurfaceSelectedBorderBrush" />
            <StaticResource x:Key="MUX_TabularSurfaceSelectedBorderThickness" ResourceKey="TabularSurfaceSelectedBorderThickness" />

        </ResourceDictionary>

