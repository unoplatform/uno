<!-- MUX Reference controls\dev\TableView\TableView.xaml, tag winui3/main, commit 79209e041 -->
<!-- TODO Uno: xmlns remapped by hand; WinUI does it at build time via RemapTabularXamlNamespaces.ps1 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls.Tabular">

    <Thickness x:Key="TableViewHeaderCellPadding">8,4,8,4</Thickness>
    <!-- Metric defaults remain available alongside the default styles. -->
    <x:Double x:Key="TableViewResizeGripperWidth">8</x:Double>

    <!-- TabularControlsResources is required to supply TabularSurface* brushes for all themes. -->

    <!-- TableView default style. Header cells stack horizontally (one per
         column); the body is an ItemsRepeater of TableViewRow, each building its cells from
         the owning TableView's Columns. -->
    <Style TargetType="controls:TableView">
        <!-- The control is ONE tab stop, not a stop of its own: IsTabStop="False" keeps focus off the
             table element, and TabNavigation="Once" makes the header row and the body a single stop.
             TableView redirects Tab and Shift+Tab entry to the header row (or the body when no
             header is actionable), and the next Tab leaves the table. -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource TabularSurfaceRowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TabularSurfaceRowForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TabularSurfaceOuterBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TableView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="PART_HeaderRow"
                                    Grid.Row="0"
                                    Background="{ThemeResource TabularSurfaceHeaderBackgroundBrush}"
                                    BorderBrush="{ThemeResource TabularSurfaceHeaderSeparatorBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <ScrollViewer x:Name="PART_HeaderScroller"
                                                  HorizontalScrollMode="Disabled"
                                                  VerticalScrollMode="Disabled"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <!-- Left, not the default Stretch: the panel reports the summed column
                                             width, and a wider presenter would centre it. PART_CellsHost
                                             must match. -->
                                        <controls:TableViewCellsPanel x:Name="PART_HeaderHost"
                                                                      HorizontalAlignment="Left" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="PART_BodyScroller"
                                          Grid.Row="1"
                                          HorizontalScrollMode="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          VerticalContentAlignment="Stretch">
                                
                                <Grid x:Name="PART_BodyContent" Background="Transparent">
                                    <ItemsRepeater x:Name="PART_RowsRepeater"
                                                   VerticalCacheLength="2.0">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <ContentControl x:Name="PART_EmptyStatePresenter"
                                                    Visibility="Collapsed"
                                                    IsTabStop="False"
                                                    TabNavigation="Local"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:TableViewColumnHeader">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <!-- Without a fill the padding takes no pointer input, killing the tooltip and click-to-sort there. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{ThemeResource TableViewHeaderFontSize}" />
        <Setter Property="FontWeight" Value="{ThemeResource TableViewHeaderFontWeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TableViewColumnHeader">
                    <!-- CornerRadius is set only while keyboard-focused: a rounded root clips. -->
                    <Grid x:Name="PART_Root"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- See TableViewRow: state groups must sit on the template root. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Root.Background" Value="{ThemeResource TabularSurfaceHeaderBackgroundPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Root.Background" Value="{ThemeResource TabularSurfaceHeaderBackgroundPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="HighContrastStates">
                                <VisualState x:Name="HighContrastNormal" />
                                <VisualState x:Name="HighContrastPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceHeaderForegroundPointerOverBrush}" />
                                        <Setter Target="PART_ContentPresenter.HighContrastAdjustment" Value="None" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="HighContrastPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceHeaderForegroundPressedBrush}" />
                                        <Setter Target="PART_ContentPresenter.HighContrastAdjustment" Value="None" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SortStates">
                                <VisualState x:Name="Unsorted" />
                                <VisualState x:Name="SortAscending">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SortIndicatorHost.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SortDescending">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SortIndicatorHost.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw" />

                        <Border x:Name="PART_GridLine"
                                Width="1"
                                HorizontalAlignment="Right"
                                Background="{ThemeResource TabularSurfaceHeaderSeparatorBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                AutomationProperties.AccessibilityView="Raw" />

                        <Border x:Name="PART_SortIndicatorHost"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                AutomationProperties.AccessibilityView="Raw" />

                        <!-- Last, so the gripper wins the hit test on the shared edge. -->
                        <Border x:Name="PART_ResizeGripperHost" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <x:Double x:Key="TableViewRowExpanderSize">24</x:Double>

    <!-- Indent added per hierarchy level on a tree row's first column. Override in an app's
         resources to retheme every table, or in one TableView's Resources for a single table. -->
    <x:Double x:Key="TableViewRowIndentSize">16</x:Double>

    <Style TargetType="controls:TableViewRow">
        <!-- The row IS a focus target. Body navigation is TWO-LEVEL, following the W3C ARIA APG
             `treegrid` pattern: focus enters the body on a ROW, Right drills into that row's first
             CELL, and Left from the first cell comes back out to the ROW. So Control.IsTabStop's
             default of true is what we want here and there is deliberately no setter overriding it.

             The row's IsTabStop is not static, though: TableViewRow::SetCellLevelInternal clears it
             for exactly as long as the cursor is drilled into that row's cells, and restores it on
             the way back out. That is what keeps the body ONE tab stop in BOTH directions - see the
             comment on SetCellLevelInternal for why the framework's tab walk forces the trade. -->
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />        
        <Setter Property="Background" Value="{ThemeResource TabularSurfaceRowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TabularSurfaceGridLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TableViewRow">
                    <Grid>
                        <!-- State groups belong on the TEMPLATE ROOT: VisualStateManager resolves
                             them from the root's attached property, so hosting them on an inner
                             element disables every state silently - no parse error and no warning,
                             just a row that never paints its selected / hover / pressed visuals. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundPointerOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundPointerOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="HighContrastAdjustment">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="None" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="HighContrastAdjustment">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="None" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <!-- Selected states live in this SAME group rather than a second one:
                                     they animate the same PART_RootBorder.Background, and two groups
                                     would make the result depend on GoToState call order. One group
                                     whose names encode both dimensions is the pattern TreeViewItem
                                     and ItemContainer use. -->
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundSelectedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundSelectedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="HighContrastAdjustment">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="None" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.083" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundSelectedPointerOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundSelectedPointerOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="HighContrastAdjustment">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="None" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.083" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundSelectedPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundSelectedPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="HighContrastAdjustment">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="None" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.083" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedDisabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowBackgroundDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceRowForegroundDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!-- Suppress the High Contrast text backplate wherever the row paints a state fill (hover, press, selection). -->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CellForegroundPresenter" Storyboard.TargetProperty="HighContrastAdjustment">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="None" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TabularSurfaceSelectionIndicatorDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0.083" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <!-- Hierarchy groups. Inert for flat/grouped sources (Level 0). -->
                            <VisualStateGroup x:Name="RowExpansionStates">
                                <VisualState x:Name="RowCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_RowExpanderIcon.Glyph" Value="&#xE76C;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="RowExpanded">
                                    <VisualState.Setters>
                                        <Setter Target="PART_RowExpanderIcon.Glyph" Value="&#xE70D;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="RowExpandabilityStates">
                                <VisualState x:Name="RowExpandable" />
                                <!-- Only the glyph hides; the gutter keeps its width so leaf text
                                     aligns with sibling branch text. -->
                                <VisualState x:Name="RowNotExpandable">
                                    <VisualState.Setters>
                                        <Setter Target="PART_RowExpanderIcon.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="RowHierarchyStates">
                                <!-- TableViewRow sets gutter Visibility directly; these states exist
                                     for retemplating apps to key off. -->
                                <VisualState x:Name="RowNotHierarchical" />
                                <VisualState x:Name="RowHierarchical" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="PART_RootBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- Cell host. TableViewRow populates PART_CellsHost with one cell wrapper
                                 per TableViewColumn, in Columns order, laid out left-to-right.
                                 The presenter exists so the Selected* states have something with a
                                 Foreground to animate: PART_RootBorder is a Border and has none, and
                                 cell text inherits Foreground down from here. Without it the selected
                                 foreground brushes are unreachable, which is only cosmetic in
                                 light/dark (the selected fill is ~4% alpha) but makes a selected row
                                 illegible in High Contrast, where the fill is the opaque
                                 SystemColorHighlightColor. -->
                            <ContentPresenter x:Name="PART_CellForegroundPresenter"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch">
                                <Grid>
                                    <!-- Left, matching PART_HeaderHost. -->
                                    <controls:TableViewCellsPanel x:Name="PART_CellsHost"
                                                                  HorizontalAlignment="Left" />

                                    <!-- Hierarchy chevron. Overlays the first cell (TableViewRow pads it by
                                         the same indent) so cells stay aligned with headers; later child so it
                                         stays on top as the hit target. No own Foreground: inherits the
                                         presenter's, keeping this optional part out of CommonStates. -->
                                    <Border x:Name="PART_RowExpanderGutter"
                                            Width="{ThemeResource TableViewRowExpanderSize}"
                                            Background="Transparent"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Visibility="Collapsed">
                                        <FontIcon x:Name="PART_RowExpanderIcon"
                                                  FontSize="12"
                                                  Glyph="&#xE76C;"
                                                  MirroredWhenRightToLeft="True"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </ContentPresenter>

                            <!-- Fluent selection indicator: overlays the leading edge, Opacity 0 by
                                 default; the Selected* states animate it to 1. Not hit-testable, so it
                                 cannot steal a press from the cell underneath it. -->
                            <Rectangle x:Name="PART_SelectionIndicator"
                                       Width="3"
                                       Height="16"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Fill="{ThemeResource TabularSurfaceSelectionIndicatorBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False"
                                       Opacity="0" />
                        </Grid>
                        </Border>
                        <Border x:Name="PART_GridLineBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        TableViewGroupHeader. The ControlTemplate owns the band chrome and the chevron
        (PART_ExpanderGutter / PART_ExpanderIcon); PART_ContentPresenter is the only
        app-customizable region, showing ContentTemplate over the TableViewGroupInfo Content.

        ContentTemplate always resolves: the default Style seeds it, and
        TableView.GroupHeaderTemplate overrides it as a local value that ClearValue reverts. So
        there is no default-vs-custom branch, and an app template cannot drop the expander or
        the band. Expansion, enabled and pointer state are VisualStates, so the chevron glyph
        is declared here rather than assigned from C++.
    -->
    <x:Double x:Key="TableViewGroupExpanderSize">24</x:Double>
    <!-- Gap between the expander gutter and the content; root rows are indented by size + spacing. -->
    <x:Double x:Key="TableViewGroupExpanderSpacing">8</x:Double>
    <Thickness x:Key="TableViewGroupHeaderPadding">8,8,12,8</Thickness>

    <!-- BodyStrongTextBlockStyle equivalent, single line. -->
    <Style x:Key="TableViewGroupHeaderKeyTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Opacity is a Style setter, not a local value, so TableViewGroupHeader can override it while disabled and clear it back. -->
    <Style x:Key="TableViewGroupHeaderCountTextStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="{ThemeResource TabularSurfaceGroupHeaderCountOpacity}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="TableViewDefaultGroupHeaderContentTemplate">
        <StackPanel x:Name="TableViewDefaultGroupHeaderContentRoot" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <!-- The text comes only from these bindings to TableViewGroupInfo: a restyled copy must keep them. -->
            <TextBlock x:Name="TableViewGroupHeaderKeyText"
                       Text="{Binding KeyText, Mode=OneWay}"
                       Style="{StaticResource TableViewGroupHeaderKeyTextStyle}" />
            <!-- Inherits Foreground so it follows the header's states and an app's Foreground. -->
            <TextBlock x:Name="TableViewGroupHeaderItemCountText"
                       Text="{Binding ItemCountText, Mode=OneWay}"
                       Style="{StaticResource TableViewGroupHeaderCountTextStyle}" />
        </StackPanel>
    </DataTemplate>

    <Style TargetType="controls:TableViewGroupHeader">
        <Setter Property="Background" Value="{ThemeResource TabularSurfaceGroupHeaderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TabularSurfaceGroupHeaderForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TabularSurfaceGroupHeaderBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource TabularSurfaceGroupHeaderBorderThickness}" />
        <Setter Property="Padding" Value="{ThemeResource TableViewGroupHeaderPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- Focusable so keyboard users can expand/collapse: TableViewGroupHeader::OnKeyDown
             handles Enter/Space (toggle) and Right/Left (expand/collapse), matching TreeViewItem. -->
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="ContentTemplate" Value="{StaticResource TableViewDefaultGroupHeaderContentTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TableViewGroupHeader">
                    <Grid>
                        <!-- See TableViewRow: state groups must sit on the template root. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Root.Background" Value="{ThemeResource TabularSurfaceRowBackgroundPointerOverBrush}" />
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundPointerOverBrush}" />
                                        <Setter Target="PART_ExpanderIcon.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundPointerOverBrush}" />
                                        <Setter Target="PART_ContentPresenter.HighContrastAdjustment" Value="None" />
                                        <Setter Target="PART_ExpanderIcon.HighContrastAdjustment" Value="None" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Root.Background" Value="{ThemeResource TabularSurfaceRowBackgroundPressedBrush}" />
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundPressedBrush}" />
                                        <Setter Target="PART_ExpanderIcon.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundPressedBrush}" />
                                        <Setter Target="PART_ContentPresenter.HighContrastAdjustment" Value="None" />
                                        <Setter Target="PART_ExpanderIcon.HighContrastAdjustment" Value="None" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundDisabledBrush}" />
                                        <Setter Target="PART_ExpanderIcon.Foreground" Value="{ThemeResource TabularSurfaceRowForegroundDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpanderIcon.Glyph" Value="&#xE76C;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpanderIcon.Glyph" Value="&#xE70D;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ExpandabilityStates">
                                <VisualState x:Name="Expandable" />
                                <VisualState x:Name="NotExpandable">
                                    <!-- Only the chevron hides; PART_ExpanderGutter keeps its width so
                                         content stays aligned across expandable and non-expandable groups. -->
                                    <VisualState.Setters>
                                        <Setter Target="PART_ExpanderIcon.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="PART_Root"
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="{ThemeResource TableViewGroupExpanderSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- The chevron is a pure visual. The whole band is the toggle target
                                 (TableViewGroupHeader::OnPointerReleased), matching ListView /
                                 TreeView, so there is no nested Button to inflate, focus or name. -->
                            <Border x:Name="PART_ExpanderGutter"
                                    Grid.Column="0"
                                    Width="{ThemeResource TableViewGroupExpanderSize}">
                                <FontIcon x:Name="PART_ExpanderIcon"
                                          FontSize="12"
                                          Foreground="{TemplateBinding Foreground}"
                                          MirroredWhenRightToLeft="True"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>

                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        </Border>
                        <Border x:Name="PART_GridLineBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
