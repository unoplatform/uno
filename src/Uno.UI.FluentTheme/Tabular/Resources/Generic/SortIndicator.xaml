<!-- MUX Reference controls\dev\SortIndicator\SortIndicator.xaml, tag winui3/main, commit dc28206ea35 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:privatecontrols="using:Microsoft.UI.Private.Controls">

    <Style TargetType="privatecontrols:SortIndicator">
        <!-- Themed, not inherited, matching Expander's ExpanderChevronForeground: a ThemeResource
             re-resolves on theme/HC changes by itself. A host can still set Foreground and win. -->
        <Setter Property="Foreground" Value="{ThemeResource SortIndicatorForeground}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="{ThemeResource SortIndicatorSize}" />
        <Setter Property="Height" Value="{ThemeResource SortIndicatorSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- DirectionStates needs NoSort/Ascending/Descending. -->
                <ControlTemplate TargetType="privatecontrols:SortIndicator">
                    <Grid x:Name="LayoutRoot" Visibility="Collapsed">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DirectionStates">
                                <VisualState x:Name="NoSort">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Ascending">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                        <Setter Target="GlyphIcon.Glyph" Value="&#xE96D;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Descending">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                                        <Setter Target="GlyphIcon.Glyph" Value="&#xE96E;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="DirectionStateRoot">
                            <FontIcon x:Name="GlyphIcon"
                                      Glyph="&#xE96D;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="{ThemeResource SortIndicatorGlyphSize}"
                                      IsTextScaleFactorEnabled="False"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
