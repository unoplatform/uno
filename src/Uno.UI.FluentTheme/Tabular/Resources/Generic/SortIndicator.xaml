<!-- MUX Reference controls\dev\SortIndicator\SortIndicator.xaml, tag winui3/release/2.5.4-experimental, commit 7b127093475 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:privatecontrols="using:Microsoft.UI.Private.Controls">

    <Style TargetType="privatecontrols:SortIndicator">
        <!-- Themed, not inherited, matching Expander's ExpanderChevronForeground: a ThemeResource
             re-resolves on theme/HC changes by itself. A host can still set Foreground and win. -->
        <Setter Property="Foreground" Value="{ThemeResource SortIndicatorForeground}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="{ThemeResource SortIndicatorSize}" />
        <Setter Property="Height" Value="{ThemeResource SortIndicatorSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- Required parts: LayoutRoot (any FrameworkElement, control drives its Opacity)
                     and GlyphIcon (must be a FontIcon, control sets its Glyph). DirectionStates
                     needs NoSort/Ascending/Descending. Omitting a part renders nothing. -->
                <ControlTemplate TargetType="privatecontrols:SortIndicator">
                    <Grid x:Name="LayoutRoot" Opacity="0">

                        <VisualStateManager.VisualStateGroups>
                            <!-- Empty by design: Opacity/Glyph are written imperatively after
                                 GoToState. Hook DirectionStateRoot for extra styling. -->
                            <VisualStateGroup x:Name="DirectionStates">
                                <VisualState x:Name="NoSort" />
                                <VisualState x:Name="Ascending" />
                                <VisualState x:Name="Descending" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="DirectionStateRoot">
                            <!-- Glyph set imperatively; None hides via LayoutRoot.Opacity=0. -->
                            <FontIcon x:Name="GlyphIcon"
                                      Glyph="&#xE96D;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="{ThemeResource SortIndicatorGlyphSize}"
                                      IsTextScaleFactorEnabled="False"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
