<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);NU1701</NoWarn>

		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<Deterministic>true</Deterministic>
		<Nullable>enable</Nullable>

		<!-- We need all the intermediate assemblies for proper packaging -->
		<DisablePrivateProjectReference>true</DisablePrivateProjectReference>
	</PropertyGroup>

	<ItemGroup>
		<UpToDateCheckInput Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs;" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Uno.UI.RemoteControl.Host\IDEChannel\IdeMessageSerializer.cs" Link="IDEChannel\IdeMessageSerializer.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Avoid transitive dependency from Microsoft.VisualStudio.ProjectSystem → Microsoft.Build on 4.7.1 which has a vulnerability -->
		<PackageReference Include="Microsoft.IO.Redist" />
		<PackageReference Include="System.Text.Json" />

		<PackageReference Include="Microsoft.VisualStudio.ProjectSystem.Managed" />
		<PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
		<!-- Roslyn workspace access for the batched hot-reload readiness wait (spec 052).
		     Compile-time only: the assemblies are provided by Visual Studio at runtime. -->
		<PackageReference Include="Microsoft.VisualStudio.LanguageServices" ExcludeAssets="runtime" />
		
		<!--
		Uno Studio.Extension is relying on this package:
			<PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" />

		However, referencing this package requires us to provide a VS extension, so the referenced packages are subtitute to this reference (with correspongin versions)
		-->
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="StreamJsonRpc" />
		<!-- End of Microsoft.VisualStudio.Extensibility.Sdk direct refs -->

		<!-- Polyfill for System.TimeProvider on net48 -->
		<PackageReference Include="Microsoft.Bcl.TimeProvider" />

		<PackageReference Include="Microsoft.VSSDK.BuildTools" />
		<PackageReference Include="NuGet.VisualStudio" />
		<PackageReference Include="Microsoft.VisualStudio.ProjectSystem" />
		<PackageReference Include="MessagePack" />
		<PackageReference Include="System.ValueTuple" />
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.RemoteControl.Messaging\Uno.UI.RemoteControl.Messaging.csproj" />
	</ItemGroup>

	<!-- Fix for VS 2022 -->
	<Target Name="GetTargetPath" />

	<Target Name="_UnoToolkitOverrideNuget" AfterTargets="AfterBuild" DependsOnTargets="BuiltProjectOutputGroup" Condition="'$(UnoNugetOverrideVersion)'!=''">
		<PropertyGroup>
			<_OverridePackageId>uno.winui</_OverridePackageId>
			<_UnoOverrideTargetVSVersion>16.0</_UnoOverrideTargetVSVersion>
			<_UnoOverrideTargetVSVersion Condition="'$(TargetFramework)'=='net48'">17.0</_UnoOverrideTargetVSVersion>
			<_TargetNugetFolder>$(NuGetPackageRoot)\$(_OverridePackageId).devServer\$(UnoNugetOverrideVersion)\tools\rc\$(_UnoOverrideTargetVSVersion)</_TargetNugetFolder>
		</PropertyGroup>
		<ItemGroup>
			<_OutputFiles Include="$(TargetDir)*.*" />
		</ItemGroup>
		<MakeDir Directories="$(_TargetNugetFolder)" />
		<Message Importance="high" Text="OVERRIDING NUGET PACKAGE CACHE: $(_TargetNugetFolder)" />
		<Copy SourceFiles="@(_OutputFiles)" DestinationFiles="@(_OutputFiles->'$(_TargetNugetFolder)\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Copy SourceFiles="@(_OutputFilesPDB)" DestinationFiles="@(_OutputFilesPDB->'$(_TargetNugetFolder)\%(RecursiveDir)%(Filename).pdb')" />
	</Target>

	<!-- VS2022 build issue -->
	<Target Name="GetTargetPath" />
	<Target Name="GetCopyToPublishDirectoryItems" />
</Project>
