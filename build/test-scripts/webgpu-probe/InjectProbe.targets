<Project>

	<!--
	Compiles WebGpuProbe.cs into whichever project imports this, so a template test can build an app that reaches
	the WebGPU backend. Passed as CustomBeforeMicrosoftCommonTargets, since the scenario table drives builds
	through command-line arguments only and the template itself must stay untouched.
	-->

	<ItemGroup>
		<Compile Include="$(MSBuildThisFileDirectory)WebGpuProbe.cs" />
	</ItemGroup>

</Project>
