<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<metadata minClientVersion="5.0">
		<id>Uno.WinUI.XamlHost</id>
		<version>0.0.1</version>
		<authors>Uno Platform</authors>
		<icon>uno.png</icon>
		<projectUrl>https://github.com/unoplatform/uno</projectUrl>
		<license type="expression">Apache-2.0</license>
		<description>This package provides the XAML hosting capabilities for an Uno Platform application.</description>
		<copyright>Uno Platform</copyright>
		<repository type="git" url="https://github.com/unoplatform/uno.git" branch="$branch$" commit="$commitid$" />
		<!-- The package only ships netX.0 assemblies; the mobile heads resolve those same groups. -->
		<dependencies>
			<group targetFramework="net10.0">
				<dependency id="Uno.WinUI" version="to-be-set-by-ci" />
			</group>
			<group targetFramework="net11.0">
				<dependency id="Uno.WinUI" version="to-be-set-by-ci" />
			</group>
		</dependencies>
	</metadata>

	<files>
		<file src="..\..\src\Common\uno.png" target="/" />

		<file src="..\..\src\Uno.UI.XamlHost\Bin\Uno.UI.XamlHost\Release\net10.0\Uno.UI.XamlHost.dll" target="lib\net10.0" />
		<file src="..\..\src\Uno.UI.XamlHost\Bin\Uno.UI.XamlHost\Release\net10.0\Uno.UI.XamlHost.pdb" target="lib\net10.0" />
		<file src="..\..\src\Uno.UI.XamlHost\Bin\Uno.UI.XamlHost\Release\net11.0\Uno.UI.XamlHost.dll" target="lib\net11.0" />
		<file src="..\..\src\Uno.UI.XamlHost\Bin\Uno.UI.XamlHost\Release\net11.0\Uno.UI.XamlHost.pdb" target="lib\net11.0" />

	</files>

</package>
