<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<metadata minClientVersion="5.0">
		<id>Uno.UI.Composition.WebGpu</id>
		<version>0.0.1</version>
		<authors>Uno Platform</authors>
		<icon>uno.png</icon>
		<projectUrl>https://github.com/unoplatform/uno</projectUrl>
		<license type="expression">Apache-2.0</license>
		<description>The WebGPU drawing backend for Uno Platform (implements the neutral IRenderBackend seam over the managed geometry engine). Referenced by the 'WebGpu' UnoFeature; opt-in, carries the wgpu-native runtime.</description>
		<copyright>Uno Platform</copyright>
		<repository type="git" url="https://github.com/unoplatform/uno.git" branch="$branch$" commit="$commitid$" />
		<dependencies>
			<group targetFramework="net10.0">
				<dependency id="Uno.WinUI" version="to-be-set-by-ci" />
				<dependency id="Uno.UI.Composition.WebGpu.Init" version="to-be-set-by-ci" />
			</group>
			<group targetFramework="net11.0">
				<dependency id="Uno.WinUI" version="to-be-set-by-ci" />
				<dependency id="Uno.UI.Composition.WebGpu.Init" version="to-be-set-by-ci" />
			</group>
		</dependencies>
	</metadata>

	<files>
		<file src="..\..\src\Common\uno.png" target="/" />

		<file src="..\..\src\Uno.UI.Composition.WebGpu\bin\Release\net10.0\Uno.UI.Composition.WebGpu.dll" target="lib\net10.0" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\bin\Release\net10.0\Uno.UI.Composition.WebGpu.pdb" target="lib\net10.0" />

		<file src="..\..\src\Uno.UI.Composition.WebGpu\bin\Release\net11.0\Uno.UI.Composition.WebGpu.dll" target="lib\net11.0" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\bin\Release\net11.0\Uno.UI.Composition.WebGpu.pdb" target="lib\net11.0" />

		<!-- wgpu-native runtime (pinned v29.0.1.1), fetched per RID by ProvisionWgpuNativeForPack in
		     wgpu-native.targets. KEEP THE TWO LISTS IN STEP. Desktop ships under the DllImport's own name
		     (webgpu) so default [DllImport("webgpu")] resolution finds it in runtimes/<rid>/native; Android keeps
		     wgpu-native's own name, which the resolver loads by bare name there. -->
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\win-x64\lib\wgpu_native.dll" target="runtimes\win-x64\native\webgpu.dll" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\win-arm64\lib\wgpu_native.dll" target="runtimes\win-arm64\native\webgpu.dll" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\linux-x64\lib\libwgpu_native.so" target="runtimes\linux-x64\native\libwebgpu.so" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\linux-arm64\lib\libwgpu_native.so" target="runtimes\linux-arm64\native\libwebgpu.so" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\osx-x64\lib\libwgpu_native.dylib" target="runtimes\osx-x64\native\libwebgpu.dylib" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\osx-arm64\lib\libwgpu_native.dylib" target="runtimes\osx-arm64\native\libwebgpu.dylib" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\android-arm64\lib\libwgpu_native.so" target="runtimes\android-arm64\native\libwgpu_native.so" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\android-arm\lib\libwgpu_native.so" target="runtimes\android-arm\native\libwgpu_native.so" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\android-x64\lib\libwgpu_native.so" target="runtimes\android-x64\native\libwgpu_native.so" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\android-x86\lib\libwgpu_native.so" target="runtimes\android-x86\native\libwgpu_native.so" />

		<!-- The package's own targets, and the native-payload trimming it imports. That import is guarded by
		     Exists(), so leaving the second file out disables the trimming with no error at all. -->
		<file src="..\..\src\Uno.UI.Composition.WebGpu\package\Uno.UI.Composition.WebGpu.targets" target="buildTransitive\Uno.UI.Composition.WebGpu.targets" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\package\Uno.UI.Composition.WebGpu.NativeTrim.targets" target="buildTransitive\Uno.UI.Composition.WebGpu.NativeTrim.targets" />

		<!-- iOS links the static archive into the app image, so it cannot come from runtimes/; the targets above
		     hands the right slice to the Apple SDK as a NativeReference. -->
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\ios-arm64\lib\libwgpu_native.a" target="buildTransitive\native\ios-arm64\libwgpu_native.a" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\iossimulator-arm64\lib\libwgpu_native.a" target="buildTransitive\native\iossimulator-arm64\libwgpu_native.a" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu\obj\wgpu-native\v29.0.1.1\pack\iossimulator-x64\lib\libwgpu_native.a" target="buildTransitive\native\iossimulator-x64\libwgpu_native.a" />

		<!-- WebAssembly: emscripten compiles Dawn INTO dotnet.native.wasm, so there is no library to load. The
		     port ships already patched (the package folder is shared and read-only) and the targets points emcc
		     at it. -->
		<file src="..\..\src\Uno.UI.Composition.WebGpu.Init\obj\emdawnwebgpu\v20260624.223603\emdawnwebgpu_pkg\**" target="buildTransitive\emdawnwebgpu\emdawnwebgpu_pkg" />
		<file src="..\..\src\Uno.UI.Composition.WebGpu.Init\Native\wgpu_wasm_stubs.c" target="buildTransitive\emdawnwebgpu" />
	</files>

</package>
