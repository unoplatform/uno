<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!--
	The variant a cross-runtime library declares, lowercased: it is also the uno-runtime folder it packs into
	and loads from. UnoRuntimeIdentifier is the deprecated spelling (UNOB0024), mapped onto the new names; drop
	that mapping in the next major version.
	-->
	<Target Name="_UnoComputeDeclaredRuntimeVariant">
		<PropertyGroup>
			<_UnoDeclaredRuntimeVariant>$(UnoRuntimeVariant.ToLowerInvariant())</_UnoDeclaredRuntimeVariant>
			<_UnoDeclaredRuntimeVariant Condition=" '$(_UnoDeclaredRuntimeVariant)' == '' ">$(UnoRuntimeIdentifier.ToLowerInvariant())</_UnoDeclaredRuntimeVariant>
			<_UnoDeclaredRuntimeVariant Condition=" '$(_UnoDeclaredRuntimeVariant)' == 'skia' ">generic</_UnoDeclaredRuntimeVariant>
			<_UnoDeclaredRuntimeVariant Condition=" '$(_UnoDeclaredRuntimeVariant)' == 'webassembly' ">wasm</_UnoDeclaredRuntimeVariant>
		</PropertyGroup>
	</Target>

	<Target Name="_UnoComputeLibraryRuntimeVariant" DependsOnTargets="_UnoComputeDeclaredRuntimeVariant">
		<PropertyGroup>
			<!-- A head has no say in the folder: it always loads the shared one, and redirects WinRT from its platform. -->
			<_LibraryUnoRuntimeVariant>$(_UnoDeclaredRuntimeVariant)</_LibraryUnoRuntimeVariant>
			<_LibraryUnoRuntimeVariant Condition=" '$(UnoHasRuntimeHost)' == 'true' or '$(_LibraryUnoRuntimeVariant)' == '' ">generic</_LibraryUnoRuntimeVariant>

			<!-- A Reference library builds against the reference facades on purpose: nothing is replaced, required or validated. -->
			<_UnoRuntimeIsReferenceLibrary Condition=" '$(_LibraryUnoRuntimeVariant)' == 'reference' ">true</_UnoRuntimeIsReferenceLibrary>

			<!-- Only a no-host library passes its variant: a head derives it from TargetPlatformIdentifier. -->
			<_UnoTaskLibraryRuntimeVariant Condition=" '$(UnoHasRuntimeHost)' != 'true' ">$(_LibraryUnoRuntimeVariant)</_UnoTaskLibraryRuntimeVariant>

			<!-- Same gate as the UNOB0023 check below: a design-time build may see a partially restored package. -->
			<_UnoReportUnresolvedRuntimeAssets>true</_UnoReportUnresolvedRuntimeAssets>
			<_UnoReportUnresolvedRuntimeAssets Condition=" '$(DesignTimeBuild)' == 'true' or '$(UnoDisableUNOB0023Validation)' == 'true' ">false</_UnoReportUnresolvedRuntimeAssets>
		</PropertyGroup>
	</Target>

	<!--
	Swaps runtime-enabled packages' reference assemblies for their uno-runtime implementations. The variant
	keeps it running for a cross-runtime library, which sets it without referencing a runtime host.
	-->
	<Target Name="ReplaceUnoRuntime"
				Condition="'$(UnoHasRuntimeHost)' == 'true' or '$(UnoRuntimeVariant)' != '' or '$(UnoRuntimeIdentifier)' != ''"
				DependsOnTargets="_UnoComputeLibraryRuntimeVariant"
				BeforeTargets="_ComputeResolvedCopyLocalPublishAssets;ResolveLockFileCopyLocalFiles;ComputeFilesToPublish;GeneratePublishDependencyFile;ResolveLockFileReferences">

		<ItemGroup>
			<_UnoRuntimeEnabledPackage_EmptyPackageBasePath
				Include="@(UnoRuntimeEnabledPackage)"
				Condition="'%(UnoRuntimeEnabledPackage.PackageBasePath)'==''" />

			<!--
			uno-runtime/<variant>, with no target framework folder: what a cross-runtime library packs through
			UnoRuntimeProjectReference (see uno.winui.cross-runtime.targets).
			-->
			<RuntimeCopyLocalItemsMerged
							Include="%(UnoRuntimeEnabledPackage.PackageBasePath)/uno-runtime/$(_LibraryUnoRuntimeVariant)/*.dll"
							NuGetPackageId="%(UnoRuntimeEnabledPackage.Identity)" />
			<RuntimeCopyLocalItemsMerged
				Include="%(UnoRuntimeEnabledPackage.PackageBasePath)/../uno-runtime/$(_LibraryUnoRuntimeVariant)/*.dll"
				NuGetPackageId="%(UnoRuntimeEnabledPackage.Identity)" />

			<!-- Add metadata so the .deps.json file is generated properly (.NET 5+) -->
			<RuntimeCopyLocalItemsToUpdate
				Include="@(RuntimeCopyLocalItemsMerged)"
				AssetType="runtime"
				CopyLocal="true"
				DestinationSubPath="%(FileName)%(Extension)"
				CopyToPublishDirectory="true"
				PathInPackage="uno-runtime/$(_LibraryUnoRuntimeVariant)/%(FileName)%(Extension)" />

			<!-- Publish pdb files -->
			<ReferenceCopyLocalPaths Condition=" '$(Optimize)' != 'true' " Include="%(UnoRuntimeEnabledPackage.PackageBasePath)/../uno-runtime/$(_LibraryUnoRuntimeVariant)/*.pdb" />
			<ReferenceCopyLocalPaths Condition=" '$(Optimize)' != 'true' " Include="%(UnoRuntimeEnabledPackage.PackageBasePath)/uno-runtime/$(_LibraryUnoRuntimeVariant)/*.pdb" />
		</ItemGroup>

		<!-- uno-runtime/<tfm>/<variant>: what Uno's own runtime-enabled packages ship. -->
		<RuntimeAssetsSelectorTask_v0
			Condition="'$(_UnoRuntimeIsReferenceLibrary)' != 'true'"
			UnoRuntimeEnabledPackage="@(UnoRuntimeEnabledPackage)"
			TargetPlatformIdentifier="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))"
			LibraryRuntimeVariant="$(_UnoTaskLibraryRuntimeVariant)"
			ResolvedCompileFileDefinitionsInput="@(ResolvedCompileFileDefinitions)"
			RuntimeCopyLocalItemsInput="@(RuntimeCopyLocalItems)"
			TargetFrameworkVersion="$(TargetFrameworkVersion)"
			ReportUnresolvedAssets="$(_UnoReportUnresolvedRuntimeAssets)">
			<Output TaskParameter="RuntimeCopyLocalItemsToAdd" ItemName="RuntimeCopyLocalItemsMerged2" />
			<Output TaskParameter="RuntimeCopyLocalItemsToRemove" ItemName="_RuntimeCopyLocalItemsToRemove" />
			<Output TaskParameter="ResolvedCompileFileDefinitionsToAdd" ItemName="_ResolvedCompileFileDefinitionsToAdd" />
			<Output TaskParameter="ResolvedCompileFileDefinitionsToRemove" ItemName="_ResolvedCompileFileDefinitionsToRemove" />
			<!-- Publish PDB files-->
			<Output TaskParameter="DebugSymbols" ItemName="ReferenceCopyLocalPaths" />
		</RuntimeAssetsSelectorTask_v0>

		<ItemGroup>
			<!-- Add metadata so the .deps.json file is generated properly (.NET 5+) -->
			<RuntimeCopyLocalItemsToUpdate
				Include="@(RuntimeCopyLocalItemsMerged2)"
				AssetType="runtime"
				CopyLocal="true"
				DestinationSubPath="%(FileName)%(Extension)"
				CopyToPublishDirectory="true"
				PathInPackage="%(PathInPackage)" />

			<ResolvedCompileFileDefinitions Remove="@(_ResolvedCompileFileDefinitionsToRemove)" />
			<ResolvedCompileFileDefinitions Include="@(_ResolvedCompileFileDefinitionsToAdd)" />
			<RuntimeCopyLocalItems Remove="@(_RuntimeCopyLocalItemsToRemove)" />
			<RuntimeCopyLocalItems Include="@(RuntimeCopyLocalItemsToUpdate)"/>
		</ItemGroup>

		<Error
			Text="The package(s) [@(_UnoRuntimeEnabledPackage_EmptyPackageBasePath)] do not define the UnoRuntimeEnabledPackage.PackageBasePath metadata. Make sure to add one to specify the current location of the targets file."
			Condition="'@(_UnoRuntimeEnabledPackage_EmptyPackageBasePath)'!=''" />

		<!--
		A runtime-enabled package that contributed nothing means its runtime assets were not found, and the
		reference facade ships instead - a green build that throws NotImplemented at runtime. Both layouts
		above feed this check.
		-->
		<ItemGroup>
			<_UnoRuntimeResolvedPackageId Include="@(RuntimeCopyLocalItemsMerged->'%(NuGetPackageId)')" />
			<_UnoRuntimeResolvedPackageId Include="@(RuntimeCopyLocalItemsMerged2->'%(NuGetPackageId)')" />

			<_UnoRuntimeEnabledPackage_Unresolved Include="@(UnoRuntimeEnabledPackage)" />
			<_UnoRuntimeEnabledPackage_Unresolved Remove="@(_UnoRuntimeResolvedPackageId)" />
		</ItemGroup>

		<Error
			Code="UNOB0023"
			HelpLink="https://aka.platform.uno/UNOB0023"
			Text="The runtime-enabled package(s) [@(_UnoRuntimeEnabledPackage_Unresolved)] did not provide any runtime assembly for $(TargetFramework). The application would run against the reference assemblies and fail at runtime. A package built for Uno Platform 6.x ships uno-runtime/&lt;tfm&gt;/skia or webassembly instead of generic or wasm and must be updated to a version built for 7.0. Re-run with -v:n for the paths that were searched. See https://aka.platform.uno/UNOB0023"
			Condition="'@(_UnoRuntimeEnabledPackage_Unresolved)'!='' AND '$(_UnoRuntimeIsReferenceLibrary)'!='true' AND '$(UnoDisableUNOB0023Validation)'!='true' AND '$(DesignTimeBuild)'!='true'" />
	</Target>

	<!-- Skipped in design-time builds: it opens every copy-local assembly, and the IDE runs those constantly. -->
	<Target Name="_UnoValidateRuntimeAssets" BeforeTargets="CoreCompile" DependsOnTargets="_UnoComputeLibraryRuntimeVariant" Condition="'$(DesignTimeBuild)' != 'true'">
		<PropertyGroup>
			<!-- Normalized so a value other than 'true' cannot fail the task's boolean parameter conversion. -->
			<_UnoDisableUNOB0020Validation>false</_UnoDisableUNOB0020Validation>
			<_UnoDisableUNOB0020Validation Condition="'$(UnoDisableUNOB0020Validation)'=='true'">true</_UnoDisableUNOB0020Validation>
			<_UnoDisableUNOB0026Validation>false</_UnoDisableUNOB0026Validation>
			<_UnoDisableUNOB0026Validation Condition="'$(UnoDisableUNOB0026Validation)'=='true'">true</_UnoDisableUNOB0026Validation>
		</PropertyGroup>

		<RuntimeAssetsValidatorTask_v0
			Condition="'$(_UnoRuntimeIsReferenceLibrary)' != 'true'"
			TargetPlatformIdentifier="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))"
			NuGetPackageRoot="$(NuGetPackageRoot)"
			ResolvedCompileFileDefinitionsInput="@(ResolvedCompileFileDefinitions)"
			DisablePlatformAssetValidation="$(_UnoDisableUNOB0020Validation)"
			DisableUIRuntimeValidation="$(_UnoDisableUNOB0026Validation)"
			RuntimeCopyLocalItemsInput="@(RuntimeCopyLocalItems)">
		</RuntimeAssetsValidatorTask_v0>
	</Target>

	<!--
	Runs so that a project hooking Before/AfterTargets on the previous name still fires: MSBuild schedules
	such a hook only when its anchor target actually executes. Remove in the next major version.
	-->
	<Target Name="_UnoValidateReferencesUnoRuntimeIdentifier"
			BeforeTargets="CoreCompile"
			DependsOnTargets="_UnoValidateRuntimeAssets" />

	<Target Name="_UnoWarnObsoleteRuntimeIdentifiers" BeforeTargets="BeforeBuild" DependsOnTargets="_UnoComputeDeclaredRuntimeVariant">
		<PropertyGroup>
			<_UnoSuggestedRuntimeVariant>$(_UnoDeclaredRuntimeVariant)</_UnoSuggestedRuntimeVariant>
			<_UnoSuggestedRuntimeVariant Condition=" '$(_UnoDeclaredRuntimeVariant)' == 'generic' ">Generic</_UnoSuggestedRuntimeVariant>
			<_UnoSuggestedRuntimeVariant Condition=" '$(_UnoDeclaredRuntimeVariant)' == 'wasm' ">Wasm</_UnoSuggestedRuntimeVariant>
			<_UnoSuggestedRuntimeVariant Condition=" '$(_UnoDeclaredRuntimeVariant)' == 'reference' ">Reference</_UnoSuggestedRuntimeVariant>
		</PropertyGroup>

		<!-- Ungated: these two only ever selected assets for a head, so they are dead in every project shape. -->
		<Warning
			Code="UNOB0024"
			HelpLink="https://aka.platform.uno/UNOB0024"
			Text="UnoUIRuntimeIdentifier and UnoWinRTRuntimeIdentifier no longer have any effect and can be removed. Runtime assets are selected from the target framework. See https://aka.platform.uno/UNOB0024"
			Condition="('$(UnoUIRuntimeIdentifier)'!='' OR '$(UnoWinRTRuntimeIdentifier)'!='') AND '$(UnoDisableUNOB0024Validation)'!='true'" />

		<!-- Gated on UnoHasRuntimeHost rather than IsUnoHead, which only the Uno.Sdk sets: a hand-rolled head is exactly the shape likely to still carry it. -->
		<Warning
			Code="UNOB0024"
			HelpLink="https://aka.platform.uno/UNOB0024"
			Text="UnoRuntimeIdentifier no longer selects runtime assets for an application head and can be removed. Runtime assets are selected from the target framework. See https://aka.platform.uno/UNOB0024"
			Condition="'$(UnoRuntimeIdentifier)'!='' AND '$(UnoHasRuntimeHost)'=='true' AND '$(UnoDisableUNOB0024Validation)'!='true'" />

		<Warning
			Code="UNOB0024"
			HelpLink="https://aka.platform.uno/UNOB0024"
			Text="UnoRuntimeIdentifier is deprecated for cross-runtime libraries. Set UnoRuntimeVariant to '$(_UnoSuggestedRuntimeVariant)' instead. See https://aka.platform.uno/UNOB0024"
			Condition="'$(UnoRuntimeIdentifier)'!='' AND '$(UnoRuntimeVariant)'=='' AND '$(UnoHasRuntimeHost)'!='true' AND '$(UnoDisableUNOB0024Validation)'!='true'" />
	</Target>

	<!--
	The one failure the runtime-host gate makes possible, and the only one ReplaceUnoRuntime cannot report:
	packages that need replacement, on a head that never picked up a runtime host. A warning in general, since
	an executable test project can legitimately run on the reference assemblies; an error when a pre-7.0
	runtime host is present, recognisable by the UnoUIRuntimeIdentifier it sets instead of UnoHasRuntimeHost.
	-->
	<Target Name="_UnoWarnMissingRuntimeHost" BeforeTargets="BeforeBuild">
		<PropertyGroup>
			<_UnoMissingRuntimeHost>false</_UnoMissingRuntimeHost>
			<_UnoMissingRuntimeHost Condition="'@(UnoRuntimeEnabledPackage)'!='' AND '$(UnoHasRuntimeHost)'!='true' AND '$(UnoRuntimeVariant)'=='' AND '$(UnoRuntimeIdentifier)'=='' AND ('$(OutputType)'=='Exe' OR '$(OutputType)'=='WinExe') AND '$(UnoDisableUNOB0025Validation)'!='true'">true</_UnoMissingRuntimeHost>
		</PropertyGroup>

		<Error
			Code="UNOB0025"
			HelpLink="https://aka.platform.uno/UNOB0025"
			Text="This project references runtime-enabled package(s) [@(UnoRuntimeEnabledPackage)] and a pre-7.0 Uno.WinUI.Runtime.Skia.* package, which does not declare itself as the runtime host, so the reference assemblies would be deployed and fail at runtime. Replace it with the matching renamed Uno.WinUI.Runtime.* package (for example Uno.WinUI.Runtime.Skia.Headless becomes Uno.WinUI.Runtime.Headless) at the Uno.WinUI version, as the old ids receive no 7.0 builds. See https://aka.platform.uno/UNOB0025"
			Condition="'$(_UnoMissingRuntimeHost)'=='true' AND '$(UnoUIRuntimeIdentifier)'!=''" />

		<Warning
			Code="UNOB0025"
			HelpLink="https://aka.platform.uno/UNOB0025"
			Text="This project references runtime-enabled package(s) [@(UnoRuntimeEnabledPackage)] but no Uno Platform runtime host (UnoHasRuntimeHost is not set), so the reference assemblies will be deployed and will fail at runtime. Check that a Uno.WinUI.Runtime.* package is referenced at the Uno.WinUI version. See https://aka.platform.uno/UNOB0025"
			Condition="'$(_UnoMissingRuntimeHost)'=='true' AND '$(UnoUIRuntimeIdentifier)'==''" />
	</Target>


	<Target Name="RemovePdbFilesFromOutput"
			AfterTargets="ReplaceUnoRuntime;ResolveLockFileCopyLocalFiles"
			Condition="'$(DebugType)' == 'none' or '$(DebugSymbols)' == 'false'">
		<ItemGroup>
			<_ReferenceCopyLocalPathsPdbToRemove
				Include="@(ReferenceCopyLocalPaths)"
				Condition="'%(Extension)' == '.pdb'" />
			<_RuntimeTargetsCopyLocalItemsPdbToRemove
				Include="@(RuntimeTargetsCopyLocalItems)"
				Condition="'%(Extension)' == '.pdb'" />

			<ReferenceCopyLocalPaths Remove="@(_ReferenceCopyLocalPathsPdbToRemove)" />
			<RuntimeTargetsCopyLocalItems Remove="@(_RuntimeTargetsCopyLocalItemsPdbToRemove)" />
		</ItemGroup>
	</Target>
</Project>
