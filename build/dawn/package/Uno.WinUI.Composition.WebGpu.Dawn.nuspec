<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata>
		<id>Uno.WinUI.Composition.WebGpu.Dawn</id>
		<version>$version$</version>
		<title>Dawn for the Uno Platform WebGPU backend</title>
		<authors>Uno Platform</authors>
		<license type="file">LICENSE.txt</license>
		<icon>uno.png</icon>
		<readme>README.md</readme>
		<projectUrl>https://github.com/unoplatform/uno</projectUrl>
		<repository type="git" url="https://github.com/unoplatform/uno" />
		<description>Google's Dawn WebGPU implementation, built from Dawn release $dawnTag$ for every native platform the Uno Platform WebGPU backend runs on.</description>
		<tags>uno webgpu dawn native</tags>
	</metadata>
	<files>
		<file src="$root$\src\Common\uno.png" target="/" />
		<file src="$payload$\LICENSE.txt" target="/" />
		<file src="$payload$\README.md" target="/" />

		<!-- Loaded by name ("webgpu") from runtimes/<rid>/native, so default [DllImport] resolution finds it. One folder per
		     RID, each holding just its library; pack.py checks they are all there. -->
		<file src="$payload$\win-x64\*" target="runtimes\win-x64\native" />
		<file src="$payload$\win-arm64\*" target="runtimes\win-arm64\native" />
		<file src="$payload$\linux-x64\*" target="runtimes\linux-x64\native" />
		<file src="$payload$\linux-arm64\*" target="runtimes\linux-arm64\native" />
		<file src="$payload$\osx-x64\*" target="runtimes\osx-x64\native" />
		<file src="$payload$\osx-arm64\*" target="runtimes\osx-arm64\native" />
		<file src="$payload$\android-arm64\*" target="runtimes\android-arm64\native" />
		<file src="$payload$\android-arm\*" target="runtimes\android-arm\native" />
		<file src="$payload$\android-x64\*" target="runtimes\android-x64\native" />
		<file src="$payload$\android-x86\*" target="runtimes\android-x86\native" />

		<!-- iOS links the static library into the app image, so it cannot come from runtimes/. -->
		<file src="Uno.WinUI.Composition.WebGpu.Dawn.targets" target="buildTransitive\Uno.WinUI.Composition.WebGpu.Dawn.targets" />
		<file src="$payload$\dawn-ios.symbols" target="buildTransitive\dawn-ios.symbols" />
		<file src="$payload$\ios-arm64\*" target="buildTransitive\native\ios-arm64" />
		<file src="$payload$\iossimulator-arm64\*" target="buildTransitive\native\iossimulator-arm64" />
		<file src="$payload$\iossimulator-x64\*" target="buildTransitive\native\iossimulator-x64" />
	</files>
</package>
